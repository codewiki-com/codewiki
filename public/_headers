# Cloudflare Pages response headers. Rules are matched per path and the most specific match
# wins, so the `/sandbox.html` block below fully replaces the `/*` Content-Security-Policy for
# that one document rather than adding to it — every directive it still needs is repeated there.
# Lines starting with `#` are comments; any static host with an equivalent header mechanism can
# serve the same values (see docs/dev/deploy.md).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# The JavaScript runner's execution frame compiles the visitor's snippet with `new Function`,
# which CSP counts as eval. It is confined to this document, which the article embeds with
# sandbox="allow-scripts" and no allow-same-origin: it runs on an opaque origin with no access to
# the site's DOM, storage or cookies, so `'unsafe-eval'` here cannot reach anything but itself.
# `frame-ancestors 'self'` replaces the global `'none'` because the frame is embedded by design.
/sandbox.html
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800
