---
/**
 * The page shell every route renders through. It owns <html>, the head, the
 * header and the footer; pages supply only the <main> content and the head model
 * built by `buildHead`.
 *
 * Ordering inside <head> matters: ThemeScript runs before the stylesheet so the
 * palette is decided before first paint, and the font preload starts the only
 * blocking download early.
 */
import '@/styles/global.css';

import ThemeScript from '@/components/ThemeScript.astro';
import Seo from '@/components/Seo.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { t } from '@/i18n';
import { SITE } from '@/data/site';
import type { HeadModel } from '@/lib/seo';
import type { Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  head: HeadModel;
  /** Content column: 1200px for standard pages, 1320px for topic pages. */
  width?: 'home' | 'topic';
  /** Site-absolute path of the current page — pass `Astro.url.pathname`. */
  currentPath: string;
}

const { locale, head, width = 'home', currentPath } = Astro.props;
const lang = locale === 'zh' ? 'zh-Hans' : 'en';
---

<html lang={lang}>
  <head>
    <ThemeScript />
    <Seo head={head} />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  </head>
  <body data-width={width}>
    <a class="skip-link" href="#main">{t(locale, 'a11y.skip')}</a>
    <Nav locale={locale} currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} currentPath={currentPath} />
  </body>
</html>

<style>
  /* Container width for the whole page; nav, footer and page sections read it. */
  body {
    --w: var(--w-home);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  body[data-width='topic'] {
    --w: var(--w-topic);
  }

  main {
    flex: 1;
  }
</style>
