---
/**
 * The page shell every route renders through. It owns <html>, the head, the
 * header and the footer; pages supply only the <main> content and the head model
 * built by `buildHead`.
 *
 * Ordering inside <head> matters: ThemeScript runs before the stylesheet so the
 * palette is decided before first paint, and the font preload starts the only
 * blocking download early.
 */
import '@/styles/global.css';

import ThemeScript from '@/components/ThemeScript.astro';
import Seo from '@/components/Seo.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { t } from '@/i18n';
import { SITE } from '@/data/site';
import type { HeadModel } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  head: HeadModel;
  /** Content column: 1200px for standard pages, 1320px for topic pages. */
  width?: 'home' | 'topic';
  /** Site-absolute path of the current page — pass `Astro.url.pathname`. */
  currentPath: string;
  /**
   * How Pagefind treats this page's <main>: an object marks it as an indexable record and
   * carries the record's filters and metadata, `ignore` keeps it out of the index entirely.
   * Pages that say nothing are crawled under Pagefind's own default.
   */
  pagefind?: 'ignore' | PagefindBody;
}

/** An indexable record: `filter` becomes Pagefind's facets, `meta` the fields a result shows. */
export interface PagefindBody {
  filter?: Record<string, string>;
  meta?: Record<string, string>;
}

const { locale, head, width = 'home', currentPath, pagefind } = Astro.props;
const lang = locale === 'zh' ? 'zh-Hans' : 'en';

/** Pagefind reads both attributes as a comma-separated `key:value` list. */
const pairs = (values: Record<string, string> | undefined): string | undefined =>
  values && Object.keys(values).length > 0
    ? Object.entries(values)
        .map(([key, value]) => `${key}:${value}`)
        .join(', ')
    : undefined;

const body = pagefind && pagefind !== 'ignore' ? pagefind : undefined;

/**
 * Strings the markdown pipeline cannot localise on its own. `remark-callouts` and `rehype-codebox`
 * run once for every locale, so they emit the English label plus a `data-i18n` key; the inline
 * script below swaps the text and the copy button reuses the map for its "Copied" state.
 */
const uiStrings = {
  'callout.pitfall': t(locale, 'callout.pitfall'),
  'callout.note': t(locale, 'callout.note'),
  'callout.tip': t(locale, 'callout.tip'),
  'callout.warning': t(locale, 'callout.warning'),
  'callout.ai': t(locale, 'callout.ai'),
  'checkpoint.soon': t(locale, 'checkpoint.soon'),
  'code.copy': t(locale, 'code.copy'),
  'code.copied': t(locale, 'code.copied'),
  'code.copyFailed': t(locale, 'code.copyFailed'),
  'code.run': t(locale, 'code.run'),
  'code.running': t(locale, 'code.running'),
  'depth.switchDeep': t(locale, 'depth.switchDeep'),
};
---

<html lang={lang}>
  <head>
    <ThemeScript />
    <script is:inline>
      // Task 17: the stored font size, applied before paint for the same reason the theme is —
      // resizing the prose after first paint is a visible jump. Keep the key in step with
      // `KEYS.prefs`; the settings island owns every write to it.
      (function () {
        try {
          var f = JSON.parse(localStorage.getItem('cw:v1:prefs') || '{}').fontSize;
          if (f === 's' || f === 'm' || f === 'l') document.documentElement.setAttribute('data-font', f);
        } catch {}
      })();
    </script>
    <Seo head={head} />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={localizePath('/rss.xml', locale)}
    />
  </head>
  <body data-width={width}>
    <a class="skip-link" href="#main">{t(locale, 'a11y.skip')}</a>
    <Nav locale={locale} currentPath={currentPath} />
    <main
      id="main"
      data-pagefind-body={body ? '' : undefined}
      data-pagefind-filter={pairs(body?.filter)}
      data-pagefind-meta={pairs(body?.meta)}
      data-pagefind-ignore={pagefind === 'ignore' ? '' : undefined}
    >
      <slot />
    </main>
    <Footer locale={locale} currentPath={currentPath} />
    <script is:inline define:vars={{ uiStrings }}>
      // Published for every later island; the code runner reads `code.running` from it too.
      window.__cw_i18n = uiStrings;

      for (const node of document.querySelectorAll('[data-i18n]')) {
        const value = uiStrings[node.dataset.i18n];
        if (value) node.textContent = value;
      }

      // One delegated listener for every Copy button the markdown pipeline emitted.
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest('[data-copy]');
        const pre = button && button.closest('.codebox')?.querySelector('pre');
        if (!button || !pre) return;

        // A denied permission or an insecure origin rejects the write; say so rather than
        // leaving the button looking as though it worked.
        const restore = () =>
          setTimeout(() => {
            button.textContent = uiStrings['code.copy'];
          }, 1500);

        navigator.clipboard
          .writeText(pre.textContent ?? '')
          .then(() => {
            button.textContent = uiStrings['code.copied'];
            restore();
          })
          .catch(() => {
            button.textContent = uiStrings['code.copyFailed'];
            restore();
          });
      });
    </script>
  </body>
</html>

<style>
  /* Container width and gutter for the whole page; nav, footer and page
     sections read both, so every left edge lines up at every viewport. */
  body {
    --w: var(--w-home);
    --gutter: 24px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  body[data-width='topic'] {
    --w: var(--w-topic);
  }

  /* Matches the breakpoint where the nav switches to its compact layout. */
  @media (max-width: 1023px) {
    body {
      --gutter: 16px;
    }
  }

  main {
    flex: 1;
  }
</style>
