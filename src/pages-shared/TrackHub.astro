---
/**
 * The track hub, shared by `/{track}/` and `/zh/{track}/`. Section for section it is
 * docs/design/mockups/TrackHub.dc.html: the header band with the breadcrumb, glyph, chips and
 * quick links, the recommended-path card, the filter row, the sections as card grids, and the
 * right rail with progress, an Ask-AI prompt and the track's other pages.
 *
 * Everything visible is either a `t()` string or real content. Reading progress is a fact about
 * the visitor's browser, so the server renders every card unread and the `TrackProgress` island
 * patches the DOM afterwards; the page is complete without it.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import OfflineSave from '@/components/OfflineSave.astro';
import ProgressRing from '@/components/ProgressRing.astro';
import Seg from '@/components/Seg.astro';
import Tag from '@/components/Tag.astro';
import TopicCard from '@/components/TopicCard.astro';
import TrackProgress from '@/islands/TrackProgress';
import { formatCount, t } from '@/i18n';
import { tOffline } from '@/i18n/offline';
import type { Track } from '@/data/tracks';
import { P2B_NAV, P2_RULES, P3_NAV, SITE } from '@/data/site';
import {
  cheatsheetMeta,
  getPair,
  isPublic,
  listCheatsheets,
  listTopics,
  topicMeta,
  type Topic,
} from '@/lib/content';
import { mostFrequent } from '@/lib/arrays';
import { generatedRulePacks } from '@/lib/generated-packs';
import { breadcrumbLd, buildHead, courseLd } from '@/lib/seo';
import { localizePath, topicUrl, trackUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  track: Track;
}

const { locale, track } = Astro.props;
const other: Locale = locale === 'en' ? 'zh' : 'en';
const trackName = track.name[locale];
const currentPath = trackUrl(track.slug, locale);

/* ---- topics ---------------------------------------------------------------------------- */

const topics = await listTopics(locale, { track: track.slug });

const topicCount = (count: number) => formatCount(locale, count, 'unit.topic', 'unit.topics');
const topicId = (topic: Topic) => {
  const { track: trackSlug, slug } = topicMeta(topic);
  return `${trackSlug}/${slug}`;
};

/** Sections in registry order, numbered `01`, `02`, … whether or not they have topics yet. */
const sections = await Promise.all(
  track.sections.map(async (section, index) => ({
    slug: section.slug,
    name: section.name[locale],
    index: String(index + 1).padStart(2, '0'),
    topics: await listTopics(locale, { track: track.slug, section: section.slug }),
  })),
);

const written = sections.filter((section) => section.topics.length > 0);

/* ---- chips ----------------------------------------------------------------------------- */

/** The version most of the track's topics were checked against; no topics, no chip. */
const version = mostFrequent(topics.map((topic) => topic.data.verified.version));

const DIFFICULTY_ORDER = ['beginner', 'intermediate', 'advanced'] as const;
const present = DIFFICULTY_ORDER.filter((level) => topics.some((topic) => topic.data.difficulty === level));
const range =
  present.length === 0
    ? undefined
    : present.length === 1
      ? t(locale, `difficulty.${present[0]!}`)
      : t(locale, 'track.range', {
          from: t(locale, `difficulty.${present[0]!}`),
          to: t(locale, `difficulty.${present[present.length - 1]!}`),
        });

/** True when every topic written in this locale also exists, published, in the other one. */
const pairs = await Promise.all(
  topics.map(async (topic) => {
    const { track: trackSlug, slug } = topicMeta(topic);
    const pair = await getPair(trackSlug, slug);
    const twin = pair[other];
    return Boolean(twin && isPublic(twin));
  }),
);

/* ---- offline --------------------------------------------------------------------------- */

/**
 * What "Save this track offline" downloads: this hub and every topic in it, in both languages,
 * because a bilingual reader who saved a track for a flight expects the language toggle to keep
 * working. A topic with no published twin contributes only the page that exists.
 */
const offlineUrls = [
  trackUrl(track.slug, locale),
  trackUrl(track.slug, other),
  ...topics.flatMap((topic, index) => {
    const { track: trackSlug, slug } = topicMeta(topic);
    const own = topicUrl(trackSlug, slug, locale);
    return pairs[index] ? [own, topicUrl(trackSlug, slug, other)] : [own];
  }),
];

/* ---- related collections --------------------------------------------------------------- */

const [paths, interviewBanks, cheatsheets] = await Promise.all([
  getCollection('paths'),
  getCollection('interview'),
  listCheatsheets(locale),
]);
const cheatsheet = cheatsheets.find((sheet) => sheet.data.track === track.slug);
const hasCheatsheet = Boolean(cheatsheet);
const cheatsheetSlug = cheatsheet ? cheatsheetMeta(cheatsheet).slug : track.slug;
const hasInterview = interviewBanks.some(
  (bank: CollectionEntry<'interview'>) => bank.data.track === track.slug,
);
const ruleCount = (await generatedRulePacks()).get(track.slug)?.length ?? 0;
const hasRuleCard = P2_RULES && ruleCount >= 10;

/* ---- quick links ----------------------------------------------------------------------- */

/** Icon names are the subset of `Icon.astro`'s set that the mockup uses on these rows. */
interface Shortcut {
  label: string;
  href: string;
  icon: 'doc' | 'info' | 'menu' | 'play';
  soon: boolean;
}

const shortcuts: Shortcut[] = [
  {
    label: t(locale, 'track.cheatsheet'),
    href: localizePath(`/cheatsheets/${cheatsheetSlug}/`, locale),
    icon: 'doc',
    soon: !hasCheatsheet,
  },
  {
    label: t(locale, 'track.interview'),
    href: localizePath(`/practice/interview/${track.slug}/`, locale),
    icon: 'info',
    soon: !hasInterview,
  },
  {
    label: t(locale, 'track.compare'),
    href: localizePath('/compare/', locale),
    icon: 'menu',
    soon: !P3_NAV,
  },
  {
    label: t(locale, 'track.playground'),
    href: `${localizePath('/playground/', locale)}?lang=${track.slug}`,
    icon: 'play',
    soon: !P2B_NAV,
  },
];

/** The right rail's "also in this track" list; `soon` rows are text, not links. */
const alsoLinks = [
  {
    label: t(locale, 'track.alsoCheatsheet', { track: trackName }),
    href: shortcuts[0]!.href,
    soon: !hasCheatsheet,
  },
  {
    label: t(locale, 'track.alsoCompare', { track: trackName }),
    href: shortcuts[2]!.href,
    soon: !P3_NAV,
  },
  {
    label: t(locale, 'track.alsoInterview', { track: trackName }),
    href: shortcuts[1]!.href,
    soon: !hasInterview,
  },
  {
    label: t(locale, 'track.alsoGlossary', { track: trackName }),
    href: localizePath('/glossary/', locale),
    soon: false,
  },
];

/* ---- recommended path ------------------------------------------------------------------ */

const path = paths.find((entry: CollectionEntry<'paths'>) => entry.data.tracks.includes(track.slug));
const pathMapUrl = localizePath(path ? `/paths/${path.id}/` : '/paths/', locale);
const pathMilestones: { id: string; topics: string[]; checkpoint: string }[] =
  path?.data.milestones.map((milestone: { id: string; topics: string[]; checkpoint: string }) => milestone) ??
  [];
const milestones = pathMilestones.map((milestone) => milestone.topics);
const pathTopics = milestones.flat();

/** Where "Continue" goes: the first topic of the path that is actually written in this locale. */
const byId = new Map(topics.map((topic) => [topicId(topic), topic]));
const continueTopic = pathTopics.map((id: string) => byId.get(id)).find(Boolean) ?? topics[0];
const continueMeta = continueTopic ? topicMeta(continueTopic) : undefined;

/* ---- filters --------------------------------------------------------------------------- */

const difficultyFilters = [
  { label: t(locale, 'track.filterAll'), value: 'all', on: true },
  ...DIFFICULTY_ORDER.map((level) => ({ label: t(locale, `difficulty.${level}`), value: level })),
];

const readFilters = [
  { label: t(locale, 'track.filterAll'), value: 'all', on: true },
  { label: t(locale, 'track.filterUnread'), value: 'unread' },
  { label: t(locale, 'track.filterRead'), value: 'read' },
];

/* ---- head ------------------------------------------------------------------------------ */

const head = buildHead({
  locale,
  path: currentPath,
  title: trackName,
  description: track.description[locale],
  kind: 'track',
  jsonLd: [
    breadcrumbLd([
      { name: t(locale, 'nav.tracks'), url: `${SITE.url}${localizePath('/tracks/', locale)}` },
      { name: trackName, url: `${SITE.url}${currentPath}` },
    ]),
    // A hub is a set of lessons on one subject, which is what `Course` describes; the topics
    // themselves stay `TechArticle`. One per locale, since the two hubs are separate pages.
    courseLd({
      name: trackName,
      description: track.description[locale],
      url: `${SITE.url}${currentPath}`,
      inLanguage: locale === 'zh' ? 'zh-Hans' : 'en',
    }),
  ],
});
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <!-- HEADER BAND -->
  <div class="band">
    <div class="wrap header">
      <div class="intro">
        <div class="crumbs">
          <Breadcrumb
            label={t(locale, 'nav.tracks')}
            items={[
              { label: t(locale, 'nav.tracks'), href: localizePath('/tracks/', locale) },
              { label: trackName, current: true },
            ]}
          />
          {/* docs/design/flagship-tracks.md: the six deepest hubs say so on the eyebrow line. */}
          {track.flagship && <span class="lbl flagship">{t(locale, 'tracks.flagship')}</span>}
        </div>

        <div class="title">
          <span class="mono glyph">{track.glyph}</span>
          <h1>{trackName}</h1>
        </div>

        <p class="desc">{track.description[locale]}</p>

        <div class="chips">
          <Tag>{topicCount(topics.length)}</Tag>
          <Tag>
            {
              t(locale, 'track.sections', {
                count: formatCount(locale, track.sections.length, 'unit.section', 'unit.sections'),
              })
            }
          </Tag>
          {version && <Tag>{version}</Tag>}
          {range && <Tag>{range}</Tag>}
        </div>

        <div class="shortcuts">
          {
            shortcuts
              .filter((shortcut) => !shortcut.soon)
              .map((shortcut) => (
                <a class="quick" href={shortcut.href}>
                  <Icon name={shortcut.icon} size={15} />
                  <span class="quick-label">{shortcut.label}</span>
                </a>
              ))
          }
        </div>
      </div>

      {
        path && (
          <div class="panel path">
            <span class="lbl label-acc">{t(locale, 'track.path')}</span>
            <span class="path-title">{path.data.title[locale]}</span>
            <span class="path-meta">
              {t(locale, 'track.pathMeta', {
                topics: formatCount(locale, pathTopics.length, 'unit.topic', 'unit.topics'),
                checkpoints: formatCount(locale, milestones.length, 'unit.checkpoint', 'unit.checkpoints'),
                hours: formatCount(locale, path.data.hours, 'unit.hour', 'unit.hours'),
              })}
            </span>
            <div
              class="bar"
              data-path-bar
              role="progressbar"
              aria-label={t(locale, 'track.path')}
              aria-valuenow={0}
              aria-valuemin={0}
              aria-valuemax={pathTopics.length}
            >
              <div />
            </div>
            <div class="path-counts">
              <span class="lbl" data-path-milestone>
                {t(locale, 'track.milestone', { done: 1, total: milestones.length })}
              </span>
              <span class="lbl" data-path-done>
                {t(locale, 'track.done', { done: 0, total: pathTopics.length })}
              </span>
            </div>
            {continueMeta && continueTopic && (
              <Button href={topicUrl(continueMeta.track, continueMeta.slug, locale)}>
                {t(locale, 'track.continueTopic', { title: continueTopic.data.title })} →
              </Button>
            )}
            <a class="path-map" href={pathMapUrl}>
              {t(locale, 'track.map')}
            </a>
          </div>
        )
      }
    </div>
  </div>

  <!-- BODY -->
  <div class="wrap body">
    <div class="col">
      <!-- FILTER ROW: only where there is something to filter -->
      {
        written.length > 0 && (
          <div class="filters" data-filters>
            <Seg items={difficultyFilters} label={t(locale, 'topic.level')} data-filter-group="difficulty" />
            <div class="filter-right">
              <span class="lbl">{t(locale, 'track.show')}</span>
              <Seg items={readFilters} label={t(locale, 'track.show')} data-filter-group="read" />
            </div>
          </div>
        )
      }

      <!-- SECTIONS -->
      {
        written.map((section) => (
          <section class="group" id={section.slug} data-section={section.slug}>
            <div class="sec">
              <h2>
                {section.index} · {section.name}
              </h2>
              <span class="lbl" data-section-done={section.slug}>
                {topicCount(section.topics.length)}
              </span>
            </div>
            <div class="cards">
              {section.topics.map((topic) => (
                <TopicCard topic={topic} locale={locale} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <!-- RIGHT RAIL -->
    <aside class="rail">
      <div class="panel rail-panel">
        <span class="lbl">{t(locale, 'track.progress')}</span>
        <div class="ring-row">
          <ProgressRing total={topics.length} label={t(locale, 'track.progress')} />
          <div class="ring-text">
            <span class="ring-count" data-progress-count>0 / {topics.length}</span>
            <span class="lbl">{t(locale, 'track.topicsRead')}</span>
          </div>
        </div>
        <div class="rail-actions">
          <Button variant="ghost" href={localizePath('/settings/', locale)}>
            {t(locale, 'track.export')}
          </Button>
          <Button variant="ghost" href={localizePath('/settings/', locale)}>
            {t(locale, 'track.import')}
          </Button>
        </div>
        <OfflineSave
          id="track-offline"
          scope="track"
          storeKey={track.slug}
          urls={offlineUrls}
          labels={{
            save: tOffline(locale, 'saveTrack'),
            remove: tOffline(locale, 'remove'),
            saving: tOffline(locale, 'saving'),
            saved: tOffline(locale, 'savedPages'),
            failed: tOffline(locale, 'failed'),
          }}
        />
      </div>

      <div class="panel rail-panel ai">
        <span class="lbl label-acc2">{t(locale, 'track.askAi')}</span>
        <span class="ai-prompt">“{t(locale, 'track.aiPrompt', { track: trackName })}”</span>
        <span class="lbl">{t(locale, 'home.promptMeta')}</span>
      </div>

      {
        hasRuleCard && (
          <div class="panel rail-panel agent-rules" data-rules-card>
            <a class="lbl label-acc2" href={localizePath(`/rules/${track.slug}/`, locale)}>
              {t(locale, 'rules.pack', { track: trackName })}
            </a>
            <span class="agent-rules-copy">
              {t(locale, 'rules.count', { n: ruleCount, track: trackName })}
            </span>
            <div class="agent-rules-actions">
              <a class="btn btn-g" href={`/rules/${track.slug}/CLAUDE.md`} download>
                CLAUDE.md
              </a>
              <a class="btn btn-g" href={`/rules/${track.slug}/AGENTS.md`} download>
                AGENTS.md
              </a>
              <a class="btn btn-g" href={`/rules/${track.slug}/codewiki-${track.slug}.mdc`} download>
                Cursor
              </a>
            </div>
          </div>
        )
      }

      <div class="also">
        <span class="lbl">{t(locale, 'track.also')}</span>
        {alsoLinks.filter((link) => !link.soon).map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </aside>
  </div>

  <!-- Reading progress: local data only, so it renders nothing on the server. -->
  <TrackProgress
    client:idle
    sections={written.map((section) => ({
      slug: section.slug,
      topics: section.topics.map(topicId),
    }))}
    milestones={pathMilestones}
    labels={{
      readPct: t(locale, 'track.readPct', { pct: '{pct}' }),
      done: t(locale, 'track.done', { done: '{done}', total: '{total}' }),
      milestone: t(locale, 'track.milestone', { done: '{done}', total: '{total}' }),
    }}
  />
</Base>

<script>
  /* The filter row. Without JavaScript the segments are inert labels and every card is visible,
     which is the correct static page; with it they behave as two radio groups over the cards'
     `data-difficulty` and `data-read` attributes. `data-read` is refreshed by the TrackProgress
     island, which announces itself with `cw:progress`. */
  const root = document.querySelector<HTMLElement>('[data-filters]');

  if (root) {
    const state: Record<string, string> = { difficulty: 'all', read: 'all' };

    const apply = () => {
      for (const card of document.querySelectorAll<HTMLElement>('.topic[data-topic-id]')) {
        const read = card.dataset.read ?? 'unread';
        const matchesLevel = state.difficulty === 'all' || card.dataset.difficulty === state.difficulty;
        // "Read" means started, not finished: a partially read card counts as read.
        const matchesRead =
          state.read === 'all' || (state.read === 'unread' ? read === 'unread' : read !== 'unread');
        card.hidden = !(matchesLevel && matchesRead);
      }

      // A section whose cards are all filtered out goes with them, so no empty grid is left.
      for (const section of document.querySelectorAll<HTMLElement>('[data-section]')) {
        const cards = [...section.querySelectorAll<HTMLElement>('.topic[data-topic-id]')];
        section.hidden = cards.length > 0 && cards.every((card) => card.hidden);
      }
    };

    for (const group of root.querySelectorAll<HTMLElement>('[data-filter-group]')) {
      const name = group.dataset.filterGroup;
      if (!name) continue;
      group.setAttribute('role', 'radiogroup');
      const items = [...group.querySelectorAll<HTMLElement>('[data-value]')];

      /* The WAI-ARIA radio-group pattern: exactly one segment is tabbable, and the arrow keys
         move focus to the next segment and check it as they go. Home and End jump to the ends,
         and the list wraps, so every segment is reachable from the keyboard. */
      const select = (index: number, moveFocus: boolean) => {
        const target = items[((index % items.length) + items.length) % items.length];
        if (!target) return;
        for (const item of items) {
          const on = item === target;
          item.classList.toggle('on', on);
          item.setAttribute('aria-checked', String(on));
          item.setAttribute('tabindex', on ? '0' : '-1');
        }
        if (moveFocus) target.focus();
        state[name] = target.dataset.value ?? 'all';
        apply();
      };

      items.forEach((item, index) => {
        item.removeAttribute('aria-current');
        item.setAttribute('role', 'radio');
        item.setAttribute('aria-checked', String(item.classList.contains('on')));
        item.setAttribute('tabindex', item.classList.contains('on') ? '0' : '-1');
        item.addEventListener('click', () => select(index, false));
        item.addEventListener('keydown', (event) => {
          switch (event.key) {
            case 'Enter':
            case ' ':
              select(index, true);
              break;
            case 'ArrowRight':
            case 'ArrowDown':
              select(index + 1, true);
              break;
            case 'ArrowLeft':
            case 'ArrowUp':
              select(index - 1, true);
              break;
            case 'Home':
              select(0, true);
              break;
            case 'End':
              select(items.length - 1, true);
              break;
            default:
              return;
          }
          event.preventDefault();
        });
      });
    }

    document.addEventListener('cw:progress', apply);
    apply();
  }
</script>

<style>
  /* ---- header band ---- */

  .band {
    background: var(--sur);
    border-bottom: 1px solid var(--line);
  }

  .header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 48px;
    padding-top: 44px;
    padding-bottom: 40px;
    align-items: start;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .crumbs {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .flagship {
    color: var(--acc);
    text-transform: uppercase;
  }

  .title {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .glyph {
    font-size: 22px;
    font-weight: 500;
    color: var(--acc);
    background: var(--acc-soft);
    border-radius: var(--r-8);
    padding: 8px 12px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .desc {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 680px;
  }

  .chips {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* Four tool cards where they fit, fewer where they do not. `auto-fit` rather than a fixed
     four-up grid: the labels do not wrap, so a column narrower than its label is what would
     break the row of cards, not the text. The floor is measured, not guessed — the longest
     row ("Interview bank" plus the `soon` tag) needs 188px. */
  .shortcuts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 8px;
    margin-top: 6px;
  }

  /* One line each, so every card in the row is the same height. The row is a little tighter
     than the mockup's `.quick` because these four carry a `soon` tag as well as a label: at the
     mockup's spacing the longest of them ("Interview bank") needs 204px, and tightening brings
     it to 188px, which is what sets the grid's 190px floor above. */
  .shortcuts .quick {
    min-width: 0;
    gap: 8px;
    padding-inline: 10px;
  }

  /* The label never wraps; if a column is ever narrower than the longest one, it ends in an
     ellipsis rather than pushing the tag out of the card. */
  .quick-label {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- recommended path ---- */

  .path {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 20px;
    box-shadow: var(--glow);
  }

  .label-acc {
    color: var(--acc);
  }

  .path-title {
    font-size: 19px;
    font-weight: 600;
  }

  .path-meta {
    font-size: 13.5px;
    color: var(--ink2);
    line-height: 1.5;
  }

  .bar {
    height: 4px;
    border-radius: 2px;
    background: var(--acc-soft);
    overflow: hidden;
  }

  .bar div {
    width: 0;
    height: 100%;
    background: var(--acc);
  }

  .path-counts {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .path-map {
    font-size: 13px;
    text-align: center;
  }

  /* ---- body ---- */

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 72px;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-width: 0;
  }

  .filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* The mockup capitalises the filter labels; the dictionary keeps them lower case because the
     same strings are the cards' difficulty tags. */
  .filters :global(.seg span) {
    text-transform: capitalize;
  }

  .filter-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .collapsed {
