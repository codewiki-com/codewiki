---
/**
 * `/glossary/` — every term the topics lean on, in one bilingual list.
 *
 * The order is alphabetical by the English name in both locales: the sort is the same list on
 * `/glossary/` and `/zh/glossary/`, so a reader who switches language keeps their place, and the
 * term pages walk the same order with their previous/next links.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import { formatCount, t } from '@/i18n';
import { SITE } from '@/data/site';
import { buildHead, definedTermSetLd } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/glossary/', locale);

const glossary: CollectionEntry<'glossary'>[] = await getCollection('glossary');
const terms = [...glossary].sort((a, b) => a.data.en.localeCompare(b.data.en, 'en'));

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'glossary.title'),
  description: t(locale, 'glossary.sub'),
  kind: 'glossary',
  jsonLd: [definedTermSetLd({ name: t(locale, 'glossary.title'), url: `${SITE.url}${currentPath}` })],
});
---

<!-- Pagefind-ignored: the term pages are the glossary in the index, and indexing the list
  as well put a result called "Glossary" in front of the term the reader asked for. -->
<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap page">
    <header class="head">
      <h1>{t(locale, 'glossary.title')}</h1>
      <p>{t(locale, 'glossary.sub')}</p>
      <span class="lbl">
        {
          t(locale, 'glossary.count', {
            count: formatCount(locale, terms.length, 'unit.term', 'unit.terms'),
          })
        }
      </span>
    </header>

    <div class="panel gloss-list">
      {
        terms.map((term) => (
          <a class="gloss-row" href={localizePath(`/glossary/${term.id}/`, locale)}>
            <span class="gloss-name" lang="en">
              {term.data.en}
            </span>
            <span class="lbl gloss-alt" lang="zh-Hans">
              {term.data.zh}
            </span>
            <span class="gloss-short">{term.data.short[locale]}</span>
          </a>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .head p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 620px;
  }

  @media (max-width: 767px) {
    .page {
      gap: 24px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 32px;
    }
  }
</style>
