---
/** A static bilingual interview bank, enhanced in place by one idle client controller. */
import { getCollection, type CollectionEntry } from 'astro:content';

import Breadcrumb from '@/components/Breadcrumb.astro';
import Icon from '@/components/Icon.astro';
import InterviewQuestion, { type InterviewTopicLink } from '@/components/InterviewQuestion.astro';
import Seg from '@/components/Seg.astro';
import Tag from '@/components/Tag.astro';
import { SITE } from '@/data/site';
import { getTrack } from '@/data/tracks';
import { formatCount, t } from '@/i18n';
import InterviewControls from '@/islands/InterviewControls';
import Base from '@/layouts/Base.astro';
import { listTopics, topicMeta } from '@/lib/content';
import { stripMarkdown } from '@/lib/md';
import { breadcrumbLd, buildHead, faqPageLd } from '@/lib/seo';
import { localizePath, topicUrl, type Locale } from '@/lib/urls';
import type { Interview, InterviewItem } from '@/schemas/interview';

interface Props {
  locale: Locale;
  bank: CollectionEntry<'interview'>;
}

interface SectionGroup {
  key: string;
  id: string;
  title: string;
  items: InterviewItem[];
}

const { locale, bank } = Astro.props;
const interview = bank.data as Interview;
const bankItems: InterviewItem[] = interview.items;
const track = getTrack(interview.track);
if (!track) throw new Error(`Interview bank ${bank.id} names an unknown track`);

const currentPath = localizePath(`/practice/interview/${track.slug}/`, locale);
const pageUrl = `${SITE.url}${currentPath}`;
const trackName = track.name[locale];
const title = t(locale, 'interview.title', { Track: trackName });
const lead = t(locale, 'interview.lead');
const allBanks: CollectionEntry<'interview'>[] = await getCollection('interview');
const otherBanks = allBanks
  .filter((candidate) => candidate.id !== bank.id)
  .sort((a, b) => a.data.track.localeCompare(b.data.track));

const topics = await listTopics(locale);
const topicById = new Map<string, (typeof topics)[number]>(
  topics.map((topic) => {
    const { track, slug } = topicMeta(topic);
    return [`${track}/${slug}`, topic] as const;
  }),
);

const linksFor = (item: InterviewItem): InterviewTopicLink[] =>
  item.topics.map((ref) => {
    const [topicTrack = '', topicSlug = ''] = ref.split('/');
    const topic = topicById.get(ref);
    return {
      href: topicUrl(topicTrack, topicSlug, locale),
      title: topic?.data.title ?? topicSlug,
    };
  });

const sectionIds = new Map<string, number>();
const groups: SectionGroup[] = [];
for (const item of bankItems) {
  const key = item.section?.en ?? track.name.en;
  let group = groups.find((candidate) => candidate.key === key);
  if (!group) {
    const base = key
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
    const used = sectionIds.get(base) ?? 0;
    sectionIds.set(base, used + 1);
    const id = `section-${base || groups.length + 1}${used ? `-${used + 1}` : ''}`;
    group = { key, id, title: item.section?.[locale] ?? trackName, items: [] };
    groups.push(group);
  }
  group.items.push(item);
}

const questionNumber = new Map<string, number>(bankItems.map((item, index) => [item.id, index + 1]));
const questionList = bankItems
  .map((item, index) => `${index + 1}. ${stripMarkdown(item.question[locale])}`)
  .join('\n')
  .slice(0, 6_000);

const aiLabels = {
  open: t(locale, 'interview.mock'),
  title: t(locale, 'ai.title'),
  presets: {
    explain: t(locale, 'ai.explain'),
    quiz: t(locale, 'ai.quiz'),
    bugs: t(locale, 'ai.bugs'),
    compare: t(locale, 'ai.compare'),
    apply: t(locale, 'ai.apply'),
    feynman: t(locale, 'ai.feynman'),
  },
  claude: t(locale, 'ai.openClaude'),
  chatgpt: t(locale, 'ai.openChatGPT'),
  copy: t(locale, 'ai.copy'),
  copied: t(locale, 'ai.copied'),
  copyFailed: t(locale, 'ai.copyFailed'),
  close: t(locale, 'ai.close'),
  scopePage: t(locale, 'ai.scopePage'),
  scopeSection: t(locale, 'ai.scopeSection'),
};

const head = buildHead({
  locale,
  path: currentPath,
  title,
  description: lead,
  kind: 'page',
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
  jsonLd: [
    breadcrumbLd([
      { name: t(locale, 'practice.title'), url: `${SITE.url}${localizePath('/practice/', locale)}` },
      { name: title, url: pageUrl },
    ]),
    faqPageLd(
      bankItems.map((item) => ({
        question: stripMarkdown(item.question[locale]),
        answer: stripMarkdown(item.answer[locale]),
      })),
    ),
  ],
});

const levelItems = [
  { value: 'all', label: t(locale, 'interview.level.all'), on: true },
  { value: 'beginner', label: t(locale, 'interview.level.beginner') },
  { value: 'intermediate', label: t(locale, 'interview.level.intermediate') },
  { value: 'advanced', label: t(locale, 'interview.level.advanced') },
];
const revealItems = [
  { value: 'one', label: t(locale, 'interview.revealOne'), on: true },
  { value: 'all', label: t(locale, 'interview.revealAll') },
];
---

<Base
  locale={locale}
  head={head}
  currentPath={currentPath}
  pagefind={{ filter: { lang: locale, track: trackName }, meta: { type: 'page', track: trackName } }}
>
  <div class="wrap interview-page" data-interview-bank={track.slug}>
    <header class="interview-head">
      <Breadcrumb
        label={t(locale, 'nav.practice')}
        items={[
          { label: t(locale, 'practice.title'), href: localizePath('/practice/', locale) },
          { label: t(locale, 'practice.interviewBanks') },
          { label: trackName, current: true },
        ]}
      />
      <h1>{title}</h1>
      <p>{lead}</p>
      <div class="interview-chips">
        <Tag>
          {
            t(locale, 'interview.questions', {
              count: formatCount(locale, bankItems.length, 'unit.question', 'unit.questions'),
            })
          }
        </Tag>
        <Tag>{t(locale, 'interview.level.beginner')}</Tag>
        <span class="lbl" aria-hidden="true">→</span>
        <Tag>{t(locale, 'interview.level.advanced')}</Tag>
        <Tag><span lang={locale === 'en' ? 'zh-Hans' : 'en'}>{t(locale, 'practice.synced')}</span></Tag>
      </div>
    </header>

    <div class="interview-grid">
      <div class="interview-main">
        <div class="interview-controls">
          <div class="interview-controls-row">
            <div class="interview-control-groups">
              <div class="control-scroll">
                <Seg items={levelItems} label={t(locale, 'practice.level')} data-interview-levels />
              </div>
              <div class="control-scroll">
                <Seg items={revealItems} label={t(locale, 'interview.revealOne')} data-interview-reveal />
              </div>
            </div>
            <div class="interview-actions">
              <button type="button" class="act" data-interview-shuffle>
                {t(locale, 'interview.shuffle')}
              </button>
              <InterviewControls
                client:idle
                track={track.slug}
                questionList={questionList}
                labels={{
                  seenCount: t(locale, 'interview.seenCount', {
                    seen: '{seen}',
                    total: '{total}',
                  }),
                  copied: t(locale, 'code.copied'),
                  copyFailed: t(locale, 'code.copyFailed'),
                }}
                aiLabels={aiLabels}
                aiContext={{
                  locale,
                  title,
                  url: pageUrl,
                  language: track.name.en,
                  section: t(locale, 'practice.interviewBanks'),
                  sectionText: questionList,
                }}
              />
            </div>
          </div>

          <label class="interview-filter">
            <span class="filter-label">{t(locale, 'interview.filter')}</span>
            <Icon name="search" size={15} />
            <input
              type="search"
              class="field"
              placeholder={t(locale, 'interview.filter')}
              data-interview-filter
            />
          </label>
        </div>

        {
          groups.map((group) => (
            <section class="interview-section" data-interview-section={group.id}>
              <header class="interview-section-head" id={group.id}>
                <h2>{group.title}</h2>
                <span class="lbl">
                  {t(locale, 'interview.questions', {
                    count: formatCount(locale, group.items.length, 'unit.question', 'unit.questions'),
                  })}
                  <span data-section-seen hidden>
                    {' · '}
                    <span data-section-seen-count>0</span> {t(locale, 'interview.seen')}
                  </span>
                </span>
              </header>
              <div class="interview-questions" data-question-list>
                {group.items.map((item) => (
                  <InterviewQuestion
                    locale={locale}
                    track={track.slug}
                    trackName={track.name.en}
                    pageUrl={pageUrl}
                    item={item}
                    number={questionNumber.get(item.id) ?? 0}
                    topics={linksFor(item)}
                  />
                ))}
              </div>
            </section>
          ))
        }
        <p class="panel interview-empty" data-interview-empty hidden>
          {t(locale, 'interview.noResults')}
        </p>
      </div>

      <aside class="interview-rail">
        <div class="panel interview-rail-panel">
          <span class="lbl">{t(locale, 'interview.inBank')}</span>
          <nav class="toc" aria-label={t(locale, 'interview.inBank')}>
            {
              groups.map((group, index) => (
                <a class:list={[index === 0 && 'on']} href={`#${group.id}`} data-section-link={group.id}>
                  {group.title} <span class="lbl">· {group.items.length}</span>
                </a>
              ))
            }
          </nav>
        </div>

        <div class="panel interview-rail-panel">
          <span class="lbl">{t(locale, 'interview.progress')}</span>
          <div class="interview-progress-row">
            <span>{t(locale, 'interview.seen')}</span>
            <span class="lbl" data-progress-count>
              {t(locale, 'interview.seenCount', { seen: 0, total: bankItems.length })}
            </span>
          </div>
          <div class="interview-progress-bar" aria-hidden="true">
            <i data-progress-bar></i>
          </div>
          <button type="button" class="btn btn-g add-all" data-add-all>
            {
              t(locale, 'interview.addAll', {
                count: formatCount(locale, bankItems.length, 'unit.answer', 'unit.answers'),
              })
            }
          </button>
        </div>

        <div class="panel interview-rail-panel">
          <span class="lbl">{t(locale, 'interview.otherBanks')}</span>
          {
            otherBanks.map((other) => {
              const otherTrack = getTrack(other.data.track);
              return (
                <a class="other-bank" href={localizePath(`/practice/interview/${other.data.track}/`, locale)}>
                  <span>{otherTrack?.name[locale] ?? other.data.track}</span>
                  <span class="lbl">{other.data.items.length}</span>
                </a>
              );
            })
          }
          {otherBanks.length === 0 && <p class="rail-empty">{t(locale, 'interview.noOtherBanks')}</p>}
        </div>

        <div class="panel interview-rail-panel interview-ai-card">
          <span class="lbl">{t(locale, 'ai.title')}</span>
          <p>
            {
              t(locale, 'interview.mockLead', {
                count: formatCount(locale, bankItems.length, 'unit.question', 'unit.questions'),
              })
            }
          </p>
          <span class="lbl">{t(locale, 'practice.aiTools')}</span>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .interview-page,
  .interview-head,
  .interview-main,
  .interview-controls,
  .interview-section,
  .interview-questions,
  .interview-rail,
  .interview-rail-panel {
    display: flex;
    flex-direction: column;
  }

  .interview-page {
    padding-bottom: 72px;
  }

  .interview-head {
    gap: 14px;
    padding-top: 36px;
    padding-bottom: 22px;
  }

  h1 {
    font-size: 40px;
    line-height: 1.1;
  }

  .interview-head > p {
    max-width: 780px;
    margin: 0;
    color: var(--ink2);
    font-size: 17px;
    line-height: 1.6;
  }

  .interview-chips,
  .interview-controls-row,
  .interview-control-groups,
  .interview-actions,
  .interview-section-head,
  .interview-progress-row,
  .other-bank {
    display: flex;
    align-items: center;
  }

  .interview-chips {
    gap: 8px;
    flex-wrap: wrap;
  }

  .interview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }

  .interview-main {
    min-width: 0;
    gap: 14px;
  }

  .interview-controls {
    gap: 12px;
    min-width: 0;
  }

  .interview-controls-row {
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .interview-control-groups,
  .interview-actions {
    gap: 10px;
  }

  .control-scroll {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .control-scroll::-webkit-scrollbar {
    display: none;
  }

  .control-scroll :global(.seg) {
    width: max-content;
  }

  .interview-actions :global(.ask-open) {
    white-space: nowrap;
  }

  .interview-filter {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--ink3);
  }

  .filter-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .interview-filter :global(svg) {
    position: absolute;
    left: 12px;
    pointer-events: none;
  }

  .interview-filter input {
    width: 100%;
    padding-left: 36px;
  }

  .interview-filter input::placeholder {
    color: var(--ink3);
    opacity: 1;
  }

  .interview-section {
    gap: 12px;
  }

  .interview-section + .interview-section {
    margin-top: 4px;
  }

  .interview-section-head {
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 20px;
  }

  .interview-section-head h2 {
    font-size: 18px;
  }

  .interview-questions {
    gap: 10px;
  }

  .interview-rail {
    position: sticky;
    top: 20px;
    gap: 20px;
  }

  .interview-rail-panel {
    gap: 10px;
    padding: 16px 18px;
  }

  .interview-progress-row,
  .other-bank {
    justify-content: space-between;
    gap: 12px;
    color: var(--ink);
    font-size: 14px;
  }

  .other-bank:hover {
    color: var(--acc);
  }

  .interview-progress-bar {
    height: 6px;
    overflow: hidden;
    border-radius: 3px;
    background: var(--sur2);
  }

  .interview-progress-bar i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--acc);
    transition: width var(--t-state) var(--ease);
  }

  .add-all {
    align-self: stretch;
    justify-content: center;
    height: auto;
    min-height: 36px;
    padding: 7px 10px;
    text-align: center;
  }

  .interview-ai-card {
    border-color: var(--acc2);
  }

  .interview-ai-card > .lbl:first-child {
    color: var(--acc2);
  }

  .interview-ai-card p {
    margin: 0;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.5;
  }

  .interview-empty,
  .rail-empty {
    margin: 0;
    color: var(--ink2);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .interview-empty {
    padding: 20px;
    text-align: center;
  }

  @media (max-width: 1023px) {
    .interview-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .interview-rail {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .interview-page {
      padding-bottom: 40px;
    }

    .interview-head {
      padding-top: 28px;
      padding-bottom: 20px;
    }

    h1 {
      font-size: 32px;
    }

    .interview-head > p {
      font-size: 15px;
    }

    .interview-controls-row,
    .interview-control-groups {
      align-items: stretch;
      flex-direction: column;
    }

    .interview-actions {
      align-items: stretch;
      flex-wrap: wrap;
    }

    .interview-actions > .act,
    .interview-actions :global(.ask),
    .interview-actions :global(.ask-open) {
      justify-content: center;
    }

    .interview-rail {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
  }
</style>
