---
/** Client-side prompt builder, shared by its English and Chinese static routes. */
import Base from '@/layouts/Base.astro';
import Tag from '@/components/Tag.astro';
import PromptBuilderIsland, { type PromptBuilderLabels } from '@/islands/PromptBuilder';
import { TRACKS } from '@/data/tracks';
import { t } from '@/i18n';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/ai/prompt-builder/', locale);
const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'promptBuilder.title'),
  description: t(locale, 'promptBuilder.sub'),
  kind: 'page',
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
});

const labels: PromptBuilderLabels = {
  steps: {
    topic: t(locale, 'promptBuilder.step.topic'),
    goal: t(locale, 'promptBuilder.step.goal'),
    level: t(locale, 'promptBuilder.step.level'),
    options: t(locale, 'promptBuilder.step.options'),
    code: t(locale, 'promptBuilder.step.code'),
  },
  goals: {
    explain: {
      name: t(locale, 'promptBuilder.goal.explain'),
      description: t(locale, 'promptBuilder.goal.explainDesc'),
    },
    quiz: {
      name: t(locale, 'promptBuilder.goal.quiz'),
      description: t(locale, 'promptBuilder.goal.quizDesc'),
    },
    review: {
      name: t(locale, 'promptBuilder.goal.review'),
      description: t(locale, 'promptBuilder.goal.reviewDesc'),
    },
    port: {
      name: t(locale, 'promptBuilder.goal.port'),
      description: t(locale, 'promptBuilder.goal.portDesc'),
    },
    tests: {
      name: t(locale, 'promptBuilder.goal.tests'),
      description: t(locale, 'promptBuilder.goal.testsDesc'),
    },
    socratic: {
      name: t(locale, 'promptBuilder.goal.socratic'),
      description: t(locale, 'promptBuilder.goal.socraticDesc'),
    },
  },
  levels: {
    beginner: t(locale, 'promptBuilder.level.beginner'),
    intermediate: t(locale, 'promptBuilder.level.intermediate'),
    advanced: t(locale, 'promptBuilder.level.advanced'),
  },
  options: {
    link: t(locale, 'promptBuilder.option.link'),
    checklist: t(locale, 'promptBuilder.option.checklist'),
    vocabulary: t(locale, 'promptBuilder.option.vocabulary'),
    zh: t(locale, 'promptBuilder.option.zh'),
    concise: t(locale, 'promptBuilder.option.concise'),
  },
  searchPlaceholder: t(locale, 'promptBuilder.searchPlaceholder'),
  searchLoading: t(locale, 'promptBuilder.searchLoading'),
  searchEmpty: t(locale, 'promptBuilder.searchEmpty'),
  searchError: t(locale, 'promptBuilder.searchError'),
  removeTopic: t(locale, 'promptBuilder.removeTopic'),
  codeHint: t(locale, 'promptBuilder.codeHint'),
  preview: t(locale, 'promptBuilder.preview'),
  tokens: t(locale, 'promptBuilder.tokens', { n: '{n}' }),
  openClaude: t(locale, 'promptBuilder.openClaude'),
  openChatGPT: t(locale, 'promptBuilder.openChatGPT'),
  copy: t(locale, 'promptBuilder.copy'),
  copied: t(locale, 'promptBuilder.copied'),
  copyFailed: t(locale, 'promptBuilder.copyFailed'),
  openHint: t(locale, 'promptBuilder.openHint'),
  whyTitle: t(locale, 'promptBuilder.whyTitle'),
  whyBody: t(locale, 'promptBuilder.whyBody'),
  rulesPack: t(locale, 'rules.pack', { track: '{track}' }),
  rulesCount: t(locale, 'rules.count', { n: '{n}', track: '{track}' }),
};

const trackNames = Object.fromEntries(TRACKS.map((track) => [track.slug, track.name[locale]]));
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap prompt-builder-page">
    <header class="prompt-builder-head">
      <nav class="prompt-builder-kicker" aria-label={t(locale, 'nav.aiEra')}>
        <Tag variant="acc2">{t(locale, 'nav.aiEra')}</Tag>
        <span class="lbl">/</span>
        <Tag variant="acc">{t(locale, 'promptBuilder.eyebrow')}</Tag>
      </nav>
      <h1>{t(locale, 'promptBuilder.title')}</h1>
      <p>{t(locale, 'promptBuilder.sub')}</p>
    </header>

    <PromptBuilderIsland client:load locale={locale} labels={labels} trackNames={trackNames} />
  </div>
</Base>
