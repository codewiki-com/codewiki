---
/**
 * The bilingual practice catalogue. Every exercise and filter link is useful as static HTML;
 * the two idle islands only add browser-local progress, filtering, sorting and disclosure.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import { collections } from '@/content.config';
import PracticeCard from '@/components/PracticeCard.astro';
import Seg from '@/components/Seg.astro';
import Tag from '@/components/Tag.astro';
import { TRACKS } from '@/data/tracks';
import { formatCount, t } from '@/i18n';
import PracticeFilters from '@/islands/PracticeFilters';
import TodayStrip, { type TodayPath, type TodayKata } from '@/islands/TodayStrip';
import Base from '@/layouts/Base.astro';
import { listTopics, topicMeta } from '@/lib/content';
import {
  ITEM_TYPES,
  kataOfTheDay,
  listPracticeItems,
  practiceItemTitle,
  practiceUrl,
  type ItemType,
} from '@/lib/practice';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';
import type { Path } from '@/schemas/path';

interface Props {
  locale: Locale;
}

interface InterviewEntry {
  id: string;
  data: {
    track: string;
    items: unknown[];
  };
}

const { locale } = Astro.props;
const currentPath = localizePath('/practice/', locale);
const items = await listPracticeItems();
const topics = await listTopics(locale);
const paths: CollectionEntry<'paths'>[] = await getCollection('paths');

const trackBySlug = new Map(TRACKS.map((track) => [track.slug, track]));
const topicById = new Map(
  topics.map((topic) => {
    const { track, slug } = topicMeta(topic);
    return [`${track}/${slug}`, topic] as const;
  }),
);
const presentTracks = TRACKS.filter((track) => items.some((item) => item.track === track.slug));
const trackCount = new Set(items.map((item) => item.track)).size;

const firstBankUrl = new Map<string, string>();
for (const item of items) {
  if (!firstBankUrl.has(item.bank)) firstBankUrl.set(item.bank, practiceUrl(item, locale));
}

const todayPaths: TodayPath[] = paths.map((path) => ({
  id: path.id,
  title: path.data.title[locale],
  milestones: path.data.milestones.map((milestone: Path['milestones'][number], index: number) => ({
    number: index + 1,
    title: milestone.title[locale],
    bank: milestone.checkpoint,
    // Some planned checkpoint banks are not authored yet. The hub remains a safe destination
    // until there is a concrete kata in that bank to open.
    href: firstBankUrl.get(milestone.checkpoint) ?? currentPath,
  })),
}));

/**
 * This runs during the static build. The UTC-day rotation therefore advances on a deploy made on
 * a new day, not at midnight in each visitor's timezone.
 */
const daily = kataOfTheDay(items, new Date());
const dailyTopic = daily ? topicById.get(`${daily.track}/${daily.slug}`) : undefined;
const dailyTrack = daily ? trackBySlug.get(daily.track) : undefined;
const todayKata: TodayKata | undefined = daily
  ? {
      href: practiceUrl(daily, locale),
      type: t(locale, `practice.type.${daily.type}`),
      track: dailyTrack?.name[locale] ?? daily.track,
      title: practiceItemTitle(daily, locale),
      description: dailyTopic?.data.description ?? t(locale, 'practice.from', { title: daily.slug }),
      minutes: t(locale, 'practice.minutes', {
        count: formatCount(locale, daily.minutes, 'unit.minute', 'unit.minutes'),
      }),
    }
  : undefined;

/* Task 8 registers this collection. Checking only the registry keeps the rest of this page live
   before then and avoids hiding unrelated build failures inside a page-wide catch. */
const getNamedCollection = getCollection as unknown as (name: string) => Promise<InterviewEntry[]>;
const interviewBanks = Object.hasOwn(collections, 'interview') ? await getNamedCollection('interview') : [];

const typeTabs = [
  { value: 'all', label: t(locale, 'practice.all'), href: currentPath },
  ...ITEM_TYPES.map((type) => ({
    value: type,
    label: t(locale, `practice.type.${type}`),
    href: `${currentPath}?type=${type}`,
  })),
];

const trackFilters = [
  { label: t(locale, 'practice.allTracks'), value: 'all', on: true, href: currentPath },
  ...presentTracks.map((track) => ({
    label: track.name[locale],
    value: track.slug,
    href: `${currentPath}?track=${track.slug}`,
  })),
];

const levels = ['beginner', 'intermediate', 'advanced'] as const;
const levelFilters = [
  { label: t(locale, 'practice.all'), value: 'all', on: true, href: currentPath },
  ...levels.map((level) => ({
    label: t(locale, `difficulty.${level}`),
    value: level,
    href: `${currentPath}?level=${level}`,
  })),
];

const sortFilters = [
  {
    label: t(locale, 'practice.sort.unsolved'),
    value: 'unsolved',
    on: true,
    href: currentPath,
  },
  {
    label: t(locale, 'practice.sort.newest'),
    value: 'newest',
    href: `${currentPath}?sort=newest`,
  },
  {
    label: t(locale, 'practice.sort.hardest'),
    value: 'hardest',
    href: `${currentPath}?sort=hardest`,
  },
];

const lead = t(locale, 'practice.lead');
const head = buildHead({
  locale,
  path: currentPath,
  title: 'Practice',
  description: lead,
  kind: 'page',
  // Task 6 does not add a new OG renderer; use the existing locale-specific site card.
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
});

const difficultyLabel = (type: ItemType) => t(locale, `practice.type.${type}`);
---

<Base
  locale={locale}
  head={head}
  currentPath={currentPath}
  pagefind={{ filter: { lang: locale }, meta: { type: 'page' } }}
>
  <header class="wrap practice-header">
    <div class="practice-kicker">
      <Tag>{t(locale, 'practice.title')}</Tag>
      <span class="lbl">/</span>
      <Tag variant="acc">{t(locale, 'practice.scope')}</Tag>
    </div>
    <h1>{t(locale, 'practice.title')}</h1>
    <p>{lead}</p>
    <div class="practice-chips">
      <Tag>
        {
          t(locale, 'practice.items', {
            count: formatCount(locale, items.length, 'unit.item', 'unit.items'),
          })
        }
      </Tag>
      <Tag>
        {formatCount(locale, trackCount, 'unit.track', 'unit.tracks')}
      </Tag>
      <Tag>{t(locale, 'practice.offline')}</Tag>
      <Tag><span lang="zh-Hans">{t(locale, 'practice.synced')}</span></Tag>
    </div>
  </header>

  <TodayStrip
    client:idle
    locale={locale}
    kata={todayKata}
    paths={todayPaths}
    flashcardsUrl={localizePath('/practice/flashcards/', locale)}
    labels={{
      today: t(locale, 'practice.today'),
      start: t(locale, 'practice.start'),
      flashcards: t(locale, 'practice.flashcards'),
      due: t(locale, 'practice.due', { count: '{count}' }),
      cardDue: t(locale, 'practice.cardDue'),
      cardsDue: t(locale, 'practice.cardsDue', { count: '{count}' }),
      flashcardsDesc: t(locale, 'practice.flashcardsDesc'),
      flashcardsPlaceholder: t(locale, 'practice.flashcardsPlaceholder'),
      review: t(locale, 'practice.review'),
      checkpoint: t(locale, 'practice.checkpoint'),
      pathMilestone: t(locale, 'practice.pathMilestone', { path: '{path}', number: '{number}' }),
      checkpointReady: t(locale, 'practice.checkpointReady', { milestone: '{milestone}' }),
      checkpointDesc: t(locale, 'practice.checkpointDesc'),
      checkpointPlaceholder: t(locale, 'practice.checkpointPlaceholder'),
      take: t(locale, 'practice.take'),
      passMark: t(locale, 'practice.passMark'),
      done: t(locale, 'practice.done', { score: '{score}', total: '{total}' }),
      missed: t(locale, 'practice.missed'),
      daysShort: t(locale, 'practice.daysShort', { count: '{count}' }),
    }}
  />

  <div class="wrap practice-body">
    <div class="practice-main">
      <div class="practice-controls" data-practice-controls>
        <nav class="practice-tabs" aria-label={t(locale, 'practice.title')} data-filter-group="type">
          {
            typeTabs.map((tab, index) => (
              <a
                class:list={[index === 0 && 'on']}
                href={tab.href}
                data-value={tab.value}
                aria-current={index === 0 ? 'true' : undefined}
              >
                {tab.label}
              </a>
            ))
          }
        </nav>

        <div class="practice-filter-row">
          <div class="filter-scroll">
            <Seg items={trackFilters} label={t(locale, 'practice.allTracks')} data-filter-group="track" />
          </div>
          <div class="filter-pair">
            <span class="lbl">{t(locale, 'practice.level')}</span>
            <div class="filter-scroll">
              <Seg items={levelFilters} label={t(locale, 'practice.level')} data-filter-group="level" />
            </div>
          </div>
        </div>

        <div class="practice-count-row">
          <span class="lbl" data-practice-count>
            {
              t(locale, 'practice.results', {
                count: formatCount(locale, items.length, 'unit.exercise', 'unit.exercises'),
                done: 0,
              })
            }
          </span>
          <div class="filter-pair">
            <span class="lbl">{t(locale, 'practice.sort')}</span>
            <div class="filter-scroll">
              <Seg items={sortFilters} label={t(locale, 'practice.sort')} data-filter-group="sort" />
            </div>
          </div>
        </div>
      </div>

      <div class="practice-grid" data-practice-grid>
        {
          items.map((item, index) => {
            const topic = topicById.get(`${item.track}/${item.slug}`);
            const track = trackBySlug.get(item.track);
            return (
              <PracticeCard
                item={item}
                locale={locale}
                trackGlyph={track?.glyph ?? item.track}
                topicTitle={topic?.data.title ?? item.slug}
                topicDescription={topic?.data.description ?? difficultyLabel(item.type)}
                order={index}
                more={index >= 24}
              />
            );
          })
        }
      </div>

      <p class="panel practice-empty" data-practice-empty hidden>
        {t(locale, 'practice.noResults')}
      </p>
      {
        items.length > 24 && (
          <div class="practice-more">
            <button class="btn btn-g" type="button" data-practice-more hidden>
              {t(locale, 'practice.showMore', { count: items.length - 24 })}
            </button>
          </div>
        )
      }
    </div>

    <aside class="practice-rail">
      <div class="panel practice-rail-panel" data-practice-stats aria-live="polite">
        <span class="lbl">{t(locale, 'practice.yourPractice')}</span>
        <div class="practice-stats">
          <div class="stat">
            <b data-practice-stat="solved">0</b>
            <span class="lbl">{t(locale, 'practice.solved')}</span>
          </div>
          <div class="stat">
            <b data-practice-stat="accuracy">0%</b>
            <span class="lbl">{t(locale, 'practice.accuracy')}</span>
          </div>
          <div class="stat">
            <b data-practice-stat="streak">0d</b>
            <span class="lbl">{t(locale, 'practice.streak')}</span>
          </div>
        </div>
      </div>

      {
        interviewBanks.length > 0 && (
          <div class="panel practice-rail-panel">
            <span class="lbl">{t(locale, 'practice.interviewBanks')}</span>
            {interviewBanks.map((bank) => {
              const track = trackBySlug.get(bank.data.track);
              return (
                <a
                  class="interview-row"
                  href={localizePath(`/practice/interview/${bank.data.track}/`, locale)}
                >
                  <span>{track?.name[locale] ?? bank.data.track}</span>
                  <span class="lbl">
                    {t(locale, 'practice.questions', {
                      count: formatCount(locale, bank.data.items.length, 'unit.question', 'unit.questions'),
                    })}
                  </span>
                </a>
              );
            })}
          </div>
        )
      }

      <div class="panel practice-rail-panel practice-ai">
        <span class="lbl">{t(locale, 'practice.askYourAi')}</span>
        <span class="ai-prompt">“{t(locale, 'practice.hubAiPrompt')}”</span>
        <span class="lbl">{t(locale, 'practice.aiTools')}</span>
      </div>
    </aside>
  </div>

  <PracticeFilters
    client:idle
    locale={locale}
    labels={{
      results: t(locale, 'practice.results', { count: '{count}', done: '{done}' }),
      showMore: t(locale, 'practice.showMore', { count: '{count}' }),
      done: t(locale, 'practice.done', { score: '{score}', total: '{total}' }),
      missed: t(locale, 'practice.missed'),
    }}
  />
</Base>

<style>
  .practice-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 44px;
    padding-bottom: 24px;
  }

  .practice-kicker,
  .practice-chips {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .practice-header p {
    max-width: 760px;
    margin: 0;
    color: var(--ink2);
    font-size: 17px;
    line-height: 1.6;
  }

  .practice-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    padding-bottom: 72px;
  }

  .practice-main,
  .practice-controls,
  .practice-rail,
  .practice-rail-panel {
    display: flex;
    flex-direction: column;
  }

  .practice-main {
    min-width: 0;
    gap: 18px;
  }

  .practice-controls {
    gap: 14px;
    min-width: 0;
  }

  .practice-tabs {
    display: flex;
    gap: 22px;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }

  .practice-tabs::-webkit-scrollbar {
    display: none;
  }

  .practice-tabs a {
    flex: none;
    margin-bottom: -1px;
    padding: 8px 0 10px;
    border-bottom: 2px solid transparent;
    color: var(--ink3);
    font-size: 13.5px;
    white-space: nowrap;
  }

  .practice-tabs a:hover,
  .practice-tabs a.on {
    color: var(--ink);
  }

  .practice-tabs a.on {
    border-bottom-color: var(--ink);
    font-weight: 500;
  }

  .practice-filter-row,
  .practice-count-row,
  .filter-pair,
  .interview-row {
    display: flex;
    align-items: center;
  }

  .practice-filter-row,
  .practice-count-row {
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .filter-pair {
    gap: 10px;
    min-width: 0;
  }

  .filter-scroll {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .filter-scroll :global(.seg) {
    width: max-content;
  }

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .practice-empty {
    margin: 0;
    padding: 24px;
    color: var(--ink2);
    font-size: 14px;
    text-align: center;
  }

  .practice-more {
    display: flex;
    justify-content: center;
    min-height: 40px;
    padding-top: 6px;
  }

  .practice-more .btn {
    white-space: nowrap;
  }

  .practice-rail {
    gap: 20px;
    min-width: 0;
  }

  .practice-rail-panel {
    gap: 12px;
    padding: 16px 18px;
  }

  .practice-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .stat b {
    color: var(--ink);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .stat .lbl {
    font-size: 11.5px;
  }

  .interview-row {
    justify-content: space-between;
    gap: 12px;
    color: var(--ink);
    font-size: 14px;
  }

  .interview-row:hover {
    color: var(--acc);
  }

  .practice-ai {
    border-color: var(--acc2);
    gap: 8px;
  }

  .practice-ai > .lbl:first-child {
    color: var(--acc2);
  }

  .ai-prompt {
    color: var(--ink);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 1023px) {
    .practice-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .practice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .practice-header {
      padding-top: 28px;
      padding-bottom: 20px;
    }

    h1 {
      font-size: 32px;
    }

    .practice-header p {
      font-size: 15px;
    }

    .practice-body {
      gap: 28px;
      padding-bottom: 40px;
    }

    .practice-filter-row,
    .practice-count-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .filter-pair,
    .filter-scroll {
      width: 100%;
    }

    .filter-pair {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .practice-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
