---
/**
 * The bilingual practice hub.
 *
 * It used to server-render all 1,748 exercise cards into one document — 1.77 MB of HTML, 17,726
 * DOM elements and up to 16.7 s of blocking time before the filter island could answer a tap. The
 * catalogue now lives at `/practice/{track}/`, one static page per track, and this page is the
 * index: what to do today, and how much there is to do in each track.
 *
 * Nothing here is a card, so the page needs no filter island. The one script it carries sends a
 * legacy `?track=` link on to the route that replaced it.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import { collections } from '@/content.config';
import Tag from '@/components/Tag.astro';
import { TRACKS } from '@/data/tracks';
import { formatCount, t } from '@/i18n';
import TodayStrip, { type TodayPath, type TodayKata } from '@/islands/TodayStrip';
import Base from '@/layouts/Base.astro';
import { listTopics, topicMeta } from '@/lib/content';
import {
  dailyKataPool,
  dailyKataWindow,
  ITEM_TYPES,
  listPracticeItems,
  practiceItemTitle,
  practiceUrl,
  utcDay,
  type ItemType,
} from '@/lib/practice';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';
import type { Path } from '@/schemas/path';

interface Props {
  locale: Locale;
}

interface InterviewEntry {
  id: string;
  data: {
    track: string;
    items: unknown[];
  };
}

const { locale } = Astro.props;
const currentPath = localizePath('/practice/', locale);
const items = await listPracticeItems();
const topics = await listTopics(locale);
const paths: CollectionEntry<'paths'>[] = await getCollection('paths');

const trackBySlug = new Map(TRACKS.map((track) => [track.slug, track]));
const topicById = new Map(
  topics.map((topic) => {
    const { track, slug } = topicMeta(topic);
    return [`${track}/${slug}`, topic] as const;
  }),
);

/** Per-track totals and the per-type breakdown each cell states. */
const byTrack = new Map<string, { total: number; types: Map<ItemType, number> }>();
for (const item of items) {
  const entry = byTrack.get(item.track) ?? { total: 0, types: new Map<ItemType, number>() };
  entry.total += 1;
  entry.types.set(item.type, (entry.types.get(item.type) ?? 0) + 1);
  byTrack.set(item.track, entry);
}

/**
 * Flagship tracks first, then the rest by name — docs/design/flagship-tracks.md. "Browse by
 * track" is the same promise the home page and `/tracks/` make, so it keeps the same order.
 */
const browseTracks = [
  ...TRACKS.filter((track) => track.flagship),
  ...TRACKS.filter((track) => !track.flagship).sort((a, b) =>
    a.name[locale].localeCompare(b.name[locale], locale === 'zh' ? 'zh-Hans-CN' : 'en-US'),
  ),
].filter((track) => byTrack.has(track.slug));

const trackCells = browseTracks.map((track) => {
  const entry = byTrack.get(track.slug)!;
  return {
    track,
    href: localizePath(`/practice/${track.slug}/`, locale),
    // One line of text rather than one element per count: this page's whole point is a DOM
    // small enough that the browser is never busy when the reader arrives.
    breakdown: [
      formatCount(locale, entry.total, 'unit.exercise', 'unit.exercises'),
      ...ITEM_TYPES.filter((type) => entry.types.has(type)).map(
        (type) => `${t(locale, `practice.type.${type}`)} ${entry.types.get(type) ?? 0}`,
      ),
    ].join(' · '),
  };
});

const firstBankUrl = new Map<string, string>();
for (const item of items) {
  if (!firstBankUrl.has(item.bank)) firstBankUrl.set(item.bank, practiceUrl(item, locale));
}

const todayPaths: TodayPath[] = paths.map((path) => ({
  id: path.id,
  title: path.data.title[locale],
  milestones: path.data.milestones.map((milestone: Path['milestones'][number], index: number) => ({
    number: index + 1,
    title: milestone.title[locale],
    bank: milestone.checkpoint,
    // Some planned checkpoint banks are not authored yet. The hub remains a safe destination
    // until there is a concrete kata in that bank to open.
    href: firstBankUrl.get(milestone.checkpoint) ?? currentPath,
  })),
}));

/**
 * The same pool and the same seven-day window as the home page's daily kata, so both surfaces
 * name the same item as "today". This runs during the static build; the strip's island rotates
 * to the visitor's own UTC day, and beyond the window the last entry stands.
 */
const buildDate = new Date();
const todayKatas: TodayKata[] = dailyKataWindow(dailyKataPool(items), buildDate).map((kata) => {
  const topic = topicById.get(`${kata.track}/${kata.slug}`);
  return {
    href: practiceUrl(kata, locale),
    type: t(locale, `practice.type.${kata.type}`),
    track: trackBySlug.get(kata.track)?.name[locale] ?? kata.track,
    title: practiceItemTitle(kata, locale),
    description: topic?.data.description ?? t(locale, 'practice.from', { title: kata.slug }),
    minutes: t(locale, 'practice.minutes', {
      count: formatCount(locale, kata.minutes, 'unit.minute', 'unit.minutes'),
    }),
  };
});

/* Task 8 registers this collection. Checking only the registry keeps the rest of this page live
   before then and avoids hiding unrelated build failures inside a page-wide catch. */
const getNamedCollection = getCollection as unknown as (name: string) => Promise<InterviewEntry[]>;
const interviewBanks = Object.hasOwn(collections, 'interview') ? await getNamedCollection('interview') : [];

const lead = t(locale, 'practice.lead');
const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'practice.title'),
  description: lead,
  kind: 'page',
  // Task 6 does not add a new OG renderer; use the existing locale-specific site card.
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
});
---

<Base
  locale={locale}
  head={head}
  currentPath={currentPath}
  pagefind={{ filter: { lang: locale }, meta: { type: 'page' } }}
>
  <script is:inline data-practice-legacy-track={trackCells.map((cell) => cell.track.slug).join(',')}>
    /* `?track=go` was how this page filtered before the catalogue was split by track. Old links,
       bookmarks and search results still carry it, so send one on to the route that replaced it.
       Inline and first in the document: a redirect owes the reader no idle callback. */
    (function () {
      var known = (document.currentScript.dataset.practiceLegacyTrack || '').split(',');
      try {
        var url = new URL(location.href);
        var track = url.searchParams.get('track');
        if (!track || known.indexOf(track) < 0) return;
        url.searchParams.delete('track');
        var prefix = location.pathname.indexOf('/zh/') === 0 ? '/zh' : '';
        location.replace(prefix + '/practice/' + track + '/' + url.search + url.hash);
      } catch {
        /* a hand-edited URL is not worth a broken page */
      }
    })();
  </script>

  <header class="wrap practice-header">
    <div class="practice-kicker">
      <Tag>{t(locale, 'practice.title')}</Tag>
      <span class="lbl">/</span>
      <Tag variant="acc">{t(locale, 'practice.scope')}</Tag>
    </div>
    <h1>{t(locale, 'practice.title')}</h1>
    <p>{lead}</p>
    <div class="practice-chips">
      <Tag>
        {
          t(locale, 'practice.items', {
            count: formatCount(locale, items.length, 'unit.item', 'unit.items'),
          })
        }
      </Tag>
      <Tag>
        {formatCount(locale, trackCells.length, 'unit.track', 'unit.tracks')}
      </Tag>
      <Tag>{t(locale, 'practice.offline')}</Tag>
    </div>
  </header>

  <TodayStrip
    client:idle
    locale={locale}
    buildDay={utcDay(buildDate)}
    katas={todayKatas}
    paths={todayPaths}
    flashcardsUrl={localizePath('/practice/flashcards/', locale)}
    labels={{
      today: t(locale, 'practice.today'),
      start: t(locale, 'practice.start'),
      flashcards: t(locale, 'practice.flashcards'),
      due: t(locale, 'practice.due', { count: '{count}' }),
      cardDue: t(locale, 'practice.cardDue'),
      cardsDue: t(locale, 'practice.cardsDue', { count: '{count}' }),
      flashcardsDesc: t(locale, 'practice.flashcardsDesc'),
      flashcardsPlaceholder: t(locale, 'practice.flashcardsPlaceholder'),
      review: t(locale, 'practice.review'),
      checkpoint: t(locale, 'practice.checkpoint'),
      pathMilestone: t(locale, 'practice.pathMilestone', { path: '{path}', number: '{number}' }),
      checkpointReady: t(locale, 'practice.checkpointReady', { milestone: '{milestone}' }),
      checkpointDesc: t(locale, 'practice.checkpointDesc'),
      checkpointPlaceholder: t(locale, 'practice.checkpointPlaceholder'),
      take: t(locale, 'practice.take'),
      passMark: t(locale, 'practice.passMark'),
      done: t(locale, 'practice.done', { score: '{score}', total: '{total}' }),
      missed: t(locale, 'practice.missed'),
      daysShort: t(locale, 'practice.daysShort', { count: '{count}' }),
    }}
  />

  <div class="wrap practice-body">
    <div class="practice-main">
      <h2 class="lbl practice-intro">{t(locale, 'practice.byTrack')}</h2>

      <div class="practice-tracks" data-practice-tracks>
        {
          trackCells.map((cell) => (
            <a class:list={['track', cell.track.slug === 'ai-era' && 'ai-era']} href={cell.href}>
              <Tag variant="acc">{cell.track.glyph}</Tag>
              <span class="track-name">{cell.track.name[locale]}</span>
              <span class="lbl track-types">{cell.breakdown}</span>
            </a>
          ))
        }
      </div>
    </div>

    <aside class="practice-rail">
      <div class="panel practice-rail-panel" data-practice-stats aria-live="polite">
        <span class="lbl">{t(locale, 'practice.yourPractice')}</span>
        <div class="practice-stats">
          <div class="stat">
            <b data-practice-stat="solved">0</b>
            <span class="lbl">{t(locale, 'practice.solved')}</span>
          </div>
          <div class="stat">
            <b data-practice-stat="accuracy">0%</b>
            <span class="lbl">{t(locale, 'practice.accuracy')}</span>
          </div>
          <div class="stat">
            <b data-practice-stat="streak">
              {t(locale, 'practice.daysShort', { count: 0 })}
            </b>
            <span class="lbl">{t(locale, 'practice.streak')}</span>
          </div>
        </div>
      </div>

      {
        interviewBanks.length > 0 && (
          <div class="panel practice-rail-panel">
            <span class="lbl">{t(locale, 'practice.interviewBanks')}</span>
            {interviewBanks.map((bank) => {
              const track = trackBySlug.get(bank.data.track);
              return (
                <a
                  class="interview-row"
                  href={localizePath(`/practice/interview/${bank.data.track}/`, locale)}
                >
                  {track?.name[locale] ?? bank.data.track}
                  <span class="lbl">
                    {t(locale, 'practice.questions', {
                      count: formatCount(locale, bank.data.items.length, 'unit.question', 'unit.questions'),
                    })}
                  </span>
                </a>
              );
            })}
          </div>
        )
      }

      <div class="panel practice-rail-panel practice-ai">
        <span class="lbl">{t(locale, 'practice.askYourAi')}</span>
        <span class="ai-prompt">“{t(locale, 'practice.hubAiPrompt')}”</span>
        <span class="lbl">{t(locale, 'practice.aiTools')}</span>
      </div>
    </aside>
  </div>
</Base>

<style>
  .practice-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 44px;
    padding-bottom: 24px;
  }

  .practice-kicker,
  .practice-chips {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .practice-header p {
    max-width: 760px;
    margin: 0;
    color: var(--ink2);
    font-size: 17px;
    line-height: 1.6;
  }

  .practice-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: start;
    gap: 48px;
    padding-bottom: 72px;
    /* Classic scrollbars take 12px off the layout viewport, which was enough to make this page
       — and only this page — scroll sideways at 390px. Clip rather than scroll: nothing here is
       meant to be reachable by scrolling right. */
    overflow-x: clip;
  }

  .practice-main,
  .practice-rail,
  .practice-rail-panel {
    display: flex;
    flex-direction: column;
  }

  .practice-main {
    min-width: 0;
    gap: 18px;
  }

  .practice-intro {
    font-weight: 400;
  }

  /* The same `.track` material as `/tracks/`, laid out as a two-line cell so the per-type
     counts have a line of their own. */
  .practice-tracks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .practice-tracks .track {
    align-items: flex-start;
    flex-wrap: wrap;
    color: var(--ink);
    transition: border-color var(--t-state) var(--ease);
  }

  .practice-tracks .track:hover {
    color: var(--ink);
    border-color: var(--ink3);
  }

  .practice-tracks .ai-era {
    border-color: var(--acc2);
  }

  .practice-tracks .track :global(.tag) {
    flex: none;
    width: 46px;
    padding-inline: 0;
    text-align: center;
  }

  .track-name {
    flex: 1;
    min-width: 0;
    font-size: 15px;
  }

  .track-types {
    flex-basis: 100%;
    min-width: 0;
    line-height: 1.5;
  }

  .interview-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink);
    font-size: 14px;
  }

  .interview-row:hover {
    color: var(--acc);
  }

  .practice-rail {
    gap: 20px;
    min-width: 0;
  }

  .practice-rail-panel {
    gap: 12px;
    padding: 16px 18px;
  }

  .practice-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .practice-ai {
    border-color: var(--acc2);
    gap: 8px;
  }

  .practice-ai > .lbl:first-child {
    color: var(--acc2);
  }

  .ai-prompt {
    color: var(--ink);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 1023px) {
    .practice-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 767px) {
    .practice-header {
      padding-top: 28px;
      padding-bottom: 20px;
    }

    h1 {
      font-size: 32px;
    }

    .practice-header p {
      font-size: 15px;
    }

    .practice-body {
      gap: 28px;
      padding-bottom: 40px;
    }

    .practice-tracks {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
