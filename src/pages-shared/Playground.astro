---
/** The bilingual static playground shell. Its Preact island is server-rendered and hydrates idle. */
import Base from '@/layouts/Base.astro';
import PlaygroundIsland, { type PlaygroundLabels } from '@/islands/Playground';
import { t } from '@/i18n';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/playground/', locale);
const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'playground.title'),
  description: t(locale, 'playground.lead'),
  kind: 'page',
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
});

const labels: PlaygroundLabels = {
  title: t(locale, 'playground.title'),
  lead: t(locale, 'playground.lead'),
  languages: {
    python: t(locale, 'playground.lang.python'),
    js: t(locale, 'playground.lang.js'),
    ts: t(locale, 'playground.lang.ts'),
    sql: t(locale, 'playground.lang.sql'),
    html: t(locale, 'playground.lang.html'),
  },
  loadExample: t(locale, 'playground.loadExample'),
  loadingExamples: t(locale, 'playground.loadingExamples'),
  examplesFailed: t(locale, 'playground.examplesFailed'),
  openTopic: t(locale, 'playground.openTopic'),
  reset: t(locale, 'playground.reset'),
  copy: t(locale, 'playground.copy'),
  copied: t(locale, 'playground.copied'),
  copyFailed: t(locale, 'playground.copyFailed'),
  share: t(locale, 'playground.share'),
  shared: t(locale, 'playground.shared'),
  run: t(locale, 'playground.run'),
  running: t(locale, 'playground.running'),
  loadingPython: t(locale, 'playground.loadingPython'),
  loadingSql: t(locale, 'playground.loadingSql'),
  output: t(locale, 'playground.output'),
  tests: t(locale, 'playground.tests'),
  variables: t(locale, 'playground.variables'),
  outputEmpty: t(locale, 'playground.outputEmpty'),
  variablesEmpty: t(locale, 'playground.variablesEmpty'),
  variablesUnavailable: t(locale, 'playground.variablesUnavailable'),
  kataBanner: t(locale, 'playground.kata'),
  testsPending: t(locale, 'playground.testsPending'),
  testsPassed: t(locale, 'playground.testsPassed'),
  testsFailed: t(locale, 'playground.testsFailed'),
  askFix: t(locale, 'playground.askFix'),
  runsOnMachine: t(locale, 'playground.runsLocal'),
  runtimePyodide: t(locale, 'playground.runtimePyodide', { version: '314.0.6' }),
  runtimeSql: t(locale, 'playground.runtimeSql', { version: '1.14.2' }),
  runtimeIframe: t(locale, 'playground.runtimeIframe'),
  fromTopic: t(locale, 'playground.from', { topic: '{topic}' }),
  ranIn: t(locale, 'playground.ranIn', { ms: '{ms}' }),
  exit: t(locale, 'code.exit'),
  error: t(locale, 'code.error'),
  timeout: t(locale, 'code.timeout'),
  editorFailed: t(locale, 'playground.editorFailed'),
  stateRejected: t(locale, 'playground.stateRejected'),
};
---

<Base locale={locale} head={head} width="topic" currentPath={currentPath} pagefind="ignore">
  <div class="wrap playground-wrap">
    <PlaygroundIsland client:idle locale={locale} labels={labels} />
  </div>
</Base>
