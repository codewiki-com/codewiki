---
/** Localized install instructions for one track's generated coding-agent rules. */
import Breadcrumb from '@/components/Breadcrumb.astro';
import { SITE } from '@/data/site';
import type { Track } from '@/data/tracks';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { cursorFilename } from '@/lib/rules';
import { breadcrumbLd, buildHead } from '@/lib/seo';
import { localizePath, trackUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  track: Track;
  ruleCount: number;
}

const { locale, track, ruleCount } = Astro.props;
const trackName = track.name[locale];
const currentPath = localizePath(`/rules/${track.slug}/`, locale);
const trackPath = trackUrl(track.slug, locale);
const cursorFile = cursorFilename(track.slug);
// Chinese takes a full-width colon and no space before the note that follows the code path.
const installAt = `${t(locale, 'rules.installAt')}${locale === 'zh' ? '：' : ': '}`;
const repositoryRoot = `${locale === 'zh' ? '' : ' '}${t(locale, 'rules.repositoryRoot')}`;
const tools = [
  {
    name: 'Claude Code',
    file: 'CLAUDE.md',
    path: 'CLAUDE.md',
    root: true,
  },
  {
    name: 'Codex / agents',
    file: 'AGENTS.md',
    path: 'AGENTS.md',
    root: true,
  },
  {
    name: 'Cursor',
    file: cursorFile,
    path: `.cursor/rules/${cursorFile}`,
    root: false,
  },
];

const title = t(locale, 'rules.pageTitle', { track: trackName });
const head = buildHead({
  locale,
  path: currentPath,
  title,
  description: t(locale, 'rules.pageDescription', { track: trackName }),
  kind: 'page',
  trackName,
  jsonLd: [
    breadcrumbLd([
      { name: trackName, url: `${SITE.url}${trackPath}` },
      { name: title, url: `${SITE.url}${currentPath}` },
    ]),
  ],
});
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap rules-page">
    <header class="rules-head">
      <Breadcrumb
        label={title}
        items={[
          { label: trackName, href: trackPath },
          { label: t(locale, 'rules.pack', { track: trackName }), current: true, variant: 'acc2' },
        ]}
      />
      <h1>{title}</h1>
      <p>{t(locale, 'rules.pageLead', { n: ruleCount })}</p>
    </header>

    <div class="rules-tools">
      {
        tools.map((tool) => (
          <section class="panel rules-tool" data-tool={tool.name} data-install-path={tool.path}>
            <div>
              <h2>{tool.name}</h2>
              {/* One expression, so no line break between the parts renders as a space. */}
              <p>{[installAt, <code>{tool.path}</code>, tool.root && repositoryRoot]}</p>
            </div>
            <a class="btn btn-g" href={`/rules/${track.slug}/${tool.file}`} download>
              {t(locale, 'rules.download', { file: tool.file })}
            </a>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .rules-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: calc(860px + 2 * var(--gutter));
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .rules-head {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .rules-head p,
  .rules-tool p {
    margin: 0;
    color: var(--ink2);
    line-height: 1.6;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .rules-tools {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rules-tool {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 20px;
  }

  .rules-tool h2 {
    margin-bottom: 6px;
    font-size: 18px;
  }

  .rules-tool code {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .rules-tool .btn {
    flex: none;
  }

  @media (max-width: 767px) {
    .rules-page {
      gap: 28px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 32px;
    }

    .rules-tool {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }
</style>
