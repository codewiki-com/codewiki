---
/**
 * One glossary entry, shared by `/glossary/{term}/` and `/zh/glossary/{term}/`.
 *
 * The page states the term in the reading language, names it in the other one, and then says where
 * it is used: the topics a term lists are resolved in this locale, so a topic that is not written
 * (or not published) here is left out rather than linked into a dead end.
 *
 * Previous and next walk the glossary's own order — alphabetical by the English name — which is why
 * the neighbours are found here rather than passed in: both routes then agree by construction.
 */
import { getCollection, type CollectionEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { t } from '@/i18n';
import { SITE } from '@/data/site';
import { getTrack } from '@/data/tracks';
import { getTopic, isPublic } from '@/lib/content';
import { breadcrumbLd, buildHead, definedTermLd } from '@/lib/seo';
import { localizePath, topicUrl, type Locale } from '@/lib/urls';

type Term = CollectionEntry<'glossary'>;

interface Props {
  locale: Locale;
  term: Term;
}

const { locale, term } = Astro.props;
const other: Locale = locale === 'zh' ? 'en' : 'zh';

const indexPath = localizePath('/glossary/', locale);
const currentPath = localizePath(`/glossary/${term.id}/`, locale);

const name = term.data[locale];
const otherName = term.data[other];
const otherLang = other === 'zh' ? 'zh-Hans' : 'en';

/* ---- neighbours ------------------------------------------------------------------------- */

const glossary: Term[] = await getCollection('glossary');
const terms = [...glossary].sort((a, b) => a.data.en.localeCompare(b.data.en, 'en'));
const index = terms.findIndex((entry) => entry.id === term.id);
const neighbours = [
  { key: 'glossary.prevTerm' as const, entry: terms[index - 1] },
  { key: 'glossary.nextTerm' as const, entry: terms[index + 1] },
].filter((link): link is { key: 'glossary.prevTerm' | 'glossary.nextTerm'; entry: Term } =>
  Boolean(link.entry),
);

/* ---- where the term is used ------------------------------------------------------------- */

const used = (
  await Promise.all(
    term.data.topics.map(async (ref: string) => {
      const [track, slug] = ref.split('/');
      const topic = track && slug ? await getTopic(track, slug, locale) : undefined;
      // Only topics that exist and are published in this locale earn a link.
      if (!track || !slug || !topic || !isPublic(topic)) return undefined;
      return {
        title: topic.data.title,
        href: topicUrl(track, slug, locale),
        track: getTrack(track)?.name[locale],
      };
    }),
  )
).filter((topic): topic is { title: string; href: string; track?: string } => Boolean(topic));

/* ---- head ------------------------------------------------------------------------------- */

const inLanguage = locale === 'zh' ? 'zh-Hans' : 'en';
const url = `${SITE.url}${currentPath}`;
const indexUrl = `${SITE.url}${indexPath}`;

const head = buildHead({
  locale,
  path: currentPath,
  title: name,
  description: term.data.short[locale],
  kind: 'glossary',
  trackName: t(locale, 'glossary.title'),
  jsonLd: [
    definedTermLd({
      name,
      description: term.data.short[locale],
      url,
      inLanguage,
      termSetUrl: indexUrl,
    }),
    breadcrumbLd([
      { name: t(locale, 'glossary.title'), url: indexUrl },
      { name, url },
    ]),
  ],
});
---

<Base
  locale={locale}
  head={head}
  currentPath={currentPath}
  pagefind={{ filter: { lang: locale }, meta: { type: 'glossary' } }}
>
  <div class="wrap page">
    <header class="head">
      <Breadcrumb
        label={t(locale, 'glossary.title')}
        items={[
          { label: t(locale, 'glossary.title'), href: indexPath },
          { label: term.id, current: true },
        ]}
      />
      <h1>
        {name}
        {
          locale === 'zh' && (
            <span class="alt" lang={otherLang}>
              {otherName}
            </span>
          )
        }
      </h1>
      <p class="short">{term.data.short[locale]}</p>
      {
        term.data.aliases.length > 0 && (
          <p class="aliases">
            <span class="lbl">{t(locale, 'glossary.aliases')}</span>
            <span lang="en">{term.data.aliases.join(', ')}</span>
          </p>
        )
      }
    </header>

    {
      used.length > 0 && (
        <section class="used">
          <h2 class="lbl">{t(locale, 'glossary.usedIn')}</h2>
          <div class="panel used-list">
            {used.map((topic) => (
              <a class="used-row" href={topic.href}>
                <span class="used-title">{topic.title}</span>
                {topic.track && <span class="lbl">{topic.track}</span>}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <nav class="pager" aria-label={locale === 'zh' ? '相邻术语' : 'Adjacent terms'}>
      {
        neighbours.map((link) => (
          <a class="panel pager-link" href={localizePath(`/glossary/${link.entry.id}/`, locale)}>
            <span class="lbl">{t(locale, link.key)}</span>
            <span class="pager-name">{link.entry.data[locale]}</span>
          </a>
        ))
      }
    </nav>
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 40px;
    padding-bottom: 72px;
    max-width: calc(760px + 2 * var(--gutter));
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h1 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 40px;
    line-height: 1.15;
  }

  /* The same term in the other language: named, not shouted. */
  .alt {
    font-size: 20px;
    font-weight: 400;
    color: var(--ink3);
  }

  .short {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink2);
  }

  .aliases {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    font-size: 14px;
    color: var(--ink2);
  }

  .used {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h2 {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .used-list {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .used-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    font-size: 15px;
    color: var(--ink);
  }

  .used-row + .used-row {
    border-top: 1px solid var(--line);
  }

  .used-row:hover {
    background: var(--sur2);
    color: var(--acc);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    color: var(--ink);
  }

  .pager-link:hover {
    border-color: var(--acc);
    color: var(--acc);
  }

  .pager-name {
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .page {
      gap: 24px;
      padding-top: 24px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 30px;
    }

    .alt {
      font-size: 17px;
    }

    .short {
      font-size: 16px;
    }

    .pager {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
