---
/** The bilingual learning-path index. Cards are static; PathState adds local completion counts. */
import { getCollection } from 'astro:content';

import Tag from '@/components/Tag.astro';
import { TRACKS } from '@/data/tracks';
import { plural, t, type DictKey } from '@/i18n';
import PathState, { type PathStatePath, type PathStateTopic } from '@/islands/PathState';
import Base from '@/layouts/Base.astro';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';
import type { Path } from '@/schemas/path';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/paths/', locale);
const loadedPaths = (await getCollection('paths')) as { id: string; data: unknown }[];
const paths: { id: string; data: Path }[] = loadedPaths
  .map((entry: { id: string; data: unknown }) => ({ id: entry.id, data: entry.data as Path }))
  .sort((a: { id: string; data: Path }, b: { id: string; data: Path }) =>
    a.data.title[locale].localeCompare(b.data.title[locale]),
  );
const trackBySlug = new Map(TRACKS.map((track) => [track.slug, track]));
const pathCount = (
  key: 'paths.topicsCount' | 'paths.checkpointsCount',
  n: number,
  one: DictKey,
  many: DictKey,
) =>
  t(locale, key, {
    n,
    unit: locale === 'en' ? plural(n, t(locale, one), t(locale, many)) : t(locale, one),
  });

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'paths.title'),
  description: t(locale, 'paths.sub'),
  kind: 'path',
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
});

const stateLabels = {
  continue: t(locale, 'paths.continue', { title: '{title}' }),
  progress: t(locale, 'paths.progress', {
    done: '{done}',
    topics: '{topics}',
    milestone: '{milestone}',
    milestones: '{milestones}',
  }),
  milestoneMeta: t(locale, 'paths.milestoneMeta', {
    done: '{done}',
    topics: '{topics}',
    minutes: '{minutes}',
  }),
  remaining: t(locale, 'paths.remaining', { hours: '{hours}', weeks: '{weeks}' }),
  minutes: t(locale, 'paths.minutes', { count: '{count}' }),
  readPct: t(locale, 'paths.readPct', { count: '{count}', pct: '{pct}' }),
  now: t(locale, 'paths.now'),
  next: t(locale, 'paths.next'),
  done: t(locale, 'paths.done'),
  soon: t(locale, 'paths.soon'),
  shared: t(locale, 'paths.shared'),
};

const cards = paths.map((path) => {
  const total = path.data.milestones.reduce((sum, milestone) => sum + milestone.topics.length, 0);
  const href = localizePath(`/paths/${path.id}/`, locale);
  const clientPath: PathStatePath = {
    id: path.id,
    milestones: path.data.milestones.map((milestone, index) => ({
      id: milestone.id,
      title: milestone.title[locale],
      topics: milestone.topics,
      checkpoint: milestone.checkpoint,
      checkpointHref: localizePath('/practice/', locale),
      checkpointLabel: t(locale, 'paths.checkpoint', { number: index + 1 }),
    })),
  };
  const clientTopics: Record<string, PathStateTopic> = Object.fromEntries(
    path.data.milestones
      .flatMap((milestone) => milestone.topics)
      .map((id) => [id, { title: id, minutes: 10 }]),
  );
  return { path, total, href, clientPath, clientTopics };
});
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap paths-page">
    <header class="paths-head">
      <h1>{t(locale, 'paths.title')}</h1>
      <p>{t(locale, 'paths.sub')}</p>
    </header>

    {
      paths.length > 0 ? (
        <div class="paths-grid">
          {cards.map(({ path, total, href, clientPath, clientTopics }) => (
            <article class="panel path-card" data-path-root={path.id}>
              <a class="path-card-main" href={href}>
                <div class="path-card-top">
                  <h2>{path.data.title[locale]}</h2>
                  <span class="lbl" data-path-count>
                    0 / {total}
                  </span>
                </div>
                <p>{path.data.description[locale]}</p>
                <div class="path-card-meta">
                  <Tag>{pathCount('paths.topicsCount', total, 'unit.topic', 'unit.topics')}</Tag>
                  <Tag>
                    {pathCount(
                      'paths.checkpointsCount',
                      path.data.milestones.length,
                      'unit.checkpoint',
                      'unit.checkpoints',
                    )}
                  </Tag>
                  <Tag>{t(locale, 'paths.hours', { h: path.data.hours })}</Tag>
                  <Tag>
                    {t(locale, 'paths.range', {
                      from: t(locale, `difficulty.${path.data.level.from}`),
                      to: t(locale, `difficulty.${path.data.level.to}`),
                    })}
                  </Tag>
                </div>
                <div
                  class="path-card-bar"
                  data-path-bar
                  role="progressbar"
                  aria-label={path.data.title[locale]}
                  aria-valuenow="0"
                  aria-valuemin="0"
                  aria-valuemax={total}
                >
                  <span />
                </div>
              </a>
              <div class="path-card-foot">
                <div class="path-tracks">
                  {path.data.tracks.map((slug) => (
                    <span class="path-track">
                      <span class="mono">{trackBySlug.get(slug)?.glyph ?? slug}</span>
                      {trackBySlug.get(slug)?.name[locale] ?? slug}
                    </span>
                  ))}
                </div>
                <a href={href}>{t(locale, 'paths.map')} →</a>
              </div>
              <PathState
                client:idle
                locale={locale}
                mode="list"
                path={clientPath}
                topics={clientTopics}
                labels={stateLabels}
              />
            </article>
          ))}
        </div>
      ) : (
        <p class="paths-empty">{t(locale, 'paths.noPaths')}</p>
      )
    }
  </div>
</Base>

<style>
  .paths-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .paths-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .paths-head p,
  .paths-empty {
    max-width: 620px;
    margin: 0;
    color: var(--ink2);
    font-size: 16px;
    line-height: 1.6;
  }

  .paths-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .path-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    box-shadow: var(--glow);
  }

  .path-card-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    color: var(--ink);
  }

  .path-card-main:hover {
    color: var(--ink);
  }

  .path-card-top,
  .path-card-foot,
  .path-tracks,
  .path-track {
    display: flex;
    align-items: center;
  }

  .path-card-top,
  .path-card-foot {
    justify-content: space-between;
    gap: 16px;
  }

  .path-card h2 {
    font-size: 24px;
  }

  .path-card p {
    margin: 0;
    color: var(--ink2);
    font-size: 14px;
    line-height: 1.55;
  }

  .path-card-meta,
  .path-tracks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .path-card-bar {
    height: 4px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--acc-soft);
  }

  .path-card-bar span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--acc);
  }

  .path-card-foot {
    padding: 14px 22px;
    border-top: 1px solid var(--line);
    color: var(--ink2);
    font-size: 13px;
  }

  .path-track {
    gap: 6px;
  }

  .path-track .mono {
    color: var(--acc);
  }

  @media (max-width: 767px) {
    .paths-page {
      gap: 28px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 32px;
    }

    .paths-head p {
      font-size: 15px;
    }

    .paths-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .path-card-main {
      padding: 18px;
    }

    .path-card-foot {
      align-items: flex-start;
      flex-direction: column;
      padding: 14px 18px;
    }
  }
</style>
