---
/**
 * `/settings/` and `/zh/settings/` — spec §6.2. Theme, reading depth, font size and the visitor's
 * data, all of it stored in this browser and nowhere else.
 *
 * The page itself is a heading and a form; every control is client state, so the whole form is one
 * island, hydrated with `client:load` because a visitor who opened settings came here to change
 * something. It is kept out of the index: there is nothing here to find in a search engine.
 */
import Base from '@/layouts/Base.astro';
import SettingsForm from '@/islands/SettingsForm';
import { t } from '@/i18n';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/settings/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'settings.title'),
  description: t(locale, 'settings.sub'),
  kind: 'page',
  noindex: true,
});

const labels = {
  theme: t(locale, 'settings.theme'),
  themes: {
    system: t(locale, 'theme.system'),
    light: t(locale, 'theme.light'),
    dark: t(locale, 'theme.dark'),
  },
  depth: t(locale, 'settings.depth'),
  depths: {
    quick: t(locale, 'depth.quick'),
    standard: t(locale, 'depth.standard'),
    deep: t(locale, 'depth.deep'),
  },
  bilingual: t(locale, 'settings.bilingual'),
  bilingualOff: t(locale, 'bilingual.off'),
  bilingualSoon: t(locale, 'bilingual.soon'),
  soon: t(locale, 'track.soon'),
  interviewReveal: t(locale, 'settings.interviewReveal'),
  revealModes: {
    one: t(locale, 'settings.revealOne'),
    all: t(locale, 'settings.revealAll'),
  },
  cardSources: t(locale, 'settings.cardSources'),
  sourceLabels: {
    terms: t(locale, 'settings.sourceTerms'),
    quiz: t(locale, 'settings.sourceQuiz'),
    manual: t(locale, 'settings.sourceManual'),
  },
  sourceOn: t(locale, 'settings.sourceOn'),
  sourceOff: t(locale, 'settings.sourceOff'),
  practiceData: t(locale, 'settings.practiceData'),
  practiceDataHint: t(locale, 'settings.practiceDataHint'),
  resetPractice: t(locale, 'settings.resetPractice'),
  confirmResetPractice: t(locale, 'settings.confirmResetPractice'),
  fontSize: t(locale, 'settings.fontSize'),
  fonts: {
    s: t(locale, 'settings.fontS'),
    m: t(locale, 'settings.fontM'),
    l: t(locale, 'settings.fontL'),
  },
  data: t(locale, 'settings.data'),
  dataHint: t(locale, 'settings.dataHint'),
  exportLabel: t(locale, 'settings.export'),
  importLabel: t(locale, 'settings.import'),
  importMode: t(locale, 'settings.importMode'),
  merge: t(locale, 'settings.merge'),
  replace: t(locale, 'settings.replace'),
  chooseFile: t(locale, 'settings.chooseFile'),
  importFailed: t(locale, 'settings.importFailed'),
  clear: t(locale, 'settings.clear'),
  confirmClear: t(locale, 'settings.confirmClear'),
};
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap page">
    <header class="head">
      <h1>{t(locale, 'settings.title')}</h1>
      <p>{t(locale, 'settings.sub')}</p>
    </header>

    <div class="panel">
      <SettingsForm client:load labels={labels} />
    </div>
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 56px;
    padding-bottom: 72px;
    max-width: calc(var(--w) + 2 * var(--gutter));
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .head p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 620px;
  }

  @media (max-width: 767px) {
    .page {
      gap: 20px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 32px;
    }

    .head p {
      font-size: 15px;
    }
  }
</style>
