---
/** One standalone practice item, shared by the English and Chinese route trees. */
import { getEntry } from 'astro:content';
import LZString from 'lz-string';

import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import KataShell from '@/components/KataShell.astro';
import Tag from '@/components/Tag.astro';
import AskAI from '@/islands/AskAI';
import Quiz from '@/islands/Quiz';
import ReviewKata from '@/islands/ReviewKata';
import SpotBug from '@/islands/SpotBug';
import { SITE } from '@/data/site';
import { getTrack } from '@/data/tracks';
import { formatCount, t } from '@/i18n';
import { getTopic } from '@/lib/content';
import {
  listPracticeItems,
  practiceItemTitle,
  practiceUrl,
  stripQuizItem,
  typeLabelKey,
  type PracticeItem,
} from '@/lib/practice';
import { buildPrompt, deepLinks } from '@/lib/prompts';
import { reportUrl } from '@/lib/report';
import { breadcrumbLd, buildHead } from '@/lib/seo';
import { localizePath, topicUrl, trackUrl, type Locale } from '@/lib/urls';
import type { QuizItem } from '@/schemas/quiz';

interface Props {
  locale: Locale;
  catalogueItem: PracticeItem;
}

const { locale, catalogueItem } = Astro.props;
const bank = await getEntry('quizzes', catalogueItem.bank);
if (!bank) throw new Error(`Practice bank ${catalogueItem.bank} does not exist`);

const item = bank.data.items.find((candidate: QuizItem) => candidate.id === catalogueItem.item) as
  QuizItem | undefined;
if (!item) throw new Error(`Practice item ${catalogueItem.bank}#${catalogueItem.item} does not exist`);

const track = getTrack(catalogueItem.track);
if (!track) throw new Error(`Practice bank ${catalogueItem.bank} names an unknown track`);
const topic = await getTopic(catalogueItem.track, catalogueItem.slug, locale);

const trackName = track.name[locale];
const sourceTitle = topic?.data.title ?? trackName;
const sourceDescription = topic?.data.description ?? track.description[locale];
const prompt = item.prompt[locale];
const title = practiceItemTitle(item, locale);
const typeLabel = t(locale, typeLabelKey(item.type));
const currentPath = practiceUrl(catalogueItem, locale);
const url = `${SITE.url}${currentPath}`;
/** ROADMAP A4: a kata is a claim about code too, so it carries the same correction link. */
const reportHref = reportUrl({ path: currentPath, section: prompt });
const sourcePath = topic
  ? topicUrl(catalogueItem.track, catalogueItem.slug, locale)
  : trackUrl(catalogueItem.track, locale);

const catalogue = await listPracticeItems();
const bankItems = catalogue.filter((candidate) => candidate.bank === catalogueItem.bank);
const position = bankItems.findIndex((candidate) => candidate.item === catalogueItem.item);
const previous = position > 0 ? bankItems[position - 1] : undefined;
const next = position >= 0 && position < bankItems.length - 1 ? bankItems[position + 1] : undefined;

const code = 'code' in item ? item.code : undefined;
const language = 'lang' in item ? item.lang : track.name.en;
const assistantText =
  code ??
  [prompt, ...('options' in item ? item.options.map((option) => option.text[locale]) : [])].join('\n');
const playgroundUrl = code
  ? `/playground/?lang=${encodeURIComponent(language)}&code=${LZString.compressToEncodedURIComponent(code)}`
  : undefined;

const aiPrompt = buildPrompt({
  preset: 'bugs',
  locale,
  title: prompt,
  url,
  section: '',
  sectionText: assistantText,
  language,
});
const aiLinks = deepLinks(aiPrompt);

const labels = {
  copy: t(locale, 'code.copy'),
  answer: t(locale, 'practice.answer'),
  loadingAnswer: t(locale, 'practice.loadingAnswer'),
  answersUnavailable: t(locale, 'practice.answersUnavailable'),
  yourAnswer: t(locale, 'practice.yourAnswer'),
  check: t(locale, 'practice.check'),
  reveal: t(locale, 'practice.reveal'),
  reviewSteps: t(locale, 'practice.reviewSteps'),
  read: t(locale, 'practice.read'),
  mark: t(locale, 'practice.mark'),
  write: t(locale, 'practice.write'),
  compareStep: t(locale, 'practice.compareStep'),
  markLines: t(locale, 'practice.markLines'),
  writeReview: t(locale, 'practice.writeReview'),
  compare: t(locale, 'practice.compare'),
  markLine: t(locale, 'practice.markLine'),
  line: t(locale, 'practice.line'),
  commentLine: t(locale, 'practice.commentLine'),
  noLines: t(locale, 'practice.noLines'),
  you: t(locale, 'practice.you'),
  score: t(locale, 'practice.reviewScore', { score: '{score}', count: '{count}' }),
  modelRight: t(locale, 'practice.modelRight'),
  checklist: t(locale, 'practice.checklist'),
  addMissed: t(locale, 'practice.addMissed'),
  added: t(locale, 'practice.added'),
  disclaimer: t(locale, 'practice.disclaimer'),
  'kind.security': t(locale, 'practice.kind.security'),
  'kind.correctness': t(locale, 'practice.kind.correctness'),
  'kind.edge-case': t(locale, 'practice.kind.edge-case'),
  'kind.readability': t(locale, 'practice.kind.readability'),
  'kind.performance': t(locale, 'practice.kind.performance'),
};

const aiLabels = {
  open: t(locale, 'practice.askAi'),
  title: t(locale, 'ai.title'),
  presets: {
    explain: t(locale, 'ai.explain'),
    quiz: t(locale, 'ai.quiz'),
    bugs: t(locale, 'ai.bugs'),
    compare: t(locale, 'ai.compare'),
    apply: t(locale, 'ai.apply'),
    feynman: t(locale, 'ai.feynman'),
    'explain-code': t(locale, 'ask.explainCode'),
    port: t(locale, 'ask.port'),
    tests: t(locale, 'ask.tests'),
    'check-pitfall': t(locale, 'ask.checkPitfall'),
  },
  claude: t(locale, 'ai.openClaude'),
  chatgpt: t(locale, 'ai.openChatGPT'),
  copy: t(locale, 'ai.copy'),
  copied: t(locale, 'ai.copied'),
  copyFailed: t(locale, 'ai.copyFailed'),
  close: t(locale, 'ai.close'),
  scopePage: t(locale, 'ai.scopePage'),
  scopeSection: t(locale, 'ai.scopeSection'),
};

const visualTrail = [
  { label: t(locale, 'practice.title') },
  { label: typeLabel, variant: item.type === 'review' ? ('acc2' as const) : ('default' as const) },
  { label: trackName, href: trackUrl(catalogueItem.track, locale) },
  { label: sourceTitle, current: true },
];

const head = buildHead({
  locale,
  path: currentPath,
  title,
  description: sourceDescription,
  kind: 'practice',
  // Until practice cards get their own OG pass, use the source topic's card where one exists;
  // path checkpoint banks have no topic of their own and fall back to the site card.
  ogImagePath: topic
    ? `/og/${locale === 'zh' ? 'zh/' : ''}${catalogueItem.track}/${catalogueItem.slug}.png`
    : `/og/${locale === 'zh' ? 'zh/' : ''}home.png`,
  jsonLd: [
    breadcrumbLd([
      { name: t(locale, 'practice.title'), url: `${SITE.url}${localizePath('/practice/', locale)}` },
      {
        name: typeLabel,
        url: `${SITE.url}${localizePath(`/practice/${item.type}/`, locale)}`,
      },
      { name: trackName, url: `${SITE.url}${trackUrl(catalogueItem.track, locale)}` },
      { name: sourceTitle, url },
    ]),
  ],
});

const resultLabel =
  item.type === 'review' ? t(locale, 'practice.yourReview') : t(locale, 'practice.yourResult');
const publicItem = stripQuizItem(item);
---

<Base
  locale={locale}
  head={head}
  currentPath={currentPath}
  pagefind={{ filter: { lang: locale }, meta: { type: 'practice', track: trackName } }}
>
  <div class="wrap kata-page">
    <header class="kata-head">
      <Breadcrumb label={t(locale, 'nav.practice')} items={visualTrail} />
      <h1>{title}</h1>
      <a class="source" href={sourcePath}>{t(locale, 'practice.from', { title: sourceTitle })}</a>
      <div class="chips">
        {topic && <Tag>{topic.data.verified.version}</Tag>}
        <Tag>{t(locale, `difficulty.${item.difficulty}`)}</Tag>
        <Tag>
          {
            t(locale, 'practice.minutes', {
              count: formatCount(locale, catalogueItem.minutes, 'unit.minute', 'unit.minutes'),
            })
          }
        </Tag>
        {
          (item.type === 'spotbug' || item.type === 'review') && (
            <Tag variant="warn">
              {t(locale, 'practice.issues', {
                count: formatCount(locale, item.issues.length, 'unit.issue', 'unit.issues'),
              })}
            </Tag>
          )
        }
      </div>
    </header>

    <div class="kata-grid">
      <div class="kata-column">
        <div class="kata-main" id="article">
          <KataShell bank={bank.id} item={publicItem} locale={locale} labels={labels}>
            {
              (item.type === 'mcq' || item.type === 'predict' || item.type === 'fill') && (
                <Quiz
                  client:visible
                  bank={bank.id}
                  item={publicItem}
                  locale={locale}
                  labels={labels}
                  loadAnswers
                />
              )
            }
            {
              item.type === 'spotbug' && (
                <SpotBug
                  client:visible
                  bank={bank.id}
                  item={publicItem}
                  locale={locale}
                  labels={labels}
                  loadAnswers
                />
              )
            }
            {
              item.type === 'review' && (
                <ReviewKata
                  client:visible
                  bank={bank.id}
                  item={publicItem}
                  locale={locale}
                  labels={labels}
                  loadAnswers
                />
              )
            }
          </KataShell>
        </div>

        <div class="kata-actions">
          {
            code && (
              <>
                <button
                  type="button"
                  class="act"
                  data-copy-text={code}
                  data-rest-label={t(locale, 'practice.copyCode')}
                >
                  {t(locale, 'practice.copyCode')}
                </button>
                <a class="act" href={playgroundUrl}>
                  {t(locale, 'practice.openPlayground')}
                </a>
              </>
            )
          }
          <AskAI
            client:visible
            labels={aiLabels}
            context={{ locale, title: prompt, url, language, sectionText: assistantText }}
            preset="bugs"
          />
          <a class="lbl report" href={reportHref} target="_blank" rel="noopener">
            {t(locale, 'report.error')}
          </a>
        </div>

        {
          (previous || next) && (
            <nav class="kata-nav" aria-label={t(locale, 'practice.kataNavigation')}>
              {previous && (
                <a class="item" href={practiceUrl(previous, locale)}>
                  <span class="lbl">{t(locale, 'practice.previous')}</span>
                  <span class="kata-nav-line">
                    <strong>{practiceItemTitle(previous, locale)}</strong>
                    <Tag variant={previous.type === 'review' ? 'acc2' : 'default'}>
                      {t(locale, typeLabelKey(previous.type))}
                    </Tag>
                  </span>
                </a>
              )}
              {next && (
                <a class="item next" href={practiceUrl(next, locale)}>
                  <span class="lbl">{t(locale, 'practice.next')}</span>
                  <span class="kata-nav-line">
                    <strong>{practiceItemTitle(next, locale)}</strong>
                    <Tag variant={next.type === 'review' ? 'acc2' : 'default'}>
                      {t(locale, typeLabelKey(next.type))}
                    </Tag>
                  </span>
                </a>
              )}
            </nav>
          )
        }
      </div>

      <aside class="kata-rail">
        <div class="panel result-card" data-result-mirror>
          <span class="lbl">{resultLabel}</span>
          <p class="result-empty" data-result-empty>{t(locale, 'practice.notAnswered')}</p>
          <div class="score-row" data-score-row hidden>
            <svg
              class="ring"
              viewBox="0 0 64 64"
              role="img"
              aria-label={t(locale, 'practice.notAnswered')}
              data-score-ring
            >
              <circle class="ring-track" cx="32" cy="32" r="26"></circle>
              <circle class="ring-score" cx="32" cy="32" r="26"></circle>
              <text x="32" y="37" text-anchor="middle" data-score-fraction></text>
            </svg>
            <strong data-score-summary></strong>
          </div>
        </div>
        <div data-review-details></div>

        <div class="panel ai-card">
          <span class="lbl ai-label">{t(locale, 'ai.title')}</span>
          <p>{t(locale, 'practice.aiCard')}</p>
          <div class="ai-actions">
            <a class="act" href={aiLinks.claude} target="_blank" rel="noopener">
              {t(locale, 'ai.openClaude')}
            </a>
            <a class="act" href={aiLinks.chatgpt} target="_blank" rel="noopener">
              {t(locale, 'ai.openChatGPT')}
            </a>
            <button
              type="button"
              class="act"
              data-copy-text={aiPrompt}
              data-rest-label={t(locale, 'ai.copy')}
            >
              {t(locale, 'ai.copy')}
            </button>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script
    is:inline
    define:vars={{
      copiedLabel: t(locale, 'code.copied'),
      copyFailedLabel: t(locale, 'code.copyFailed'),
      scoreLabel: t(locale, 'practice.score'),
      reviewItem: item.type === 'review',
    }}
  >
    for (const button of document.querySelectorAll('[data-copy-text]')) {
      button.addEventListener('click', () => {
        const restore = () => {
          button.textContent = button.dataset.restLabel || '';
        };
        navigator.clipboard
          .writeText(button.dataset.copyText || '')
          .then(() => {
            button.textContent = copiedLabel;
            setTimeout(restore, 1500);
          })
          .catch(() => {
            button.textContent = copyFailedLabel;
            setTimeout(restore, 1500);
          });
      });
    }

    const root = document.querySelector('[data-quiz]');
    const empty = document.querySelector('[data-result-empty]');
    const scoreRow = document.querySelector('[data-score-row]');
    const fraction = document.querySelector('[data-score-fraction]');
    const summary = document.querySelector('[data-score-summary]');
    const scoreArc = document.querySelector('[data-score-ring] .ring-score');
    const details = document.querySelector('[data-review-details]');

    const mirrorResult = () => {
      if (!root || root.dataset.state !== 'answered') return;
      const source = root.querySelector(reviewItem ? '[data-review-compare]' : '[data-result]');
      const score = Number(source && source.dataset.score);
      const total = Number(source && source.dataset.total);
      if (!Number.isFinite(score) || !Number.isFinite(total) || total <= 0) return;

      if (empty) empty.hidden = true;
      if (scoreRow) scoreRow.hidden = false;
      if (fraction) fraction.textContent = `${score}/${total}`;
      const summaryText = scoreLabel.replace('{score}', String(score)).replace('{total}', String(total));
      if (summary) summary.textContent = summaryText;
      const ring = document.querySelector('[data-score-ring]');
      if (ring) ring.setAttribute('aria-label', summaryText);
      if (scoreArc) {
        const circumference = 2 * Math.PI * 26;
        scoreArc.setAttribute('stroke-dasharray', String(circumference));
        scoreArc.setAttribute('stroke-dashoffset', String(circumference * (1 - score / total)));
      }

      if (reviewItem && details && source) {
        const panels = source.querySelectorAll(':scope > .review-panel');
        details.replaceChildren(...[...panels].map((panel) => panel.cloneNode(true)));
      }
    };

    if (root)
      new MutationObserver(mirrorResult).observe(root, { attributes: true, childList: true, subtree: true });
    mirrorResult();
  </script>
</Base>

<style>
  .kata-page {
    padding-top: 36px;
    padding-bottom: 72px;
  }

  .kata-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 22px;
  }

  h1 {
    max-width: 920px;
    font-size: 36px;
    line-height: 1.15;
  }

  .source {
    align-self: flex-start;
    font-size: 14px;
  }

  .chips,
  a.report:hover {
    color: var(--acc);
  }

  .kata-actions,
  .ai-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .kata-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    align-items: start;
    gap: 40px;
  }

  .kata-column,
  .kata-rail,
  [data-review-details] {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .kata-main :global(.q-prompt) {
    display: none;
  }

  /* Review comparison furniture lives in the rail; its explanation and flashcard action stay in
     the main flow beside the annotated code. */
  .kata-main :global(.review-compare > .review-score),
  .kata-main :global(.review-compare > .review-panel) {
    display: none;
  }

  .kata-actions {
    min-height: 36px;
  }

  .kata-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-8);
    background: var(--sur);
    color: var(--ink);
  }

  .item:hover {
    border-color: var(--acc);
    color: var(--acc);
  }

  .kata-nav-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
  }

  .item strong {
    min-width: 0;
    font-size: 14px;
    line-height: 1.45;
  }

  .item.next {
    text-align: right;
  }

  .kata-rail {
    position: sticky;
    top: 20px;
  }

  .result-card,
  .ai-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 18px;
  }

  .result-card p,
  .ai-card p {
    margin: 0;
    color: var(--ink2);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .score-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .score-row strong {
    font-size: 15px;
  }

  [data-review-details] :global(.review-panel) {
    gap: 8px;
  }

  .ai-card {
    border-color: var(--acc2);
  }

  .ai-label {
    color: var(--acc2);
  }

  @media (max-width: 900px) {
    .kata-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .kata-rail {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .kata-page {
      padding-top: 20px;
      padding-bottom: 48px;
    }

    h1 {
      font-size: 30px;
    }

    .kata-nav {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
