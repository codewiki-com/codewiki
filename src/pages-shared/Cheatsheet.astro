---
/** A localized printable cheatsheet, shared by the English and Chinese routes. */
import '@/styles/print.css';

import { getCollection, render, type CollectionEntry } from 'astro:content';

import AskAI from '@/islands/AskAI';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Tag from '@/components/Tag.astro';
import { mdxComponents } from '@/components/mdx';
import { P2_RULES, SITE } from '@/data/site';
import { getTrack } from '@/data/tracks';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { cheatsheetMeta, getCheatsheet, isPublic, type Cheatsheet } from '@/lib/content';
import { breadcrumbLd, buildHead } from '@/lib/seo';
import { localizePath, trackUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  sheet: Cheatsheet;
}

const { locale, sheet } = Astro.props;
const { slug } = cheatsheetMeta(sheet);
const currentPath = localizePath(`/cheatsheets/${slug}/`, locale);
const url = `${SITE.url}${currentPath}`;
const markdownUrl = `${currentPath.replace(/\/$/, '')}.md`;
const track = sheet.data.track ? getTrack(sheet.data.track) : undefined;
const trackName = track?.name[locale] ?? sheet.data.track ?? sheet.data.title;
const verified = sheet.data.verified.date.toISOString().slice(0, 10);
const { Content } = await render(sheet);

const glossary: CollectionEntry<'glossary'>[] = await getCollection('glossary');
const glossaryById = new Map(glossary.map((term) => [term.id, term]));
const termIds = sheet.data.terms as string[];
const terms: CollectionEntry<'glossary'>[] = termIds
  .map((id: string) => glossaryById.get(id))
  .filter((term: CollectionEntry<'glossary'> | undefined): term is CollectionEntry<'glossary'> =>
    Boolean(term),
  );

const interviews: CollectionEntry<'interview'>[] = await getCollection('interview');
const hasInterview = Boolean(track && interviews.some((bank) => bank.data.track === track.slug));

const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const otherSheet = await getCheatsheet(slug, otherLocale);
const otherHref = localizePath(`/cheatsheets/${slug}/`, otherLocale);

const aiLabels = {
  open: t(locale, 'cheatsheets.askRow'),
  title: t(locale, 'ai.title'),
  presets: {
    explain: t(locale, 'ai.explain'),
    quiz: t(locale, 'ai.quiz'),
    bugs: t(locale, 'ai.bugs'),
    compare: t(locale, 'ai.compare'),
    apply: t(locale, 'ai.apply'),
    feynman: t(locale, 'ai.feynman'),
  },
  claude: t(locale, 'ai.openClaude'),
  chatgpt: t(locale, 'ai.openChatGPT'),
  copy: t(locale, 'ai.copy'),
  copied: t(locale, 'ai.copied'),
  copyFailed: t(locale, 'ai.copyFailed'),
  close: t(locale, 'ai.close'),
  scopePage: t(locale, 'ai.scopePage'),
  scopeSection: t(locale, 'ai.scopeSection'),
};

const indexPath = localizePath('/cheatsheets/', locale);
const head = buildHead({
  locale,
  path: currentPath,
  title: sheet.data.title,
  description: sheet.data.description,
  kind: 'page',
  trackName,
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
  jsonLd: [
    breadcrumbLd([
      { name: t(locale, 'cheatsheets.title'), url: `${SITE.url}${indexPath}` },
      { name: sheet.data.title, url },
    ]),
  ],
});
---

<Base
  locale={locale}
  head={head}
  currentPath={currentPath}
  pagefind={{
    filter: { lang: locale, ...(track && { track: trackName }) },
    meta: { type: 'cheatsheet', ...(track && { track: trackName }), glyph: track?.glyph ?? 'ref' },
  }}
>
  <div class="wrap cheatsheet-page">
    <header class="cheatsheet-head">
      <div class="cheatsheet-intro">
        <Breadcrumb
          label={t(locale, 'cheatsheets.title')}
          items={[
            { label: t(locale, 'cheatsheets.title'), href: indexPath },
            { label: slug, current: true },
          ]}
        />
        <h1>{sheet.data.title}</h1>
        <p>{sheet.data.description}</p>
        <div class="cheatsheet-chips">
          <Tag>{sheet.data.verified.version}</Tag>
          <Tag>{t(locale, 'cheatsheets.verified', { date: verified })}</Tag>
          <Tag>{t(locale, 'cheatsheets.onePage')}</Tag>
          {
            otherSheet && isPublic(otherSheet) && (
              <a class="locale-chip" href={otherHref} lang={otherLocale === 'zh' ? 'zh-Hans' : 'en'}>
                <Tag>{t(locale, 'footer.otherLocale')}</Tag>
              </a>
            )
          }
        </div>
      </div>

      <div class="cheatsheet-actions" data-cheatsheet-actions>
        <button type="button" class="act" data-cheatsheet-print>{t(locale, 'cheatsheets.print')}</button>
        <button
          type="button"
          class="act"
          data-cheatsheet-copy
          data-md={markdownUrl}
          data-label={t(locale, 'cheatsheets.copyMd')}
          data-copied={t(locale, 'code.copied')}
          data-failed={t(locale, 'code.copyFailed')}
        >
          {t(locale, 'cheatsheets.copyMd')}
        </button>
        <a class="act" href={markdownUrl} download>{t(locale, 'cheatsheets.downloadMd')}</a>
        <AskAI
          client:idle
          preset="explain"
          labels={aiLabels}
          context={{
            locale,
            title: sheet.data.title,
            url,
            language: track?.name.en ?? sheet.data.title,
            sectionText: sheet.data.description,
          }}
        />
      </div>
    </header>

    <div class="cheatsheet-grid" data-cheatsheet-grid>
      <Content components={mdxComponents} />
      {
        terms.length > 0 && (
          <section class="panel cheat vocab-panel">
            <h3>{t(locale, 'cheatsheets.vocab')}</h3>
            <div class="vocab">
              {terms.map((term) => (
                <a href={localizePath(`/glossary/${term.id}/`, locale)}>
                  <span>{term.data.en}</span>
                  <span class="zh" lang="zh-Hans">
                    {term.data.zh}
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <div class:list={['cheatsheet-foot', P2_RULES && track && 'has-rules']}>
      {
        P2_RULES && track && (
          <section class="panel rules-card" data-rules-card>
            <div class="rules-copy">
              <span class="lbl">rules pack</span>
              <h2>{trackName} rules for your coding agent</h2>
              <p>Download the track's pitfalls and best practices in the format your coding agent reads.</p>
            </div>
            <div class="rules-actions">
              <a class="btn btn-g" href={`/rules/${track.slug}/CLAUDE.md`} download>
                CLAUDE.md
              </a>
              <a class="btn btn-g" href={`/rules/${track.slug}/AGENTS.md`} download>
                AGENTS.md
              </a>
              <a class="btn btn-g" href={`/rules/${track.slug}/cursor.mdc`} download>
                cursor.mdc
              </a>
            </div>
          </section>
        )
      }

      {
        track && (
          <section class="panel related-card">
            <span class="lbl">{t(locale, 'cheatsheets.alsoFor', { track: trackName })}</span>
            <a href={trackUrl(track.slug, locale)}>
              <span>{track.name[locale]}</span>
              <span class="lbl">{t(locale, 'track.also')}</span>
            </a>
            {hasInterview && (
              <a href={localizePath(`/practice/interview/${track.slug}/`, locale)}>
                <span>{t(locale, 'track.alsoInterview', { track: trackName })}</span>
                <span class="lbl">{t(locale, 'practice.interviewBanks')}</span>
              </a>
            )}
            <a href={localizePath('/glossary/', locale)}>
              <span>{t(locale, 'track.alsoGlossary', { track: trackName })}</span>
              <span class="lbl">{t(locale, 'glossary.open')}</span>
            </a>
          </section>
        )
      }
    </div>
  </div>
</Base>

<style>
  .cheatsheet-page {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 36px;
    padding-bottom: 72px;
  }

  .cheatsheet-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 6px;
  }

  .cheatsheet-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  h1 {
    font-size: 40px;
    line-height: 1.1;
  }

  .cheatsheet-intro > p {
    max-width: 620px;
    margin: 0;
    color: var(--ink2);
    font-size: 16px;
    line-height: 1.6;
  }

  .cheatsheet-chips,
  .cheatsheet-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cheatsheet-actions {
    justify-content: flex-end;
  }

  .cheatsheet-actions .act {
    white-space: nowrap;
  }

  .cheatsheet-actions a.act:hover,
  .locale-chip:hover {
    color: var(--ink);
  }

  .locale-chip {
    display: inline-flex;
    color: inherit;
  }

  .cheatsheet-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  /* `remark-depth` wraps top-level MDX in a Standard block. It has no visual meaning here, so its
     Sheet children participate directly in this grid. */
  .cheatsheet-grid > :global(div[data-depth='standard']) {
    display: contents;
  }

  .vocab-panel {
    border-color: var(--acc2);
  }

  .vocab-panel h3 {
    color: var(--acc2);
  }

  .cheatsheet-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .cheatsheet-foot.has-rules {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .rules-card,
  .related-card {
    padding: 16px 18px;
  }

  .rules-card {
    display: flex;
    align-items: center;
    gap: 16px;
    border-color: var(--acc2);
  }

  .rules-copy,
  .rules-actions,
  .related-card {
    display: flex;
    flex-direction: column;
  }

  .rules-copy {
    flex: 1;
    gap: 4px;
  }

  .rules-copy .lbl {
    color: var(--acc2);
  }

  .rules-copy h2 {
    font-size: 15px;
  }

  .rules-copy p {
    margin: 0;
    color: var(--ink2);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .rules-actions {
    gap: 6px;
  }

  .rules-actions .btn {
    height: 32px;
    justify-content: center;
    padding-inline: 10px;
    font-size: 12px;
  }

  .related-card {
    gap: 8px;
  }

  .related-card > a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink);
    font-size: 14px;
  }

  .related-card > a:hover > span:first-child {
    color: var(--acc);
  }

  @media (max-width: 1023px) {
    .cheatsheet-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .cheatsheet-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 767px) {
    .cheatsheet-page {
      gap: 14px;
      padding-top: 24px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 32px;
    }

    .cheatsheet-grid,
    .cheatsheet-foot.has-rules {
      grid-template-columns: minmax(0, 1fr);
    }

    .rules-card {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-cheatsheet-print]')) {
    button.addEventListener('click', () => window.print(), { once: false });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-cheatsheet-copy]')) {
    button.addEventListener('click', async () => {
      const original = button.dataset.label ?? button.textContent ?? '';
      try {
        const response = await fetch(button.dataset.md ?? '');
        if (!response.ok) throw new Error(`Markdown request failed: ${response.status}`);
        await navigator.clipboard.writeText(await response.text());
        button.textContent = button.dataset.copied ?? original;
      } catch {
        button.textContent = button.dataset.failed ?? original;
      }
      window.setTimeout(() => {
        button.textContent = original;
      }, 1500);
    });
  }
</script>
