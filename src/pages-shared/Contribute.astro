---
/** `/contribute/` and `/zh/contribute/`: correction workflow and repository licences. */
import Breadcrumb from '@/components/Breadcrumb.astro';
import { SITE } from '@/data/site';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { breadcrumbLd, buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const homePath = localizePath('/', locale);
const currentPath = localizePath('/contribute/', locale);
const repositoryFile = (file: string) => `${SITE.repo}/blob/main/${file}`;
const issueUrl = `${SITE.repo}/issues/new?template=content-error.yml`;

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'contribute.title'),
  description: t(locale, 'contribute.description'),
  kind: 'page',
  jsonLd: [
    breadcrumbLd([
      { name: SITE.name, url: `${SITE.url}${homePath}` },
      { name: t(locale, 'contribute.title'), url: `${SITE.url}${currentPath}` },
    ]),
  ],
});
---

<Base locale={locale} head={head} currentPath={currentPath}>
  <div class="wrap contribute-page">
    <header class="contribute-head">
      <Breadcrumb
        label={t(locale, 'contribute.title')}
        items={[
          { label: SITE.name, href: homePath },
          { label: t(locale, 'footer.contribute'), current: true },
        ]}
      />
      <h1>{t(locale, 'contribute.title')}</h1>
      <p class="lead">{t(locale, 'contribute.lead')}</p>
      <p>
        <a class="btn" href={repositoryFile('CONTRIBUTING.md')} rel="noopener external">
          {t(locale, 'contribute.guide')}
        </a>
      </p>
    </header>

    <article class="prose contribute-copy">
      <section>
        <h2>{t(locale, 'contribute.report.title')}</h2>
        <p>{t(locale, 'contribute.report.body')}</p>
        <p>
          <a href={issueUrl} rel="noopener external">{t(locale, 'contribute.report.link')}</a>
        </p>
      </section>

      <section>
        <h2>{t(locale, 'contribute.licences.title')}</h2>
        <p>{t(locale, 'contribute.licences.body')}</p>
        <ul>
          <li>
            <a href={repositoryFile('LICENSE')} rel="noopener external">
              {t(locale, 'contribute.licences.code')}
            </a>
          </li>
          <li>
            <a href={repositoryFile('LICENSE-CONTENT.md')} rel="noopener external">
              {t(locale, 'contribute.licences.content')}
            </a>
          </li>
        </ul>
      </section>
    </article>
  </div>
</Base>

<style>
  .contribute-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: calc(760px + 2 * var(--gutter));
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .contribute-head,
  .contribute-copy,
  .contribute-copy section {
    display: flex;
    flex-direction: column;
  }

  .contribute-head {
    gap: 20px;
  }

  .contribute-copy {
    gap: 32px;
  }

  .contribute-copy section {
    gap: 10px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .lead {
    max-width: 680px;
    color: var(--ink2);
  }

  .contribute-copy h2 {
    margin-top: 0;
  }

  @media (max-width: 767px) {
    .contribute-page {
      gap: 28px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    .contribute-head {
      gap: 16px;
    }

    h1 {
      font-size: 32px;
    }

    .contribute-copy {
      gap: 28px;
    }
  }
</style>
