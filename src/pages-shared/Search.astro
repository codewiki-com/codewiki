---
/**
 * `/search/` — the palette's fallback, shared by both locales.
 *
 * The form is plain HTML: without JavaScript it reloads this page with `?q=`, which is also the
 * URL the palette's "no index" message points at. With JavaScript, the same `Palette` island the
 * layout mounts renders the results inline, reading the query from that form and from `?q=`.
 *
 * The page is prerendered, so `?q=` is not known here — the island fills the field from the URL.
 *
 * It is `data-pagefind-ignore`d: a search page has no business appearing in its own results.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Palette from '@/islands/Palette';
import { t } from '@/i18n';
import { buildHead } from '@/lib/seo';
import { paletteLabels } from '@/lib/search-labels';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/search/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'search.title'),
  description: t(locale, 'search.sub'),
  kind: 'page',
  noindex: true,
});
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap search-page">
    <header class="search-head">
      <h1>{t(locale, 'search.title')}</h1>
      <p>{t(locale, 'search.sub')}</p>
    </header>

    <form class="search-form" role="search" method="get" action={currentPath} data-search-form>
      <div class="search-field">
        <Icon name="search" size={18} />
        <input
          type="text"
          name="q"
          aria-label={t(locale, 'nav.search')}
          placeholder={t(locale, 'search.placeholder')}
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <button type="submit" class="btn btn-p">{t(locale, 'nav.search')}</button>
    </form>

    <Palette client:idle mode="page" locale={locale} searchUrl={currentPath} labels={paletteLabels(locale)} />
  </div>
</Base>

<style>
  .search-page {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 48px;
    padding-bottom: 72px;
  }

  .search-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .search-head h1 {
    font-size: 34px;
  }

  .search-head p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 620px;
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    max-width: 620px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    background: var(--sur);
    color: var(--ink3);
  }

  .search-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
  }

  .search-field input:focus {
    outline: none;
  }

  .search-field:focus-within {
    border-color: var(--acc);
  }

  @media (max-width: 767px) {
    .search-page {
      padding-top: 28px;
      padding-bottom: 40px;
    }

    .search-head h1 {
      font-size: 26px;
    }
  }
</style>
