---
/** The bilingual shell for the browser-local spaced-repetition reviewer. */
import Base from '@/layouts/Base.astro';
import Flashcards, { type FlashcardsLabels } from '@/islands/Flashcards';
import { getTrack, TRACKS } from '@/data/tracks';
import { formatCount, t } from '@/i18n';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/practice/flashcards/', locale);
const practiceUrl = localizePath('/practice/', locale);
const pythonUrl = localizePath('/python/', locale);
const settingsUrl = localizePath('/settings/', locale);
const python = getTrack('python');

const labels: FlashcardsLabels = {
  practice: t(locale, 'practice.title'),
  title: t(locale, 'flashcards.title'),
  dueToday: t(locale, 'flashcards.dueToday', { n: '{n}' }),
  done: t(locale, 'flashcards.done', { n: '{n}' }),
  streak: t(locale, 'flashcards.streak', { count: '{count}' }),
  filters: {
    due: t(locale, 'flashcards.filterDue'),
    all: t(locale, 'flashcards.filterAll'),
    terms: t(locale, 'flashcards.filterTerms'),
    quiz: t(locale, 'flashcards.filterQuiz'),
  },
  shuffle: t(locale, 'flashcards.shuffle'),
  front: t(locale, 'flashcards.front'),
  back: t(locale, 'flashcards.back'),
  cardCount: t(locale, 'flashcards.cardCount', { i: '{i}', n: '{n}' }),
  readSection: t(locale, 'flashcards.readSection'),
  glossaryEntry: t(locale, 'flashcards.glossaryEntry'),
  ratings: {
    again: t(locale, 'flashcards.again'),
    hard: t(locale, 'flashcards.hard'),
    good: t(locale, 'flashcards.good'),
    easy: t(locale, 'flashcards.easy'),
  },
  days: t(locale, 'flashcards.days', { count: '{count}' }),
  deck: t(locale, 'flashcards.deck'),
  cards: t(locale, 'flashcards.cards'),
  terms: t(locale, 'flashcards.terms'),
  units: {
    card: t(locale, 'unit.card'),
    cards: t(locale, 'unit.cards'),
    term: t(locale, 'unit.term'),
    terms: t(locale, 'unit.terms'),
  },
  missedQuiz: t(locale, 'flashcards.missedQuiz'),
  nextSeven: t(locale, 'flashcards.nextSeven'),
  sources: t(locale, 'flashcards.sources'),
  sourceLabels: {
    terms: t(locale, 'flashcards.sourceTerms'),
    quiz: t(locale, 'flashcards.sourceQuiz'),
    manual: t(locale, 'flashcards.sourceManual'),
  },
  exportDeck: t(locale, 'flashcards.export'),
  importDeck: t(locale, 'flashcards.import'),
  empty: t(locale, 'flashcards.empty'),
  emptyToday: t(locale, 'flashcards.emptyToday'),
  loading: t(locale, 'flashcards.loading'),
  loadFailed: t(locale, 'flashcards.loadFailed'),
  flip: t(locale, 'flashcards.flip'),
  cueTerm: t(locale, 'flashcards.cueTerm'),
  cueQuiz: t(locale, 'flashcards.cueQuiz'),
  flashcardsTag: t(locale, 'practice.flashcards'),
  trackNames: Object.fromEntries(TRACKS.map((track) => [track.slug, track.name[locale]])),
  on: t(locale, 'flashcards.on'),
  off: t(locale, 'flashcards.off'),
  sourceNote: t(locale, 'flashcards.sourceNote'),
  askYourAi: t(locale, 'flashcards.askYourAi'),
  aiPrompt: t(locale, 'flashcards.aiPrompt'),
  aiTools: t(locale, 'practice.aiTools'),
  shortcuts: t(locale, 'flashcards.shortcuts'),
  practiceLink: t(locale, 'practice.title'),
  pythonLink: python?.name[locale] ?? 'Python',
};

const head = buildHead({
  locale,
  path: currentPath,
  title: labels.title,
  description: labels.empty,
  kind: 'practice',
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
});
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <Flashcards
    client:only="preact"
    locale={locale}
    labels={labels}
    practiceUrl={practiceUrl}
    pythonUrl={pythonUrl}
    settingsUrl={settingsUrl}
  >
    <div slot="fallback" class="wrap flashcards-page">
      <header class="flashcards-head">
        <div class="flashcards-heading">
          <div class="flashcards-kicker">
            <a class="tag" href={practiceUrl}>{labels.practice}</a>
            <span class="lbl">/</span>
            <span class="tag acc">{labels.flashcardsTag}</span>
          </div>
          <h1>{labels.title}</h1>
          <span class="lbl flashcards-summary">
            {t(locale, 'flashcards.dueToday', { n: 0 })} · {t(locale, 'flashcards.done', { n: 0 })} · {
              t(locale, 'flashcards.streak', {
                count: formatCount(locale, 0, 'unit.day', 'unit.days'),
              })
            }
          </span>
        </div>
        {
          /* The island renders a filter segment and a shuffle button here. Reserving their box
             before hydration is what keeps the page from jumping: without it the deck below moved
             down by a control row on every load, a stable CLS of 0.096. Inert and hidden from the
             accessibility tree — the real controls arrive with the island that operates them. */
        }
        <div class="flashcards-controls" aria-hidden="true">
          <div class="seg">
            {
              (['due', 'all', 'terms', 'quiz'] as const).map((value) => (
                <span class:list={[value === 'due' && 'on']}>{labels.filters[value]}</span>
              ))
            }
          </div>
          <span class="act">{labels.shuffle}</span>
        </div>
      </header>
      <div class="flashcards-body">
        <section class="flashcards-main">
          <div class="panel flashcards-empty" data-flashcards-empty>
            <p>{labels.empty}</p>
            <div class="flashcards-empty-links">
              <a class="btn btn-g" href={practiceUrl}>{labels.practiceLink}</a>
              <a class="btn btn-g" href={pythonUrl}>{labels.pythonLink}</a>
            </div>
          </div>
        </section>
        {
          /* The rail an empty deck hydrates into, rendered statically at the same size. The
             island replaces this whole subtree, and reserving its box is what keeps the footer
             still: without it the page grew by a rail on every load, a stable CLS of 0.096. */
        }
        <aside class="flashcards-rail">
          <div class="panel flashcards-rail-panel">
            <span class="lbl">{labels.deck}</span>
            <div class="flashcards-stats">
              <div class="stat">
                <b>0</b>
                <span class="lbl">{labels.units.cards}</span>
              </div>
              <div class="stat">
                <b>0</b>
                <span class="lbl">{labels.units.terms}</span>
              </div>
              <div class="stat">
                <b>0</b>
                <span class="lbl">{labels.missedQuiz}</span>
              </div>
            </div>
            <span class="lbl">{labels.nextSeven}</span>
            <div class="histogram" aria-label={labels.nextSeven}>
              {
                [0, 1, 2, 3, 4, 5, 6].map((day) => (
                  <span class:list={[day === 0 && 'today']} style="height:3%" title="0" />
                ))
              }
            </div>
            <div class="histogram-counts lbl" aria-hidden="true">
              {[0, 1, 2, 3, 4, 5, 6].map(() => <span>0</span>)}
            </div>
          </div>

          <div class="panel flashcards-rail-panel flashcards-sources">
            <span class="lbl">{labels.sources}</span>
            {
              (['terms', 'quiz', 'manual'] as const).map((source) => (
                <span class="flashcard-source">
                  <span>{labels.sourceLabels[source]}</span>
                  <span class="seg" aria-hidden="true">
                    <span class="on">{labels.on}</span>
                    <span>{labels.off}</span>
                  </span>
                </span>
              ))
            }
            <p>{labels.sourceNote}</p>
          </div>

          <div class="flashcards-data-actions">
            <a class="btn btn-g" href={settingsUrl}>{labels.exportDeck}</a>
            <a class="btn btn-g" href={settingsUrl}>{labels.importDeck}</a>
          </div>

          <div class="panel flashcards-rail-panel flashcards-ai">
            <span class="lbl">{labels.askYourAi}</span>
            <span class="flashcards-ai-prompt">“{labels.aiPrompt}”</span>
            <span class="lbl">{labels.aiTools}</span>
          </div>
        </aside>
      </div>
    </div>
  </Flashcards>
</Base>
