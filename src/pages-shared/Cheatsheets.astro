---
/** Bilingual cheatsheet index. Only reviewed entries survive a production build. */
import Tag from '@/components/Tag.astro';
import { TRACKS } from '@/data/tracks';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { cheatsheetMeta, listCheatsheets } from '@/lib/content';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/cheatsheets/', locale);
const sheets = await listCheatsheets(locale);
const trackBySlug = new Map(TRACKS.map((track) => [track.slug, track]));

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'cheatsheets.title'),
  description: t(locale, 'cheatsheets.lead'),
  kind: 'page',
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
});
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap cheatsheets-page">
    <header class="cheatsheets-head">
      <h1>{t(locale, 'cheatsheets.title')}</h1>
      <p>{t(locale, 'cheatsheets.lead')}</p>
    </header>

    {
      sheets.length > 0 ? (
        <div class="cheatsheets-list">
          {sheets.map((sheet) => {
            const { slug } = cheatsheetMeta(sheet);
            const track = sheet.data.track ? trackBySlug.get(sheet.data.track) : undefined;
            return (
              <a class="panel cheatsheet-card" href={localizePath(`/cheatsheets/${slug}/`, locale)}>
                <div class="cheatsheet-card-top">
                  <Tag variant="acc">{track?.glyph ?? 'ref'}</Tag>
                </div>
                <h2>{sheet.data.title}</h2>
                <p>{sheet.data.description}</p>
                <span class="lbl">{track?.name[locale] ?? sheet.data.verified.version}</span>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="panel cheatsheets-empty">
          <p>{t(locale, 'cheatsheets.empty')}</p>
        </div>
      )
    }
  </div>
</Base>

<style>
  .cheatsheets-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .cheatsheets-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .cheatsheets-head p,
  .cheatsheet-card p,
  .cheatsheets-empty p {
    margin: 0;
    color: var(--ink2);
    line-height: 1.6;
  }

  .cheatsheets-head p {
    max-width: 620px;
    font-size: 16px;
  }

  .cheatsheets-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .cheatsheet-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 20px;
    color: var(--ink);
    transition:
      border-color var(--t-state) var(--ease),
      box-shadow var(--t-state) var(--ease);
  }

  .cheatsheet-card:hover {
    color: var(--ink);
    border-color: var(--ink3);
    box-shadow: var(--glow);
  }

  .cheatsheet-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .cheatsheet-card h2 {
    font-size: 20px;
  }

  .cheatsheet-card p {
    font-size: 14px;
  }

  .cheatsheet-card .lbl {
    margin-top: auto;
  }

  .cheatsheets-empty {
    padding: 20px;
  }

  @media (max-width: 767px) {
    .cheatsheets-page {
      gap: 24px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 32px;
    }

    .cheatsheets-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
