---
/**
 * `/offline/` and `/zh/offline/` — what the service worker serves when a navigation reaches
 * neither the network nor a cached copy of the page that was asked for.
 *
 * It is precached at install time, so it is always available; it must therefore stay small and
 * carry nothing it cannot render without a network. `Try again` is a plain reload: if the
 * connection came back, the worker's network-first navigation handler serves the real page.
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import { tOffline } from '@/i18n/offline';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/offline/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: tOffline(locale, 'title'),
  description: tOffline(locale, 'lead'),
  kind: 'page',
  noindex: true,
  // No card of its own: `/og/` renders one per listed page, and a notice nobody links to or
  // shares does not need an entry there. The home card is what a paste of this URL shows.
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
});
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="page">
    <span class="lbl">{tOffline(locale, 'label')}</span>
    <h1>{tOffline(locale, 'title')}</h1>
    <p>{tOffline(locale, 'lead')}</p>
    <p class="hint">{tOffline(locale, 'saved')}</p>
    <div class="actions">
      <Button data-offline-retry>{tOffline(locale, 'retry')}</Button>
      <Button variant="ghost" href={localizePath('/', locale)}>{tOffline(locale, 'home')}</Button>
    </div>
  </div>
  <script is:inline>
    // Reloading is the whole retry: back online, the worker's navigation handler answers from the
    // network again. This script never runs on any other page.
    document.querySelector('[data-offline-retry]')?.addEventListener('click', function () {
      location.reload();
    });
  </script>
</Base>

<style>
  .page {
    max-width: calc(var(--w) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 96px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  h1 {
    font-size: 38px;
    line-height: 1.1;
  }

  p {
    margin: 0;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink2);
  }

  p.hint {
    font-size: 14px;
    color: var(--ink3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  @media (max-width: 767px) {
    .page {
      padding: 56px var(--gutter) 64px;
    }

    h1 {
      font-size: 30px;
    }
  }
</style>
