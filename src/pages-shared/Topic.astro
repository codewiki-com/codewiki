---
/**
 * A topic page, shared by `/{track}/{slug}/` and `/zh/{track}/{slug}/`. Column for column it is
 * docs/design/mockups/Topic.dc.html: the track tree on the left, the article in the middle, the
 * table of contents and the reader's context on the right.
 *
 * The article itself is the MDX body rendered through `mdxComponents`; everything the depth dial
 * needs is already in that markup, because the markdown pipeline marks each block and each heading
 * with its depth. Switching depth is one attribute on `#article`, applied before first paint by
 * the inline bootstrap below and afterwards by the `DepthDial` island.
 *
 * Reading progress, the depth preference and the "was this clear?" answer are facts about the
 * visitor's browser: the server renders none of them, the islands patch them in, and the page is
 * complete without JavaScript.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

import Base from '@/layouts/Base.astro';
import ActionRow from '@/components/ActionRow.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Checkpoint from '@/components/Checkpoint.astro';
import CheckpointMarker from '@/components/CheckpointMarker.astro';
import Icon from '@/components/Icon.astro';
import MetaPanel from '@/components/MetaPanel.astro';
import PrevNext from '@/components/PrevNext.astro';
import SectionTree from '@/components/SectionTree.astro';
import Seg from '@/components/Seg.astro';
import { mdxComponents } from '@/components/mdx';
import CodeRunners from '@/islands/CodeRunners';
import DepthDial from '@/islands/DepthDial';
import ReadTracker from '@/islands/ReadTracker';
import Terms from '@/islands/Terms';
import Toc from '@/islands/Toc';
import { t } from '@/i18n';
import { P2_NAV, SITE } from '@/data/site';
import { getSection, getTrack } from '@/data/tracks';
import { getTopic, isPublic, topicMeta, type Topic } from '@/lib/content';
import { breadcrumbLd, buildHead, techArticleLd } from '@/lib/seo';
import { localizePath, topicUrl, trackUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  topic: Topic;
}

const { locale, topic } = Astro.props;
const { track: trackSlug, slug } = topicMeta(topic);
const id = `${trackSlug}/${slug}`;
const currentPath = topicUrl(trackSlug, slug, locale);

const track = getTrack(trackSlug);
if (!track) throw new Error(`Topic ${topic.id} names a track that is not in the registry`);
const trackName = track.name[locale];
const section = getSection(track, topic.data.section);

const { Content, headings, remarkPluginFrontmatter } = await render(topic);

/** Written by `remark-depth`; the panel states the Standard figure, as the mockup does. */
const readingTime = (remarkPluginFrontmatter as { readingTime?: Record<string, number> }).readingTime;
const minutes = readingTime?.standard ?? 1;

/* ---- table of contents ------------------------------------------------------------------ */

/**
 * Rendered from the headings Astro collected, so the contents work without JavaScript. Which of
 * them belong to a `deep` block is only knowable from the rendered article, so the `Toc` island
 * reconciles the list against `#article` once it hydrates.
 */
const toc = (headings as MarkdownHeading[]).filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasCheckpoint = Boolean(topic.data.quiz) || (topic.body?.includes('<Checkpoint') ?? false);

/** First public related topic, in the same order as the existing PrevNext cards. */
const relatedTopics = await Promise.all(
  topic.data.related.map(async (ref: string) => {
    const [relatedTrack, relatedSlug] = ref.split('/');
    if (!relatedTrack || !relatedSlug) return undefined;
    const entry = await getTopic(relatedTrack, relatedSlug, locale);
    return entry && isPublic(entry)
      ? { title: entry.data.title, href: topicUrl(relatedTrack, relatedSlug, locale) }
      : undefined;
  }),
);
const checkpointNext = relatedTopics.find((entry): entry is { title: string; href: string } =>
  Boolean(entry),
);

/* The authored component is an editorial marker. Rendering it here lets the page supply the
   resolved navigation data while keeping the checkpoint exactly at the end of every article. */
const topicMdxComponents = { ...mdxComponents, Checkpoint: CheckpointMarker };

/**
 * Whether this topic has a runnable fence, read from the source rather than the rendered HTML:
 * the runner island is ~30 kB of JavaScript and a Pyodide loader, and a page of prose should not
 * pay for it. ` ```python run title="…" ` is the shape `shiki-meta.ts` turns into `data-run`.
 */
const hasRunnable = /^ {0,3}(?:`{3,}|~{3,})[^\n]*\brun\b/m.test(topic.body ?? '');

/* ---- ask ai ----------------------------------------------------------------------------- */

/** What the "explain it simpler" preset may assume: the first topic this one is written after. */
const prerequisite = topic.data.prerequisites?.[0]?.split('/').pop()?.replace(/-/g, ' ');

/* ---- right rail ------------------------------------------------------------------------- */

type GlossaryTerm = CollectionEntry<'glossary'>;

const glossary: GlossaryTerm[] = await getCollection('glossary');
const byTermId = new Map(glossary.map((term) => [term.id, term]));
const termIds: string[] = topic.data.terms ?? [];
const terms = termIds
  .map((termId) => byTermId.get(termId))
  .filter((term): term is GlossaryTerm => Boolean(term))
  .map((term) => ({
    id: term.id,
    primary: locale === 'zh' ? term.data.zh : term.data.en,
    secondary: locale === 'zh' ? term.data.en : term.data.zh,
    en: term.data.en,
    zh: term.data.zh,
    short: term.data.short[locale],
    href: localizePath(`/glossary/${term.id}/`, locale),
  }));

/**
 * The definitions the `Terms` island lends to the dotted terms in the article, keyed by the id
 * `<Term>` writes into `data-term`. Embedded rather than fetched: it is the same handful of terms
 * the rail already lists. `<` is escaped so no definition can close the script element early.
 */
const termsJson = JSON.stringify(
  Object.fromEntries(terms.map((term) => [term.id, { en: term.en, zh: term.zh, short: term.short }])),
).replace(/</g, '\\u003c');

/** The path this topic sits on, if any: which milestone it belongs to and how much is left. */
const paths: CollectionEntry<'paths'>[] = await getCollection('paths');
const path = paths.find((entry) =>
  entry.data.milestones.some((milestone: { topics: string[] }) => milestone.topics.includes(id)),
);
const milestones: string[][] = path?.data.milestones.map((m: { topics: string[] }) => m.topics) ?? [];
const pathTopics = milestones.flat();
const milestoneIndex = milestones.findIndex((topics) => topics.includes(id));
const left = pathTopics.length - (pathTopics.indexOf(id) + 1);

/* ---- breadcrumb ------------------------------------------------------------------------- */

/**
 * One trail, rendered twice: as the pills above the title and as the `BreadcrumbList`. A section
 * has no page of its own, so it points at its group on the track hub.
 */
const trail = [
  { label: t(locale, 'nav.tracks'), path: localizePath('/tracks/', locale) },
  { label: trackName, path: trackUrl(trackSlug, locale) },
  ...(section
    ? [{ label: section.name[locale], path: `${trackUrl(trackSlug, locale)}#${section.slug}` }]
    : []),
];

/* ---- head ------------------------------------------------------------------------------- */

const inLanguage = locale === 'zh' ? 'zh-Hans' : 'en';
const modified = (topic.data.reviewed ?? topic.data.verified.date).toISOString().slice(0, 10);
const url = `${SITE.url}${currentPath}`;

const head = buildHead({
  locale,
  path: currentPath,
  title: topic.data.title,
  description: topic.data.description,
  kind: 'topic',
  trackName,
  jsonLd: [
    techArticleLd({
      headline: topic.data.title,
      description: topic.data.description,
      url,
      dateModified: modified,
      inLanguage,
      keywords: topic.data.tags,
      section: section?.name[locale],
    }),
    breadcrumbLd([
      ...trail.map((crumb) => ({ name: crumb.label, url: `${SITE.url}${crumb.path}` })),
      { name: topic.data.title, url },
    ]),
  ],
});
---

<Base
  locale={locale}
  head={head}
  width="topic"
  currentPath={currentPath}
  pagefind={{
    filter: { lang: locale },
    meta: {
      type: 'topic',
      track: trackName,
      glyph: track.glyph,
      ...(section && { section: section.name[locale] }),
    },
  }}
>
  <!--
    Progressive enhancement keeps the TOC open without JavaScript. With JavaScript, mark it as
    collapsible before the article is parsed so the mobile grid never paints an expanded row and
    then moves the article when the late module runs.
  -->
  <script is:inline>
    (function () {
      document.documentElement.setAttribute('data-topic-toc-enhanced', '');

      var wire = function () {
        var toggle = document.querySelector('[data-toc-toggle]');
        var nav = document.querySelector('[data-toc-nav]');
        if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

        var narrow = matchMedia('(max-width: 1023px)');
        var set = function (open) {
          nav.toggleAttribute('data-toc-open', open);
          toggle.setAttribute('aria-expanded', String(open));
        };
        var sync = function () {
          set(!narrow.matches);
        };

        narrow.addEventListener('change', sync);
        toggle.addEventListener('click', function () {
          set(toggle.getAttribute('aria-expanded') !== 'true');
        });
        sync();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wire, { once: true });
      } else {
        wire();
      }
    })();
  </script>

  <div class="wrap body">
    <SectionTree locale={locale} track={track} currentId={id} />

    <!-- HEADER -->
    <header class="head">
      <Breadcrumb
        label={t(locale, 'nav.tracks')}
        items={[
          ...trail.map((crumb) => ({ label: crumb.label, href: crumb.path })),
          { label: locale === 'zh' ? topic.data.title : slug, current: true },
        ]}
      />
      <h1>{topic.data.title}</h1>
      <p class="sub">{topic.data.description}</p>

      <MetaPanel
        locale={locale}
        difficulty={topic.data.difficulty}
        minutes={minutes}
        version={topic.data.verified.version}
        checked={topic.data.verified.date}
        reviewed={topic.data.reviewed}
        status={topic.data.status}
      />

      <div class="controls">
        <DepthDial
          client:idle
          label={t(locale, 'settings.depth')}
          labels={{
            quick: t(locale, 'depth.quick'),
            standard: t(locale, 'depth.standard'),
            deep: t(locale, 'depth.deep'),
          }}
        />
        <!-- Bilingual reading is P2; the control is shown inert rather than promised elsewhere. -->
        <div class="bilingual">
          <span class="lbl">{t(locale, 'bilingual.label')}</span>
          <Seg
            label={t(locale, 'bilingual.label')}
            aria-disabled="true"
            title={t(locale, 'bilingual.soon')}
            items={[
              { label: t(locale, 'bilingual.off'), value: 'off', on: true },
              { label: t(locale, 'bilingual.on'), value: 'en-zh', lang: 'zh-Hans' },
            ]}
          />
        </div>
      </div>
    </header>

    <!-- ARTICLE -->
    <div class="col">
      <!--
        The runners hydrate on visibility, and the island's own mount is a 1px sentinel placed
        here, at the top of the column, so the observer sees it on load rather than after the
        reader has scrolled past every example it is meant to wire up.
      -->
      {hasRunnable && <CodeRunners client:visible />}
      <article id="article" class="prose" data-depth-mode="standard">
        <script is:inline>
          /* The depth bootstrap, and the reason there is no flash of the wrong depth: it is the
             article's first child, so it runs before any of the article is parsed. Keep the
             storage key and the resolution order in step with src/lib/depth.ts. */
          (function () {
            var article = document.currentScript && document.currentScript.parentElement;
            if (!article) return;
            var ok = function (value) {
              return value === 'quick' || value === 'standard' || value === 'deep';
            };
            var depth = 'standard';
            try {
              var fromUrl = new URLSearchParams(location.search).get('depth');
              var stored = JSON.parse(localStorage.getItem('cw:v1:prefs') || '{}').depth;
              depth = ok(fromUrl) ? fromUrl : ok(stored) ? stored : 'standard';
            } catch {
              /* private mode or a hand-edited value: Standard is the right fallback */
            }
            article.setAttribute('data-depth-mode', depth);
            // The dial is above the article and already parsed, so it can be put in step too.
            for (const tab of document.querySelectorAll('[data-depth-tab]')) {
              var on = tab.getAttribute('data-depth-tab') === depth;
              tab.classList.toggle('on', on);
              tab.setAttribute('aria-checked', String(on));
              tab.setAttribute('tabindex', on ? '0' : '-1');
            }
          })();
        </script>
        <Content components={topicMdxComponents} />
        {
          hasCheckpoint && (
            <Checkpoint
              id={topic.data.quiz ?? id}
              topicId={id}
              nextTitle={checkpointNext?.title}
              nextHref={checkpointNext?.href}
              trackHref={trackUrl(trackSlug, locale)}
            />
          )
        }
      </article>

      <PrevNext locale={locale} prerequisites={topic.data.prerequisites} related={topic.data.related} />
      <ActionRow
        locale={locale}
        topicId={id}
        path={currentPath}
        filePath={`${trackSlug}/${slug}.${locale}.mdx`}
        title={topic.data.title}
        url={url}
        language={track.name.en}
        prerequisite={prerequisite}
      />
    </div>

    <!-- RIGHT RAIL -->
    <aside class="rail">
      <div class="toc-box">
        <span class="lbl toc-title">{t(locale, 'toc.title')}</span>
        <!-- Below 1024px the contents collapse into this row; the script wires it up. -->
        <button type="button" class="panel toc-toggle" data-toc-toggle aria-expanded="true">
          <span>{t(locale, 'toc.title')}</span>
          <span class="toc-count lbl">{t(locale, 'track.sections', { count: toc.length })}</span>
          <Icon name="chevron-down" size={14} />
        </button>
        <nav class="toc" aria-label={t(locale, 'toc.title')} data-toc-nav>
          <a href="#tldr" data-toc-fixed="tldr" hidden>{t(locale, 'toc.tldr')}</a>
          {
            toc.map((heading) => (
              <a
                href={`#${heading.slug}`}
                data-toc={heading.slug}
                data-toc-level={heading.depth}
                class:list={[heading.depth === 3 && 'toc-sub']}
              >
                {heading.text}
              </a>
            ))
          }
          {
            hasCheckpoint && (
              <a href="#checkpoint" data-toc-fixed="checkpoint">
                {t(locale, 'toc.checkpoint')}
              </a>
            )
          }
        </nav>
      </div>

      <div class="rail-rest">
        {
          path && (
            <div class="panel rail-panel">
              <span class="lbl">{t(locale, 'topic.path')}</span>
              {/* The path page is P2: until it is built the card names the path without linking. */}
              {P2_NAV ? (
                <a class="path-title" href={localizePath(`/paths/${path.id}/`, locale)}>
                  {path.data.title[locale]}
                </a>
              ) : (
                <span class="path-title">{path.data.title[locale]}</span>
              )}
              <div class="bar" aria-hidden="true" data-path-bar>
                <div />
              </div>
              <span class="lbl">
                {t(locale, 'topic.milestone', {
                  done: milestoneIndex + 1,
                  total: milestones.length,
                  left,
                })}
              </span>
            </div>
          )
        }

        {
          terms.length > 0 && (
            <Fragment>
              <div class="terms">
                <span class="lbl">{t(locale, 'topic.terms')}</span>
                {terms.map((term) => (
                  <a class="term-row" href={term.href}>
                    <span class="term">{term.primary}</span>
                    <span class="lbl">{term.secondary}</span>
                  </a>
                ))}
              </div>

              {/* The hover and focus definitions for the same terms, where they appear in prose. */}
              <script is:inline type="application/json" id="cw-terms" set:html={termsJson} />
              <Terms client:idle />
            </Fragment>
          )
        }
      </div>
    </aside>
  </div>

  <!-- Local-only behaviour: both islands patch the markup above and render nothing themselves. -->
  <Toc client:idle labels={{ deep: t(locale, 'toc.deep') }} />
  <ReadTracker client:idle topicId={id} />
</Base>

<style>
  /* ---- layout ---- */

  /* The mockup's three columns. Header and article are separate grid items so that below 1024px
     the rail can slide between them, where the mobile mockup puts the contents. */
  .body {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    grid-template-areas:
      'tree head rail'
      'tree col rail';
    align-items: start;
    column-gap: 48px;
    row-gap: 24px;
    padding: 32px 0 72px;
  }

  .body :global(.tree) {
    grid-area: tree;
    position: sticky;
    top: 24px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
  }

  .head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .col {
    grid-area: col;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .rail {
    grid-area: rail;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    position: sticky;
    top: 24px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
  }

  /* ---- header ---- */

  h1 {
    font-size: 46px;
    line-height: 1.1;
  }

  .sub {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink2);
  }

  /* The dial and the bilingual segment share one line where there is room and stack where there
     is not; on a phone the two together are wider than the viewport. */
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
  }

  .bilingual {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 8px;
  }

  /* ---- article ---- */

  /* The 24px rhythm of the mockup's prose column. The depth wrappers repeat it internally, so a
     block hidden by the depth dial takes its gap with it. */
  #article {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* ---- right rail ---- */

  .toc-box {
    display: flex;
    flex-direction: column;
  }

  .toc-title {
    margin-bottom: 8px;
  }

  .toc-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 12px 14px;
    font-size: 14px;
    color: var(--ink);
    text-align: left;
    border: 1px solid var(--line);
  }

  .toc-count {
    margin-left: auto;
  }

  /* An h3 sits one step in from its section. */
  .toc :global(.toc-sub) {
    padding-left: 24px;
  }

  .rail-rest {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .rail-panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px;
  }

  .path-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  a.path-title:hover {
    color: var(--acc);
  }

  /* Decoration until reading progress is patched in: an empty progressbar would announce a
     figure the page does not have, so the bar is hidden from assistive technology instead. */
  .bar {
    height: 4px;
    border-radius: 2px;
    background: var(--acc-soft);
    overflow: hidden;
  }

  .bar div {
    width: 0;
    height: 100%;
    background: var(--acc);
  }

  .terms {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .term-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-size: 13px;
    color: var(--ink2);
  }

  .term-row:hover .term {
    color: var(--acc);
  }

  /* ---- narrow ---- */

  @media (max-width: 1023px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'rail'
        'col'
        'rest';
      padding-top: 20px;
      /* The three-column layout puts the gutter inside the tree and rail columns, so the grid
         itself has none. With those columns gone the content would sit on the screen edge, so
         the page's own gutter comes back — the same inset the nav and the footer use. */
      padding-inline: var(--gutter);
    }

    /* The track tree is the site navigation on a phone, and the header carries that already. */
    .body :global(.tree) {
      display: none;
    }

    /* The rail's children become grid items, so the contents can sit under the header while the
       reader's context follows the article. */
    .rail {
      display: contents;
    }

    .rail-rest {
      grid-area: rest;
    }

    .toc-box {
      grid-area: rail;
    }

    .toc-title {
      display: none;
    }

    .toc-toggle {
      display: flex;
    }

    :global(html[data-topic-toc-enhanced]) .toc:not([data-toc-open]) {
      display: none;
    }

    .toc :global(a) {
      padding-left: 14px;
    }

    /* The depth dial stays reachable while reading, as in MobileTopic.dc.html. */
    .controls {
      position: sticky;
      top: 0;
      z-index: 2;
      background: var(--bg);
      padding-top: 8px;
    }

    h1 {
      font-size: 36px;
    }

    .sub {
      font-size: 16px;
    }
  }

  /* On the narrowest phones the dial and the segment only fit side by side without the word
     in front of the segment. The Seg keeps its own `aria-label`, so nothing is lost to a
     screen reader. */
  @media (max-width: 479px) {
    .bilingual .lbl {
      display: none;
    }
  }
</style>
