---
/**
 * One track's practice catalogue: `/practice/{track}/` and `/zh/practice/{track}/`.
 *
 * This is the page the hub used to be, minus the other twenty-one tracks. The largest track ships
 * under 200 cards instead of 1,748, so the filter island has a document it can annotate in a
 * frame rather than in seconds. Type, level and sort keep working exactly as before, including
 * their query-string state; the track itself is the route now, not a filter.
 */
import PracticeCard from '@/components/PracticeCard.astro';
import Seg from '@/components/Seg.astro';
import Tag from '@/components/Tag.astro';
import { TRACKS, type Track } from '@/data/tracks';
import { formatCount, t } from '@/i18n';
import PracticeFilters from '@/islands/PracticeFilters';
import Base from '@/layouts/Base.astro';
import { listTopics, topicMeta } from '@/lib/content';
import { ITEM_TYPES, listPracticeItems, type ItemType } from '@/lib/practice';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  track: Track;
}

const { locale, track } = Astro.props;
const currentPath = localizePath(`/practice/${track.slug}/`, locale);
const hubPath = localizePath('/practice/', locale);

const all = await listPracticeItems();
const items = all.filter((item) => item.track === track.slug);
const topics = await listTopics(locale);
const topicById = new Map(
  topics.map((topic) => {
    const { track: topicTrack, slug } = topicMeta(topic);
    return [`${topicTrack}/${slug}`, topic] as const;
  }),
);

const trackName = track.name[locale];
const presentTypes = new Set(items.map((item) => item.type));
const tracksWithItems = TRACKS.filter((candidate) => all.some((item) => item.track === candidate.slug));

const typeTabs = [
  { value: 'all', label: t(locale, 'practice.all'), href: currentPath },
  ...ITEM_TYPES.filter((type) => presentTypes.has(type)).map((type) => ({
    value: type,
    label: t(locale, `practice.type.${type}`),
    href: `${currentPath}?type=${type}`,
  })),
];

/* The chips are navigation now, not filters: each one is another track's page. They carry no
   `data-filter-group`, so `PracticeFilters` leaves them alone and the browser follows them. */
const trackLinks = [
  { label: t(locale, 'practice.allTracks'), value: 'all', href: hubPath },
  ...tracksWithItems.map((candidate) => ({
    label: candidate.name[locale],
    value: candidate.slug,
    on: candidate.slug === track.slug,
    // "Go" is a whole accessible name on its own; the chip says what following it does.
    ariaLabel: t(locale, 'practice.filterBy', { track: candidate.name[locale] }),
    href: localizePath(`/practice/${candidate.slug}/`, locale),
  })),
];

const levels = ['beginner', 'intermediate', 'advanced'] as const;
const levelFilters = [
  { label: t(locale, 'practice.all'), value: 'all', on: true, href: currentPath },
  ...levels
    .filter((level) => items.some((item) => item.difficulty === level))
    .map((level) => ({
      label: t(locale, `difficulty.${level}`),
      value: level,
      href: `${currentPath}?level=${level}`,
    })),
];

const sortFilters = [
  { label: t(locale, 'practice.sort.unsolved'), value: 'unsolved', on: true, href: currentPath },
  { label: t(locale, 'practice.sort.newest'), value: 'newest', href: `${currentPath}?sort=newest` },
  { label: t(locale, 'practice.sort.hardest'), value: 'hardest', href: `${currentPath}?sort=hardest` },
];

const lead = t(locale, 'practice.trackLead', { track: trackName });
const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'practice.trackTitle', { track: trackName }),
  description: lead,
  kind: 'page',
});

const difficultyLabel = (type: ItemType) => t(locale, `practice.type.${type}`);
---

<!-- Pagefind-ignored, as `/tracks/` and the track hubs are: a listing page has nothing to say
  that the pages it lists do not say better, and each exercise has its own indexed page. -->
<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <header class="wrap practice-header">
    <div class="practice-kicker">
      <a class="tag" href={hubPath}>{t(locale, 'practice.title')}</a>
      <span class="lbl">/</span>
      <Tag variant="acc">{track.glyph}</Tag>
    </div>
    <h1>{t(locale, 'practice.trackTitle', { track: trackName })}</h1>
    <p>{lead}</p>
    <div class="practice-chips">
      <Tag>
        {
          t(locale, 'practice.items', {
            count: formatCount(locale, items.length, 'unit.exercise', 'unit.exercises'),
          })
        }
      </Tag>
      <Tag>{t(locale, 'practice.offline')}</Tag>
      <Tag><span lang="zh-Hans">{t(locale, 'practice.synced')}</span></Tag>
    </div>
  </header>

  <div class="wrap practice-body">
    <div class="practice-main">
      <div class="practice-controls" data-practice-controls>
        <nav class="practice-tabs" aria-label={t(locale, 'practice.title')} data-filter-group="type">
          {
            typeTabs.map((tab, index) => (
              <a
                class:list={[index === 0 && 'on']}
                href={tab.href}
                data-value={tab.value}
                aria-current={index === 0 ? 'true' : undefined}
              >
                {tab.label}
              </a>
            ))
          }
        </nav>

        <div class="practice-filter-row">
          <div class="track-filter-scroll">
            <Seg class="track-chips" items={trackLinks} label={t(locale, 'practice.allTracks')} />
          </div>
          <div class="filter-pair">
            <span class="lbl">{t(locale, 'practice.level')}</span>
            <div class="filter-scroll">
              <Seg items={levelFilters} label={t(locale, 'practice.level')} data-filter-group="level" />
            </div>
          </div>
        </div>

        <div class="practice-count-row">
          <span class="lbl" data-practice-count>
            {
              t(locale, 'practice.results', {
                count: formatCount(locale, items.length, 'unit.exercise', 'unit.exercises'),
                done: 0,
              })
            }
          </span>
          <div class="filter-pair">
            <span class="lbl">{t(locale, 'practice.sort')}</span>
            <div class="filter-scroll">
              <Seg items={sortFilters} label={t(locale, 'practice.sort')} data-filter-group="sort" />
            </div>
          </div>
        </div>
      </div>

      <div class="practice-grid" data-practice-grid>
        {
          items.map((item, index) => {
            const topic = topicById.get(`${item.track}/${item.slug}`);
            return (
              <PracticeCard
                item={item}
                locale={locale}
                trackGlyph={track.glyph}
                topicTitle={topic?.data.title ?? item.slug}
                topicDescription={topic?.data.description ?? difficultyLabel(item.type)}
                order={index}
                more={index >= 24}
              />
            );
          })
        }
      </div>

      <p class="panel practice-empty" data-practice-empty hidden>
        {t(locale, 'practice.noResults')}
      </p>
      {
        items.length > 24 && (
          <div class="practice-more">
            <button class="btn btn-g" type="button" data-practice-more hidden>
              {t(locale, 'practice.showMore', { count: items.length - 24 })}
            </button>
          </div>
        )
      }
    </div>
  </div>

  <PracticeFilters
    client:idle
    locale={locale}
    labels={{
      results: t(locale, 'practice.results', { count: '{count}', done: '{done}' }),
      showMore: t(locale, 'practice.showMore', { count: '{count}' }),
      done: t(locale, 'practice.done', { score: '{score}', total: '{total}' }),
      missed: t(locale, 'practice.missed'),
    }}
  />
</Base>

<style>
  .practice-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 44px;
    padding-bottom: 24px;
  }

  .practice-kicker,
  .practice-chips {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .practice-header p {
    max-width: 760px;
    margin: 0;
    color: var(--ink2);
    font-size: 17px;
    line-height: 1.6;
  }

  .practice-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    padding-bottom: 72px;
  }

  .practice-main,
  .practice-controls {
    display: flex;
    flex-direction: column;
  }

  .practice-main {
    min-width: 0;
    gap: 18px;
  }

  .practice-controls {
    gap: 14px;
    min-width: 0;
  }

  .practice-tabs {
    display: flex;
    gap: 22px;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }

  .practice-tabs::-webkit-scrollbar {
    display: none;
  }

  .practice-tabs a {
    flex: none;
    margin-bottom: -1px;
    padding: 8px 0 10px;
    border-bottom: 2px solid transparent;
    color: var(--ink3);
    font-size: 13.5px;
    white-space: nowrap;
  }

  .practice-tabs a:hover,
  .practice-tabs a.on {
    color: var(--ink);
  }

  .practice-tabs a.on {
    border-bottom-color: var(--ink);
    font-weight: 500;
  }

  .practice-filter-row,
  .practice-count-row,
  .filter-pair {
    display: flex;
    align-items: center;
  }

  .practice-filter-row,
  .practice-count-row {
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .practice-filter-row {
    align-items: flex-end;
    flex-direction: column;
  }

  .filter-pair {
    gap: 10px;
    min-width: 0;
  }

  .filter-scroll {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .track-filter-scroll {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .filter-scroll :global(.seg) {
    width: max-content;
  }

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .practice-empty {
    margin: 0;
    padding: 24px;
    color: var(--ink2);
    font-size: 14px;
    text-align: center;
  }

  .practice-more {
    display: flex;
    justify-content: center;
    min-height: 40px;
    padding-top: 6px;
  }

  .practice-more .btn {
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .practice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .practice-header {
      padding-top: 28px;
      padding-bottom: 20px;
    }

    h1 {
      font-size: 32px;
    }

    .practice-header p {
      font-size: 15px;
    }

    .practice-body {
      gap: 28px;
      padding-bottom: 40px;
    }

    .practice-filter-row,
    .practice-count-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .filter-pair,
    .filter-scroll,
    .track-filter-scroll {
      width: 100%;
    }

    .track-filter-scroll {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
    }

    .track-filter-scroll::-webkit-scrollbar {
      display: none;
    }

    .filter-pair {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .practice-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
