---
/**
 * One bilingual learning path. Curriculum and SVG geometry are static; PathState projects the
 * visitor's local progress onto the data hooks without re-rendering the map.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';

import Breadcrumb from '@/components/Breadcrumb.astro';
import Button from '@/components/Button.astro';
import PathMap from '@/components/PathMap.astro';
import Tag from '@/components/Tag.astro';
import { SITE } from '@/data/site';
import { t } from '@/i18n';
import PathState, {
  type PathStateLabels,
  type PathStatePath,
  type PathStateTopic,
} from '@/islands/PathState';
import Base from '@/layouts/Base.astro';
import { isPublic, topicMeta, type Topic } from '@/lib/content';
import { EMPTY_PROGRESS } from '@/lib/prefs';
import { pathProgress } from '@/lib/paths';
import { breadcrumbLd, buildHead, courseLd } from '@/lib/seo';
import { localizePath, topicUrl, type Locale } from '@/lib/urls';
import type { Path as PathData } from '@/schemas/path';

interface Props {
  locale: Locale;
  path: CollectionEntry<'paths'>;
}

const { locale, path } = Astro.props;
const data = path.data as PathData;
const currentPath = localizePath(`/paths/${path.id}/`, locale);
const topicEntries = (await getCollection('topics')) as Topic[];
const allTopics: Topic[] = topicEntries.filter((topic) => {
  const meta = topicMeta(topic);
  return meta.lang === locale && isPublic(topic);
});
const topicById: Map<string, Topic> = new Map(
  allTopics.map((topic) => {
    const { track, slug } = topicMeta(topic);
    return [`${track}/${slug}`, topic] as const;
  }),
);

/** Planned nodes have no frontmatter yet, so their stable slug becomes a readable map label. */
const PLANNED_LABELS: Record<string, string> = {
  'variables-types': 'Variables & types',
  'control-flow': 'Control flow',
  'strings-fstrings': 'Strings & f-strings',
  functions: 'Functions',
  'scope-legb': 'Scope & LEGB',
  'lists-dicts-sets': 'Lists, dicts & sets',
  decorators: 'Decorators',
  'args-kwargs': '*args and **kwargs',
  functools: 'functools',
  generators: 'Generators',
  'classes-objects': 'Classes & objects',
  dataclasses: 'Dataclasses',
  exceptions: 'Exceptions',
  'protocols-abcs': 'Protocols & ABCs',
  'files-pathlib': 'Files & pathlib',
  'json-http': 'JSON & HTTP APIs',
  'testing-pytest': 'Testing with pytest',
  'packaging-uv': 'Packaging with uv',
  asyncio: 'asyncio',
  'threads-gil': 'Threads & the GIL',
  'type-hints': 'Type hints',
  mypy: 'mypy in practice',
};

const plannedTitle = (id: string) => {
  const slug = id.split('/').at(-1) ?? id;
  return PLANNED_LABELS[slug] ?? slug.replaceAll('-', ' ').replace(/^./, (letter) => letter.toUpperCase());
};

const topicIds = data.milestones.flatMap((milestone) => milestone.topics);
const topics: Record<string, PathStateTopic> = {};
for (const id of topicIds) {
  const topic = topicById.get(id);
  if (!topic) {
    topics[id] = { title: plannedTitle(id), minutes: 10 };
    continue;
  }
  const rendered = await render(topic);
  const readingTime = (rendered.remarkPluginFrontmatter as { readingTime?: Record<string, number> })
    .readingTime;
  const standard = readingTime?.standard ?? 1;
  topics[id] = {
    title: topic.data.title,
    minutes: topic.data.quiz ? Math.ceil(standard * 1.5) : standard,
    href: topicUrl(topic.data.track, topicMeta(topic).slug, locale),
  };
}

const milestones = data.milestones.map((milestone, index) => ({
  id: milestone.id,
  title: milestone.title[locale],
  topics: milestone.topics,
  checkpoint: milestone.checkpoint,
  checkpointHref: localizePath('/practice/', locale),
  checkpointLabel: t(locale, 'paths.checkpoint', { number: index + 1 }),
}));
const clientPath: PathStatePath = { id: path.id, milestones };
const initial = pathProgress(clientPath, EMPTY_PROGRESS);
const firstAuthored = topicIds.find((id) => topics[id]?.href);
const firstDestination = firstAuthored ? topics[firstAuthored] : undefined;

const range = t(locale, 'paths.range', {
  from: t(locale, `difficulty.${data.level.from}`),
  to: t(locale, `difficulty.${data.level.to}`),
});
const totalMinutes = topicIds.reduce((sum, id) => sum + topics[id]!.minutes, 0);

const labels: PathStateLabels = {
  continue: t(locale, 'paths.continue', { title: '{title}' }),
  progress: t(locale, 'paths.progress', {
    done: '{done}',
    total: '{total}',
    milestone: '{milestone}',
    milestones: '{milestones}',
  }),
  milestoneMeta: t(locale, 'paths.milestoneMeta', {
    done: '{done}',
    total: '{total}',
    min: '{min}',
  }),
  remaining: t(locale, 'paths.remaining', { h: '{h}', w: '{w}' }),
  minutes: t(locale, 'paths.minutes', { min: '{min}' }),
  readPct: t(locale, 'paths.readPct', { min: '{min}', pct: '{pct}' }),
  now: t(locale, 'paths.now'),
  next: t(locale, 'paths.next'),
  done: t(locale, 'paths.done'),
  soon: t(locale, 'paths.soon'),
  shared: t(locale, 'paths.shared'),
};

const head = buildHead({
  locale,
  path: currentPath,
  title: data.title[locale],
  description: data.description[locale],
  kind: 'path',
  ogImagePath: locale === 'zh' ? '/og/zh/home.png' : '/og/home.png',
  jsonLd: [
    breadcrumbLd([
      { name: t(locale, 'paths.title'), url: `${SITE.url}${localizePath('/paths/', locale)}` },
      { name: data.title[locale], url: `${SITE.url}${currentPath}` },
    ]),
    courseLd({
      name: data.title[locale],
      description: data.description[locale],
      url: `${SITE.url}${currentPath}`,
      inLanguage: locale === 'zh' ? 'zh-Hans' : 'en',
    }),
  ],
});

const circumference = 2 * Math.PI * 26;
const mapAria = `${data.title[locale]}: ${topicIds.length} ${t(locale, 'paths.topics')}, ${milestones.length} ${t(locale, 'paths.checkpoints')}.`;
---

<Base
  locale={locale}
  head={head}
  currentPath={currentPath}
  pagefind={{ filter: { lang: locale }, meta: { type: 'path' } }}
>
  <div data-path-root={path.id}>
    <header class="wrap path-header">
      <div class="path-intro">
        <Breadcrumb
          label={t(locale, 'nav.paths')}
          items={[
            { label: t(locale, 'nav.paths'), href: localizePath('/paths/', locale) },
            { label: path.id, current: true },
          ]}
        />
        <h1>{data.title[locale]}</h1>
        <p>{data.description[locale]}</p>
        <div class="path-chips">
          <Tag>{topicIds.length} {t(locale, 'paths.topics')}</Tag>
          <Tag>{milestones.length} {t(locale, 'paths.checkpoints')}</Tag>
          <Tag>{t(locale, 'paths.hours', { h: data.hours })}</Tag>
          <Tag>{range}</Tag>
          <Tag><span lang="zh-Hans">{t(locale, 'paths.synced')}</span></Tag>
        </div>
      </div>

      <div class="panel path-progress-card">
        <svg
          width="64"
          height="64"
          viewBox="0 0 64 64"
          role="progressbar"
          aria-label={data.title[locale]}
          aria-valuenow="0"
          aria-valuemin="0"
          aria-valuemax={topicIds.length}
        >
          <circle cx="32" cy="32" r="26" fill="none" stroke="var(--acc-soft)" stroke-width="7"></circle>
          <circle
            cx="32"
            cy="32"
            r="26"
            fill="none"
            stroke="var(--acc)"
            stroke-width="7"
            stroke-dasharray={circumference.toFixed(1)}
            stroke-dashoffset={circumference.toFixed(1)}
            stroke-linecap="round"
            transform="rotate(-90 32 32)"
            data-path-ring
            data-circumference={circumference.toFixed(1)}></circle>
          <text x="32" y="37" text-anchor="middle" data-path-percent>0%</text>
        </svg>
        <div class="path-progress-copy">
          <span data-path-summary>
            {
              t(locale, 'paths.progress', {
                done: 0,
                total: topicIds.length,
                milestone: 1,
                milestones: milestones.length,
              })
            }
          </span>
          {
            firstDestination?.href && (
              <Button href={firstDestination.href} data-continue>
                {t(locale, 'paths.continue', { title: firstDestination.title })}
              </Button>
            )
          }
        </div>
      </div>
    </header>

    <section class="wrap map-section" aria-labelledby="path-map-title">
      <div class="map-head">
        <h2 id="path-map-title">{t(locale, 'paths.mapTitle')}</h2>
        <div class="map-legend lbl" aria-label={t(locale, 'paths.mapTitle')}>
          <span><i class="legend-node done"></i>{t(locale, 'paths.legendDone')}</span>
          <span><i class="legend-node current"></i>{t(locale, 'paths.legendCurrent')}</span>
          <span><i class="legend-node locked"></i>{t(locale, 'paths.legendLocked')}</span>
          <span><i class="legend-diamond"></i>{t(locale, 'paths.legendCheckpoint')}</span>
        </div>
      </div>
      <div class="panel map-scroll" tabindex="0">
        <PathMap
          milestones={milestones}
          edges={data.edges}
          topics={topics}
          ariaLabel={mapAria}
          checkpointLabel={t(locale, 'paths.checkpoint', { number: '{number}' })}
          soonLabel={t(locale, 'paths.soon')}
        />
      </div>
    </section>

    <div class="wrap path-body">
      <div class="milestone-lists">
        {
          milestones.map((milestone, milestoneIndex) => {
            const minutes = milestone.topics.reduce((sum, id) => sum + topics[id]!.minutes, 0);
            return (
              <section
                class="milestone-list"
                data-milestone-list
                data-milestone-index={milestoneIndex}
                data-state={milestoneIndex === 0 ? 'active' : 'hidden'}
              >
                <div class="milestone-head">
                  <h2>
                    {t(locale, 'paths.milestone', {
                      number: milestoneIndex + 1,
                      title: milestone.title,
                    })}
                  </h2>
                  <span class="lbl" data-milestone-meta>
                    {t(locale, 'paths.milestoneMeta', {
                      done: 0,
                      total: milestone.topics.length,
                      min: minutes,
                    })}
                  </span>
                </div>

                <div class="milestone-items">
                  {milestone.topics.map((id, topicIndex) => {
                    const topic = topics[id]!;
                    const state = initial.states[id] ?? 'open';
                    const row = (
                      <>
                        <span class:list={['tag', state === 'cur' && topic.href && 'acc']} data-row-tag>
                          {topic.href
                            ? state === 'cur'
                              ? t(locale, 'paths.now')
                              : String(topicIndex + 1)
                            : t(locale, 'paths.soon')}
                        </span>
                        <span class="item-title">{topic.title}</span>
                        <span class="lbl" data-row-meta>
                          {t(locale, 'paths.minutes', { min: topic.minutes })}
                        </span>
                      </>
                    );
                    return topic.href ? (
                      <a
                        class="item"
                        href={topic.href}
                        data-topic-row={id}
                        data-milestone={milestone.id}
                        data-authored="true"
                        data-state={state}
                      >
                        {row}
                      </a>
                    ) : (
                      <div
                        class="item soon-row"
                        data-topic-row={id}
                        data-milestone={milestone.id}
                        data-authored="false"
                        data-state={state}
                      >
                        {row}
                      </div>
                    );
                  })}

                  <div
                    class="item checkpoint-row"
                    data-checkpoint-row
                    data-milestone={milestone.id}
                    data-state={initial.checkpoints[milestone.id]}
                  >
                    <i class="legend-diamond" aria-hidden="true" />
                    <span class="item-title">{milestone.checkpointLabel}</span>
                    <span class="lbl">
                      {milestoneIndex + 1 < milestones.length
                        ? t(locale, 'paths.unlocks', { number: milestoneIndex + 2 })
                        : t(locale, 'paths.done')}
                    </span>
                  </div>
                </div>
              </section>
            );
          })
        }

        {
          data.rationale && (
            <p class="rationale">
              <strong>{t(locale, 'paths.rationale')}:</strong> {data.rationale[locale]}
            </p>
          )
        }
      </div>

      <aside class="path-rail">
        <section class="panel rail-panel">
          <h2 class="lbl">{t(locale, 'paths.outcomes')}</h2>
          <ul>
            {data.outcomes.map((outcome) => <li>{outcome[locale]}</li>)}
          </ul>
        </section>

        <section class="panel rail-panel">
          <h2 class="lbl">{t(locale, 'paths.timePlan')}</h2>
          <div class="seg plan-seg" role="radiogroup" aria-label={t(locale, 'paths.timePlan')}>
            {
              [15, 30, 60].map((plan) => (
                <button
                  type="button"
                  role="radio"
                  class:list={[plan === 30 && 'on']}
                  aria-checked={plan === 30 ? 'true' : 'false'}
                  tabindex={plan === 30 ? 0 : -1}
                  data-plan={plan}
                >
                  {t(locale, 'paths.plan', { min: plan })}
                </button>
              ))
            }
          </div>
          <p data-weeks>
            {
              t(locale, 'paths.remaining', {
                h: Math.ceil(totalMinutes / 60),
                w: Math.ceil(totalMinutes / (30 * 7)),
              })
            }
          </p>
        </section>

        <div class="rail-actions">
          <Button variant="ghost" data-path-export>{t(locale, 'paths.export')}</Button>
          <Button variant="ghost" data-path-share>{t(locale, 'paths.share')}</Button>
        </div>

        <section class="panel rail-panel ask-ai">
          <h2 class="lbl">{t(locale, 'paths.askAi')}</h2>
          <p>“{t(locale, 'paths.aiPrompt', { milestone: milestones[0]!.title })}”</p>
          <span class="lbl">{t(locale, 'home.promptMeta')}</span>
        </section>
      </aside>
    </div>

    <PathState client:idle path={clientPath} topics={topics} labels={labels} />
  </div>
</Base>

<style>
  .path-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: center;
    padding-top: 44px;
    padding-bottom: 28px;
  }

  .path-intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .path-intro > p {
    max-width: 720px;
    margin: 0;
    color: var(--ink2);
    font-size: 17px;
    line-height: 1.6;
  }

  .path-chips,
  .map-legend,
  .map-legend > span,
  .path-progress-card,
  .rail-actions {
    display: flex;
    align-items: center;
  }

  .path-chips {
    flex-wrap: wrap;
    gap: 8px;
  }

  .path-progress-card {
    gap: 16px;
    padding: 18px 20px;
    box-shadow: var(--glow);
  }

  .path-progress-card svg {
    flex: none;
  }

  .path-progress-card svg text {
    fill: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }

  .path-progress-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .path-progress-copy > span {
    color: var(--ink2);
    font-size: 14px;
    line-height: 1.4;
  }

  .path-progress-copy :global(.btn) {
    height: 36px;
    padding-inline: 12px;
    font-size: 13.5px;
    white-space: nowrap;
  }

  .map-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 40px;
  }

  .map-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .map-head h2,
  .milestone-head h2 {
    font-size: 20px;
  }

  .map-legend {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px 14px;
  }

  .map-legend > span {
    gap: 6px;
  }

  .legend-node {
    display: inline-block;
    width: 10px;
    height: 10px;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--sur);
  }

  .legend-node.done {
    border-color: var(--ok);
    background: var(--ok-soft);
  }

  .legend-node.current {
    border: 2px solid var(--acc);
    background: var(--acc-soft);
  }

  .legend-node.locked {
    border-color: var(--ink3);
    border-style: dashed;
    background: var(--bg);
  }

  .legend-diamond {
    display: inline-block;
    width: 10px;
    height: 10px;
    flex: none;
    border: 1px solid var(--ink3);
    background: var(--sur);
    transform: rotate(45deg);
  }

  .map-scroll {
    max-width: 100%;
    padding: 12px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .map-scroll:focus-visible {
    outline-offset: 3px;
  }

  .map-scroll :global(.path-svg) {
    display: block;
    max-width: none;
  }

  .path-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    padding-bottom: 72px;
  }

  .milestone-lists,
  .milestone-list,
  .milestone-items,
  .path-rail,
  .rail-panel {
    display: flex;
    flex-direction: column;
  }

  .milestone-lists,
  .milestone-list {
    gap: 14px;
    min-width: 0;
  }

  .milestone-list[data-state='hidden'] {
    display: none;
  }

  .milestone-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .milestone-items {
    gap: 8px;
  }

  .item {
    min-width: 0;
  }

  a.item {
    color: var(--ink);
    transition: border-color var(--t-state) var(--ease);
  }

  a.item:hover {
    border-color: var(--ink3);
    color: var(--ink);
  }

  .item[data-state='cur'] {
    border-color: var(--acc);
    box-shadow: 0 0 0 2px var(--acc-soft);
  }

  .item[data-state='done'] {
    border-color: var(--ok);
  }

  .item[data-state='lock'] {
    border-style: dashed;
    background: var(--bg);
    color: var(--ink3);
  }

  .soon-row {
    border-style: dashed;
    background: transparent;
    color: var(--ink2);
  }

  .item-title {
    min-width: 0;
    flex: 1;
  }

  .checkpoint-row {
    border-style: dashed;
    background: transparent;
    color: var(--ink2);
  }

  .checkpoint-row[data-state='passed'] {
    border-color: var(--ok);
  }

  .checkpoint-row[data-state='locked'] {
    color: var(--ink3);
  }

  .rationale {
    margin: 8px 0 0;
    color: var(--ink2);
    font-size: 14px;
    line-height: 1.6;
  }

  .rationale strong {
    color: var(--ink);
    font-weight: 600;
  }

  .path-rail {
    gap: 20px;
    min-width: 0;
  }

  .rail-panel {
    gap: 8px;
    padding: 16px 18px;
  }

  .rail-panel h2 {
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .rail-panel ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-panel li,
  .rail-panel p {
    margin: 0;
    color: var(--ink2);
    font-size: 14px;
    line-height: 1.55;
  }

  .plan-seg {
    align-self: flex-start;
  }

  .rail-actions {
    gap: 8px;
  }

  .rail-actions :global(.btn) {
    flex: 1;
    height: 36px;
    padding-inline: 10px;
    font-size: 13px;
    white-space: nowrap;
  }

  .ask-ai {
    border-color: var(--acc2);
  }

  .ask-ai h2 {
    color: var(--acc2);
  }

  @media (max-width: 1199px) {
    .map-scroll {
      overflow-x: auto;
    }
  }

  @media (max-width: 1023px) {
    .path-header,
    .path-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .path-progress-card {
      max-width: 440px;
    }

    .map-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .map-legend {
      justify-content: flex-start;
    }

    .path-rail {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  @media (max-width: 767px) {
    .path-header {
      gap: 22px;
      padding-top: 32px;
      padding-bottom: 24px;
    }

    h1 {
      font-size: 32px;
    }

    .path-intro > p {
      font-size: 15px;
    }

    .path-progress-card {
      max-width: none;
      padding: 14px;
    }

    .path-progress-copy > span {
      font-size: 13px;
    }

    .map-section {
      padding-bottom: 32px;
    }

    .map-legend {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .map-scroll {
      margin-inline: 0;
      padding: 8px;
    }

    .path-body {
      gap: 32px;
      padding-bottom: 40px;
    }

    .milestone-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .item {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 8px;
      padding: 11px 12px;
    }

    .item .lbl {
      width: 100%;
      margin-left: 0;
      padding-left: 0;
    }

    .path-rail {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
