---
/**
 * `/tracks/` — the index the home page's "All tracks" link points at. Every track in the
 * registry, grouped the way the registry classifies them, so the page needs no list of its own.
 *
 * The six flagship tracks come first under their own heading — docs/design/flagship-tracks.md:
 * nothing is removed, but the page promises depth only where the corpus has it, and every card
 * carries the counts behind that promise.
 */
import Base from '@/layouts/Base.astro';
import TrackCard from '@/components/TrackCard.astro';
import { t } from '@/i18n';
import { FLAGSHIP_TRACKS, TRACKS, type Track, type TrackKind } from '@/data/tracks';
import { listTopics, topicMeta } from '@/lib/content';
import { listPracticeItems } from '@/lib/practice';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

/** Below this many published topics a track is a preview, not a peer of the full ones. */
const PREVIEW_BELOW = 8;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/tracks/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'tracks.title'),
  description: t(locale, 'tracks.sub'),
  kind: 'page',
});

const GROUPS: { kind: TrackKind; key: 'tracks.languages' | 'tracks.domains' | 'tracks.pillars' }[] = [
  { kind: 'language', key: 'tracks.languages' },
  { kind: 'domain', key: 'tracks.domains' },
  { kind: 'pillar', key: 'tracks.pillars' },
];

/** Published topics per track, in this locale: the honest measure of what a hub has behind it. */
const published = new Map<string, number>();
for (const topic of await listTopics(locale)) {
  const { track } = topicMeta(topic);
  published.set(track, (published.get(track) ?? 0) + 1);
}

/** Practice items per track, the second half of the count each card states. */
const exercises = new Map<string, number>();
for (const item of await listPracticeItems()) {
  exercises.set(item.track, (exercises.get(item.track) ?? 0) + 1);
}

const entry = (track: Track) => ({
  track,
  preview: (published.get(track.slug) ?? 0) < PREVIEW_BELOW,
  counts: t(locale, 'tracks.counts', {
    topics: published.get(track.slug) ?? 0,
    exercises: exercises.get(track.slug) ?? 0,
  }),
});

const flagship = FLAGSHIP_TRACKS.map(entry);

const groups = GROUPS.map((group) => ({
  label: t(locale, group.key),
  tracks: TRACKS.filter((track) => track.kind === group.kind && !track.flagship).map(entry),
})).filter((group) => group.tracks.length > 0);

const intro = t(locale, 'tracks.intro', {
  flagship: flagship.length,
  rest: TRACKS.length - flagship.length,
});
---

<!-- Pagefind-ignored, as the track hubs are: the index is for topics and terms, and a listing
  page has nothing to say that its entries do not say better. -->
<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap page">
    <header class="head">
      <h1>{t(locale, 'tracks.title')}</h1>
      <p>{intro}</p>
    </header>

    <section class="group">
      <div class="group-head">
        <h2 class="lbl">{t(locale, 'tracks.flagship')}</h2>
        <span class="lbl hint">{t(locale, 'tracks.flagshipHint')}</span>
      </div>
      <div class="grid">
        {
          flagship.map((item) => (
            <TrackCard track={item.track} locale={locale} preview={item.preview} counts={item.counts} />
          ))
        }
      </div>
    </section>

    <section class="rest">
      <div class="group-head rest-head">
        <h2>{t(locale, 'tracks.more')}</h2>
        <span class="lbl hint">{t(locale, 'tracks.moreHint')}</span>
      </div>
      {
        groups.map((group) => (
          <section class="group">
            <h3 class="lbl">{group.label}</h3>
            <div class="grid">
              {group.tracks.map((item) => (
                <TrackCard track={item.track} locale={locale} preview={item.preview} counts={item.counts} />
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .head p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 620px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* The two sections of the page: the six deep tracks, then everything else. */
  .rest {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .rest-head {
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }

  .hint {
    color: var(--ink3);
  }

  h2.lbl,
  h3 {
    /* A group divider, not a headline: the mono label from the mockups' sidebars. */
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rest-head h2 {
    font-size: 22px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .page {
      gap: 28px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 32px;
    }

    .head p {
      font-size: 15px;
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
