---
/**
 * `/tracks/` — the index the home page's "All tracks" link points at. Every track in the
 * registry, grouped the way the registry classifies them, so the page needs no list of its own.
 */
import Base from '@/layouts/Base.astro';
import TrackCard from '@/components/TrackCard.astro';
import { t } from '@/i18n';
import { TRACKS, type TrackKind } from '@/data/tracks';
import { listTopics, topicMeta } from '@/lib/content';
import { buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

/** Below this many published topics a track is a preview, not a peer of the full ones. */
const PREVIEW_BELOW = 8;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/tracks/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'tracks.title'),
  description: t(locale, 'tracks.sub'),
  kind: 'page',
});

const GROUPS: { kind: TrackKind; key: 'tracks.languages' | 'tracks.domains' | 'tracks.pillars' }[] = [
  { kind: 'language', key: 'tracks.languages' },
  { kind: 'domain', key: 'tracks.domains' },
  { kind: 'pillar', key: 'tracks.pillars' },
];

/** Published topics per track, in this locale: the honest measure of what a hub has behind it. */
const published = new Map<string, number>();
for (const topic of await listTopics(locale)) {
  const { track } = topicMeta(topic);
  published.set(track, (published.get(track) ?? 0) + 1);
}

const groups = GROUPS.map((group) => ({
  label: t(locale, group.key),
  tracks: TRACKS.filter((track) => track.kind === group.kind).map((track) => ({
    track,
    preview: (published.get(track.slug) ?? 0) < PREVIEW_BELOW,
  })),
}));
---

<!-- Pagefind-ignored, as the track hubs are: the index is for topics and terms, and a listing
  page has nothing to say that its entries do not say better. -->
<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <div class="wrap page">
    <header class="head">
      <h1>{t(locale, 'tracks.title')}</h1>
      <p>{t(locale, 'tracks.sub')}</p>
    </header>

    {
      groups.map((group) => (
        <section class="group">
          <h2 class="lbl">{group.label}</h2>
          <div class="grid">
            {group.tracks.map((entry) => (
              <TrackCard track={entry.track} locale={locale} preview={entry.preview} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .head p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 620px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h2 {
    /* A group divider, not a headline: the mono label from the mockups' sidebars. */
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .page {
      gap: 28px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    h1 {
      font-size: 32px;
    }

    .head p {
      font-size: 15px;
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
