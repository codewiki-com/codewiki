---
/**
 * The home page, shared by `/` and `/zh/`.
 *
 * The first screen hands the visitor a piece of generated code to review — docs/design/
 * home-hero-kata.md: the hero's right column is the daily kata, and the search row under it
 * opens the command palette. The article library (features, tracks, modes, the bilingual and
 * Ask-AI band) follows on the second screen, as in docs/design/mockups/Main.dc.html.
 *
 * Everything visible is either a `t()` string or real content, rendered as ordinary links and
 * server-side markup, so the page works with no JavaScript at all.
 */
import { getCollection } from 'astro:content';

import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Kbd from '@/components/Kbd.astro';
import Tag from '@/components/Tag.astro';
import TrackCard from '@/components/TrackCard.astro';
import DailyKata from '@/islands/DailyKata';
import PersonalStrip from '@/islands/PersonalStrip';
import { t } from '@/i18n';
import { FLAGSHIP_TRACKS, getTrack, TRACKS } from '@/data/tracks';
import { VERSIONS } from '@/data/versions';
import { listTopics, topicMeta } from '@/lib/content';
import { dailyKataData, HERO_PEEK_LINES, HERO_PEEK_LINES_SMALL } from '@/lib/daily-kata';
import { listPracticeItems } from '@/lib/practice';
import { buildHead } from '@/lib/seo';
import { localizePath, topicUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: '',
  description: t(locale, 'home.sub'),
  kind: 'home',
});

/* ---- what the search row promises ------------------------------------------------------ */

/**
 * The numbers in the search placeholder are counted here rather than written into the
 * dictionary, so the row can never claim more than the build actually holds.
 */
const allTopics = await listTopics(locale);
const number = new Intl.NumberFormat(locale === 'zh' ? 'zh-Hans-CN' : 'en-US');
const searchAll = t(locale, 'home.searchAll', {
  topics: number.format(allTopics.length),
  terms: number.format((await getCollection('glossary')).length),
  exercises: number.format((await listPracticeItems()).length),
});

/* ---- personal strip -------------------------------------------------------------------- */

/** Every public topic of this locale, so the island can name what the visitor was reading. */
const titles = Object.fromEntries(
  allTopics.map((topic) => {
    const { track: trackSlug, slug } = topicMeta(topic);
    return [
      `${trackSlug}/${slug}`,
      {
        title: topic.data.title,
        track: getTrack(trackSlug)?.name[locale] ?? trackSlug,
        url: topicUrl(trackSlug, slug, locale),
      },
    ];
  }),
);

/* ---- daily kata ------------------------------------------------------------------------ */

const daily = await dailyKataData(locale, {
  peekLines: HERO_PEEK_LINES,
  peekLinesSmall: HERO_PEEK_LINES_SMALL,
});

/** "Start reviewing" and the card's own button are one destination: today's kata. */
const kataHref = daily.entries[0]?.kataUrl ?? localizePath('/practice/', locale);

/* ---- static copy ----------------------------------------------------------------------- */

/**
 * The bilingual demo sentence. It is sample content rather than UI copy — both languages appear
 * side by side on both locales' home pages, so it is not a translated string and does not belong
 * in the dictionaries. Taken verbatim from the mockup.
 */
const SAMPLE = {
  en: {
    lead: 'A ',
    term: 'closure',
    rest: ' is a function that remembers the variables of the scope where it was created, even after that scope has finished.',
  },
  zh: {
    lead: '',
    term: '闭包',
    rest: '是一个函数，它记住了自己被创建时所在作用域中的变量，即使那个作用域已经结束。',
  },
};

const FEATURES = [1, 2, 3, 4, 5, 6] as const;
const MODES = ['learn', 'lookup', 'practice'] as const;
const PROMPTS = [1, 2, 3] as const;

/* The slashes and arrows are template chrome, not translated copy. */
const eyebrow = `// ${t(locale, 'home.eyebrow')}`;
const allTracks = `${t(locale, 'home.allTracks', { count: TRACKS.length })} →`;
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <!-- HERO: the review kata is the first screen (docs/design/home-hero-kata.md) -->
  <div class="wrap hero">
    <div class="hero-text">
      <span class="lbl eyebrow">{eyebrow}</span>
      <h1>{t(locale, 'home.h1')}</h1>
      <p class="sub">{t(locale, 'home.sub')}</p>
      <div class="actions">
        <Button href={kataHref}>{t(locale, 'home.startReviewing')}</Button>
        <Button variant="ghost" href={localizePath('/tracks/', locale)}>
          {t(locale, 'home.browseTracks')}
        </Button>
      </div>
      <a class="lbl llms" href="/llms.txt">{t(locale, 'footer.llms')}</a>
    </div>

    <div class="hero-kata">
      <!-- Server-rendered for the build day; hydrated only to rotate and to mark it done. -->
      <DailyKata client:idle locale={locale} variant="hero" {...daily} />
    </div>

    <div class="hero-verified">
      <span class="lbl">{t(locale, 'home.verified')}</span>
      <div class="chips">{VERSIONS.map((version) => <Tag>{version}</Tag>)}</div>
    </div>
  </div>

  <!-- SEARCH ROW (Task 15 attaches the live palette to `data-palette-open`) -->
  <div class="wrap search-row">
    <button type="button" class="panel searchbar" data-palette-open>
      <Icon name="search" size={18} />
      <span class="searchbar-text">{searchAll}</span>
      <Kbd>{t(locale, 'nav.searchHint')}</Kbd>
    </button>
  </div>

  <!-- PERSONAL STRIP (local data only; renders nothing for a first-time visitor) -->
  <PersonalStrip
    client:idle
    locale={locale}
    titles={titles}
    reviewUrl={localizePath('/practice/flashcards/', locale)}
    labels={{
      continue: t(locale, 'home.continue'),
      recall: t(locale, 'home.recall'),
      review: t(locale, 'home.review'),
      due: t(locale, 'home.due', { count: '{count}' }),
      progress: t(locale, 'home.progress', { title: '{title}' }),
    }}
  />

  <!-- TRACKS: the six with the deepest coverage (docs/design/flagship-tracks.md) -->
  <div class="wrap tracks">
    <div class="section-head">
      <h2>{t(locale, 'home.startTrack')}</h2>
      <a class="more" href={localizePath('/tracks/', locale)}>{allTracks}</a>
    </div>
    <div class="track-grid">
      {FLAGSHIP_TRACKS.map((track) => <TrackCard track={track} locale={locale} />)}
    </div>
  </div>

  <!-- FEATURE GRID -->
  <div class="wrap">
    <div class="features">
      {
        FEATURES.map((n) => (
          <div class="cell">
            <span class="num">{String(n).padStart(2, '0')}</span>
            <span class="t">{t(locale, `home.feature.${n}.title`)}</span>
            <span class="d">{t(locale, `home.feature.${n}.desc`)}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- MODES -->
  <div class="wrap">
    <div class="modes">
      {
        MODES.map((mode) => (
          <div class="mode">
            <span class="num">{t(locale, `home.mode.${mode}.label`)}</span>
            <h3>{t(locale, `home.mode.${mode}.title`)}</h3>
            <p>{t(locale, `home.mode.${mode}.desc`)}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- BILINGUAL + ASK AI -->
  <div class="wrap">
    <div class="panel band">
      <div class="half">
        <span class="lbl label-acc">{t(locale, 'home.bilingual.label')}</span>
        <h3>{t(locale, 'home.bilingual.title')}</h3>
        <div class="pair">
          <p class="sample" lang="en">
            {SAMPLE.en.lead}<span class="term">{SAMPLE.en.term}</span>{SAMPLE.en.rest}
          </p>
          <p class="sample zh" lang="zh-Hans">
            {SAMPLE.zh.lead}<span class="term">{SAMPLE.zh.term}</span>{SAMPLE.zh.rest}
          </p>
        </div>
      </div>
      <div class="half">
        <span class="lbl label-acc2">{t(locale, 'home.ai.label')}</span>
        <h3>{t(locale, 'home.ai.title')}</h3>
        <div class="prompts">
          {
            PROMPTS.map((n) => (
              <div class="row prompt">
                <span class="prompt-text">{t(locale, `home.prompt.${n}`)}</span>
                <span class="lbl">{t(locale, 'home.promptMeta')}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  /* ---- hero ---- */

  /* Two columns: the promise on the left, today's kata on the right. The verified chips are a
     grid item of their own so a phone can put them after the card, where the first scroll
     shows code rather than a version list. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 40px;
    padding-top: 76px;
    padding-bottom: 28px;
    align-items: start;
  }

  .hero-text {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 24px;
  }

  .hero-kata {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-width: 0;
  }

  .hero-verified {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .eyebrow {
    color: var(--acc);
  }

  h1 {
    font-size: 62px;
    line-height: 1.04;
  }

  .sub {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 540px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* The llms.txt affordance is a footnote to the hero text, not a third call to action. */
  .llms {
    align-self: flex-start;
    margin-top: -12px;
  }

  a.llms:hover {
    color: var(--acc);
  }

  .chips {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* ---- search row ---- */

  .search-row {
    padding-bottom: 64px;
  }

  .searchbar {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    height: 52px;
    padding: 0 16px;
    text-align: left;
    /* The search glyph strokes with `currentColor`. */
    color: var(--ink3);
    transition:
      border-color var(--t-state) var(--ease),
      color var(--t-state) var(--ease);
  }

  .searchbar:hover {
    border-color: var(--ink3);
    color: var(--ink2);
  }

  .searchbar-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 15px;
    color: var(--ink2);
  }

  /* ---- feature grid ---- */

  /* The 1px gaps are the grid's own background showing between the cells. */
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: 72px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-8);
    overflow: hidden;
  }

  /* ---- tracks ---- */

  .tracks {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 72px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  h2 {
    font-size: 30px;
  }

  .more {
    font-size: 14px;
    flex: none;
  }

  .track-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  /* ---- modes ---- */

  /* The rule sits inside the container so it stops at the content column
     rather than running into the gutters. */
  .modes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 72px;
    border-top: 1px solid var(--line);
  }

  .mode {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mode h3 {
    font-size: 22px;
  }

  .mode p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink2);
  }

  /* ---- bilingual + ask AI ---- */

  .band {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 64px;
    overflow: hidden;
  }

  .half {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
  }

  .half:first-child {
    border-right: 1px solid var(--line);
  }

  .half h3 {
    font-size: 24px;
  }

  .label-acc {
    color: var(--acc);
  }

  .label-acc2 {
    color: var(--acc2);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .sample {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    padding: 14px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink);
    background: var(--bg);
  }

  .sample.zh {
    line-height: 1.8;
  }

  .prompts {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prompt {
    justify-content: space-between;
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    background: var(--bg);
  }

  .prompt-text {
    min-width: 0;
  }

  .prompt .lbl {
    flex: none;
  }

  /* ---- responsive ---- */

  @media (max-width: 1023px) {
    /* One column, in the order docs/design/home-hero-kata.md asks for: promise, card, chips. */
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-top: 48px;
    }

    .hero-text,
    .hero-kata,
    .hero-verified {
      grid-column: auto;
      grid-row: auto;
    }

    .hero-text {
      padding-top: 0;
    }

    h1 {
      font-size: 48px;
    }

    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .track-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .modes {
      gap: 28px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 32px;
      padding-bottom: 28px;
      gap: 24px;
    }

    h1 {
      font-size: 38px;
      line-height: 1.08;
    }

    .sub {
      font-size: 15.5px;
    }

    .hero-text {
      gap: 16px;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .search-row {
      padding-bottom: 28px;
    }

    .searchbar {
      height: 48px;
      padding: 0 12px;
      gap: 10px;
    }

    .searchbar-text {
      font-size: 14px;
    }

    .features {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 28px;
    }

    .tracks {
      gap: 12px;
      padding-bottom: 28px;
    }

    h2 {
      font-size: 22px;
    }

    .track-grid {
      gap: 8px;
    }

    .modes {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 28px;
      padding-bottom: 28px;
      gap: 24px;
    }

    .band {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 28px;
    }

    .half {
      padding: 18px;
    }

    .half:first-child {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .half h3 {
      font-size: 20px;
    }

    .pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .prompt {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
