---
/**
 * The home page, shared by `/` and `/zh/`. Section for section it is
 * docs/design/mockups/Main.dc.html: hero + static command palette, the personal strip, the six
 * feature cells, the twelve featured tracks, the three modes, and the bilingual / Ask-AI band.
 *
 * Everything visible is either a `t()` string or real content: the palette rows are the reviewed
 * topics, the glossary term and the quiz item that actually exist, rendered as ordinary links so
 * the page works with no JavaScript at all.
 */
import { getEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Tag from '@/components/Tag.astro';
import TrackCard from '@/components/TrackCard.astro';
import PersonalStrip from '@/islands/PersonalStrip';
import { t } from '@/i18n';
import { getSection, getTrack, HOME_TRACKS } from '@/data/tracks';
import { VERSIONS } from '@/data/versions';
import { listTopics, topicMeta } from '@/lib/content';
import type { QuizItem } from '@/schemas/quiz';
import { buildHead } from '@/lib/seo';
import { localizePath, topicUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const other: Locale = locale === 'en' ? 'zh' : 'en';
const currentPath = localizePath('/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: '',
  description: t(locale, 'home.sub'),
  kind: 'home',
});

/* ---- palette rows ---------------------------------------------------------------------- */

const reviewed = await listTopics(locale, { status: 'reviewed' });

const topicRows = reviewed.map((topic) => {
  const { track: trackSlug, slug } = topicMeta(topic);
  const track = getTrack(trackSlug);
  const section = getSection(trackSlug, topic.data.section);
  return {
    glyph: track?.glyph ?? trackSlug,
    title: topic.data.title,
    meta: [track?.name[locale], section?.name[locale]].filter(Boolean).join(' · '),
    url: topicUrl(trackSlug, slug, locale),
  };
});

const term = await getEntry('glossary', 'closure');

const quiz = await getEntry('quizzes', 'python/closures');
const quizItems: QuizItem[] = quiz?.data.items ?? [];
const quizItem = quizItems.find((item) => item.type === 'predict') ?? quizItems[0];
const quizTopic = getTrack(quiz?.data.topic.split('/')[0] ?? '');

/* ---- personal strip -------------------------------------------------------------------- */

/** Every public topic of this locale, so the island can name what the visitor was reading. */
const titles = Object.fromEntries(
  (await listTopics(locale)).map((topic) => {
    const { track: trackSlug, slug } = topicMeta(topic);
    return [
      `${trackSlug}/${slug}`,
      {
        title: topic.data.title,
        track: getTrack(trackSlug)?.name[locale] ?? trackSlug,
        url: topicUrl(trackSlug, slug, locale),
      },
    ];
  }),
);

/* ---- static copy ----------------------------------------------------------------------- */

/**
 * The bilingual demo sentence. It is sample content rather than UI copy — both languages appear
 * side by side on both locales' home pages, so it is not a translated string and does not belong
 * in the dictionaries. Taken verbatim from the mockup.
 */
const SAMPLE = {
  en: {
    lead: 'A ',
    term: 'closure',
    rest: ' is a function that remembers the variables of the scope where it was created, even after that scope has finished.',
  },
  zh: {
    lead: '',
    term: '闭包',
    rest: '是一个函数，它记住了自己被创建时所在作用域中的变量，即使那个作用域已经结束。',
  },
};

const FEATURES = [1, 2, 3, 4, 5, 6] as const;
const MODES = ['learn', 'lookup', 'practice'] as const;
const PROMPTS = [1, 2, 3] as const;

const tracks = HOME_TRACKS.map((slug) => getTrack(slug)).filter((track) => track !== undefined);

/* The slashes, arrows and the `esc` hint are template chrome, not translated copy. */
const eyebrow = `// ${t(locale, 'home.eyebrow')}`;
const allTracks = `${t(locale, 'home.allTracks')} →`;
const searchLabel = t(locale, 'nav.search');
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <!-- HERO -->
  <div class="wrap hero">
    <div class="hero-text">
      <span class="lbl eyebrow">{eyebrow}</span>
      <h1>{t(locale, 'home.h1')}</h1>
      <p class="sub">{t(locale, 'home.sub')}</p>
      <div class="actions">
        <Button href={localizePath('/paths/', locale)}>{t(locale, 'home.startPath')}</Button>
        <Button variant="ghost" href={localizePath('/tracks/', locale)}>
          {t(locale, 'home.browseTracks')}
        </Button>
        <Button variant="ghost" class="mono llms" href="/llms.txt">{t(locale, 'footer.llms')}</Button>
      </div>
      <div class="verified">
        <span class="lbl">{t(locale, 'home.verified')}</span>
        <div class="chips">{VERSIONS.map((version) => <Tag>{version}</Tag>)}</div>
      </div>
    </div>

    <!-- COMMAND PALETTE (static; Task 15 attaches the live one to `data-palette-open`) -->
    <div class="hero-palette">
      <div class="panel palette">
        <button type="button" class="palette-input" data-palette-open aria-label={searchLabel}>
          <Icon name="search" size={18} />
          <span class="query">
            {t(locale, 'home.palette.query')}<span class="caret" aria-hidden="true"></span>
          </span>
          <Tag>esc</Tag>
        </button>

        <div class="palette-rows">
          <span class="lbl group">{t(locale, 'search.topics')}</span>
          {
            topicRows.map((row, index) => (
              <a class:list={['row', index === 0 && 'on']} href={row.url}>
                <Tag variant="acc">{row.glyph}</Tag>
                <span class="row-title">{row.title}</span>
                <span class="lbl row-meta">{row.meta}</span>
                {index === 0 && (
                  <span class="lbl enter" aria-hidden="true">
                    ↵
                  </span>
                )}
              </a>
            ))
          }

          {
            term && (
              <Fragment>
                <span class="lbl group">{t(locale, 'search.glossary')}</span>
                <a class="row" href={localizePath(`/glossary/${term.id}/`, locale)}>
                  <Tag variant="ok">term</Tag>
                  <span class="row-title">
                    {term.data[locale]}&#32;
                    <span class="alt" lang={other === 'zh' ? 'zh-Hans' : 'en'}>
                      {term.data[other]}
                    </span>
                  </span>
                  <span class="lbl row-meta">{term.data.short[locale]}</span>
                </a>
              </Fragment>
            )
          }

          {
            quiz && quizItem && (
              <Fragment>
                <span class="lbl group">{t(locale, 'search.practice')}</span>
                <a class="row" href={localizePath(`/${quiz.data.topic}/`, locale)}>
                  <Tag>quiz</Tag>
                  <span class="row-title">{quizItem.prompt[locale]}</span>
                  <span class="lbl row-meta">{quizTopic?.name[locale]}</span>
                </a>
              </Fragment>
            )
          }
        </div>

        <div class="lbl hints" aria-hidden="true">
          <span>↑↓ {t(locale, 'home.palette.move')}</span>
          <span>↵ {t(locale, 'home.palette.open')}</span>
          <span>⌘↵ {t(locale, 'home.palette.playground')}</span>
          <span class="offline">{t(locale, 'home.palette.offline')}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- PERSONAL STRIP (local data only; renders nothing for a first-time visitor) -->
  <PersonalStrip
    client:idle
    titles={titles}
    reviewUrl={localizePath('/practice/flashcards/', locale)}
    labels={{
      continue: t(locale, 'home.continue'),
      recall: t(locale, 'home.recall'),
      review: t(locale, 'home.review'),
      due: t(locale, 'home.due', { count: '{count}' }),
      progress: t(locale, 'home.progress', { title: '{title}' }),
    }}
  />

  <!-- FEATURE GRID -->
  <div class="wrap">
    <div class="features">
      {
        FEATURES.map((n) => (
          <div class="cell">
            <span class="num">{String(n).padStart(2, '0')}</span>
            <span class="t">{t(locale, `home.feature.${n}.title`)}</span>
            <span class="d">{t(locale, `home.feature.${n}.desc`)}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- TRACKS -->
  <div class="wrap tracks">
    <div class="section-head">
      <h2>{t(locale, 'home.tracks')}</h2>
      <a class="more" href={localizePath('/tracks/', locale)}>{allTracks}</a>
    </div>
    <div class="track-grid">
      {tracks.map((track) => <TrackCard track={track} locale={locale} />)}
    </div>
  </div>

  <!-- MODES -->
  <div class="wrap">
    <div class="modes">
      {
        MODES.map((mode) => (
          <div class="mode">
            <span class="num">{t(locale, `home.mode.${mode}.label`)}</span>
            <h3>{t(locale, `home.mode.${mode}.title`)}</h3>
            <p>{t(locale, `home.mode.${mode}.desc`)}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- BILINGUAL + ASK AI -->
  <div class="wrap">
    <div class="panel band">
      <div class="half">
        <span class="lbl label-acc">{t(locale, 'home.bilingual.label')}</span>
        <h3>{t(locale, 'home.bilingual.title')}</h3>
        <div class="pair">
          <p class="sample" lang="en">
            {SAMPLE.en.lead}<span class="term">{SAMPLE.en.term}</span>{SAMPLE.en.rest}
          </p>
          <p class="sample zh" lang="zh-Hans">
            {SAMPLE.zh.lead}<span class="term">{SAMPLE.zh.term}</span>{SAMPLE.zh.rest}
          </p>
        </div>
      </div>
      <div class="half">
        <span class="lbl label-acc2">{t(locale, 'home.ai.label')}</span>
        <h3>{t(locale, 'home.ai.title')}</h3>
        <div class="prompts">
          {
            PROMPTS.map((n) => (
              <div class="row prompt">
                <span class="prompt-text">{t(locale, `home.prompt.${n}`)}</span>
                <span class="lbl">{t(locale, 'home.promptMeta')}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  /* ---- hero ---- */

  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
    padding-top: 76px;
    padding-bottom: 40px;
    align-items: start;
  }

  .hero-text {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 24px;
  }

  .eyebrow {
    color: var(--acc);
  }

  h1 {
    font-size: 62px;
    line-height: 1.04;
  }

  .sub {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 540px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .llms {
    font-size: 13px;
  }

  .verified {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
  }

  .chips {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* ---- command palette ---- */

  .hero-palette {
    grid-column: span 6;
  }

  .palette {
    overflow: hidden;
    box-shadow: var(--glow);
  }

  .palette-input {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    text-align: left;
    /* The search glyph strokes with `currentColor`. */
    color: var(--ink3);
  }

  .query {
    flex: 1;
    min-width: 0;
    font-size: 16px;
    color: var(--ink);
  }

  /* The mockup's blinking-free caret: a 1.5px rule, no animation. */
  .caret {
    display: inline-block;
    width: 0;
    height: 17px;
    margin-left: 2px;
    border-left: 1.5px solid var(--acc);
    vertical-align: -3px;
  }

  .palette-rows {
    display: flex;
    flex-direction: column;
    padding: 6px 0;
  }

  .group {
    padding: 10px 14px 4px;
  }

  .group:first-child {
    padding-top: 8px;
  }

  .row {
    color: var(--ink);
    transition: background-color var(--t-state) var(--ease);
  }

  a.row:hover {
    color: var(--ink);
    background: var(--sur2);
  }

  .row.on .row-title {
    font-weight: 500;
  }

  /* The title keeps its width and the meta gives way, so a long glossary
     definition truncates instead of eating into the name beside it. The cap is
     the guard for the other direction, a title longer than the panel. */
  .row-title {
    flex: 1 0 auto;
    max-width: 72%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row-meta {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: right;
  }

  .alt {
    color: var(--ink3);
  }

  .enter {
    flex: none;
  }

  .hints {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .offline {
    margin-left: auto;
  }

  /* ---- feature grid ---- */

  /* The 1px gaps are the grid's own background showing between the cells. */
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: 72px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-8);
    overflow: hidden;
  }

  /* ---- tracks ---- */

  .tracks {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 72px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  h2 {
    font-size: 30px;
  }

  .more {
    font-size: 14px;
    flex: none;
  }

  .track-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  /* ---- modes ---- */

  /* The rule sits inside the container so it stops at the content column
     rather than running into the gutters. */
  .modes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 72px;
    border-top: 1px solid var(--line);
  }

  .mode {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mode h3 {
    font-size: 22px;
  }

  .mode p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink2);
  }

  /* ---- bilingual + ask AI ---- */

  .band {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 64px;
    overflow: hidden;
  }

  .half {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
  }

  .half:first-child {
    border-right: 1px solid var(--line);
  }

  .half h3 {
    font-size: 24px;
  }

  .label-acc {
    color: var(--acc);
  }

  .label-acc2 {
    color: var(--acc2);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .sample {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    padding: 14px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink);
    background: var(--bg);
  }

  .sample.zh {
    line-height: 1.8;
  }

  .prompts {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prompt {
    justify-content: space-between;
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    background: var(--bg);
  }

  .prompt-text {
    min-width: 0;
  }

  .prompt .lbl {
    flex: none;
  }

  /* ---- responsive ---- */

  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-top: 48px;
    }

    .hero-text,
    .hero-palette {
      grid-column: auto;
    }

    .hero-text {
      padding-top: 0;
    }

    h1 {
      font-size: 48px;
    }

    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .track-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .modes {
      gap: 28px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 32px;
      padding-bottom: 28px;
      gap: 24px;
    }

    h1 {
      font-size: 38px;
      line-height: 1.08;
    }

    .sub {
      font-size: 15.5px;
    }

    .hero-text {
      gap: 16px;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    /* The palette is a preview of a keyboard-first control; the mobile mockup
       drops it and offers the search button in the bar instead. */
    .hero-palette {
      display: none;
    }

    .features {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 28px;
    }

    .tracks {
      gap: 12px;
      padding-bottom: 28px;
    }

    h2 {
      font-size: 22px;
    }

    .track-grid {
      gap: 8px;
    }

    .modes {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 28px;
      padding-bottom: 28px;
      gap: 24px;
    }

    .band {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 28px;
    }

    .half {
      padding: 18px;
    }

    .half:first-child {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .half h3 {
      font-size: 20px;
    }

    .pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .prompt {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
