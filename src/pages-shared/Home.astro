---
/**
 * The home page, shared by `/` and `/zh/`.
 *
 * The first screen hands the visitor a piece of generated code to review — docs/design/
 * home-hero-kata.md: the hero's right column is the daily kata, and the search row under it
 * opens the command palette. The article library (features, tracks, modes and the
 * Ask-AI band) follows on the second screen, as in docs/design/mockups/Main.dc.html.
 *
 * Everything visible is either a `t()` string or real content, rendered as ordinary links and
 * server-side markup, so the page works with no JavaScript at all.
 */
import { getCollection } from 'astro:content';

import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Kbd from '@/components/Kbd.astro';
import PromptActions from '@/components/PromptActions.astro';
import Tag from '@/components/Tag.astro';
import TrackCard from '@/components/TrackCard.astro';
import DailyKata from '@/islands/DailyKata';
import PersonalStrip from '@/islands/PersonalStrip';
import { t } from '@/i18n';
import { FLAGSHIP_TRACKS, getTrack, TRACKS } from '@/data/tracks';
import { SITE } from '@/data/site';
import { VERSIONS } from '@/data/versions';
import { getTopic, listTopics, topicMeta } from '@/lib/content';
import { dailyKataData, HERO_PEEK_LINES, HERO_PEEK_LINES_SMALL } from '@/lib/daily-kata';
import { toPlainMarkdown } from '@/lib/markdown-twin';
import { listPracticeItems } from '@/lib/practice';
import { buildPrompt, type Preset } from '@/lib/prompts';
import { buildHead } from '@/lib/seo';
import { localizePath, topicUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = localizePath('/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: '',
  description: t(locale, 'home.sub'),
  kind: 'home',
});

/* ---- what the search row promises ------------------------------------------------------ */

/**
 * The numbers in the search placeholder are counted here rather than written into the
 * dictionary, so the row can never claim more than the build actually holds.
 */
const allTopics = await listTopics(locale);
const number = new Intl.NumberFormat(locale === 'zh' ? 'zh-Hans-CN' : 'en-US');
const searchAll = t(locale, 'home.searchAll', {
  topics: number.format(allTopics.length),
  terms: number.format((await getCollection('glossary')).length),
  exercises: number.format((await listPracticeItems()).length),
});

/* ---- personal strip -------------------------------------------------------------------- */

/** Every public topic of this locale, so the island can name what the visitor was reading. */
const titles = Object.fromEntries(
  allTopics.map((topic) => {
    const { track: trackSlug, slug } = topicMeta(topic);
    return [
      `${trackSlug}/${slug}`,
      {
        title: topic.data.title,
        track: getTrack(trackSlug)?.name[locale] ?? trackSlug,
        url: topicUrl(trackSlug, slug, locale),
      },
    ];
  }),
);

/* ---- daily kata ------------------------------------------------------------------------ */

const daily = await dailyKataData(locale, {
  peekLines: HERO_PEEK_LINES,
  peekLinesSmall: HERO_PEEK_LINES_SMALL,
});

/** "Start reviewing" and the card's own button are one destination: today's kata. */
const kataHref = daily.entries[0]?.kataUrl ?? localizePath('/practice/', locale);

/* ---- static copy ----------------------------------------------------------------------- */

/* ---- the showcase topic ---------------------------------------------------------------- */

/** The article the feature links and the Ask-AI prompts demonstrate on. */
const SHOWCASE = { track: 'python', slug: 'closures' } as const;
const showcase = await getTopic(SHOWCASE.track, SHOWCASE.slug, locale);
if (!showcase) throw new Error(`home: showcase topic ${SHOWCASE.track}/${SHOWCASE.slug} is missing`);
const showcaseHref = topicUrl(SHOWCASE.track, SHOWCASE.slug, locale);
const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const showcaseUrl = `${SITE.url}${showcaseHref}`;

/* The page as its Markdown twin, split at its `##` headings: [intro, ...sections]. */
const twin = toPlainMarkdown(showcase.body ?? '', {
  locale,
  title: showcase.data.title,
  url: showcaseUrl,
});
const sections = twin.split(/^(?=## )/m).slice(1);
const heading = (section: string) => section.slice(3, section.indexOf('\n')).trim();
const firstSection = sections[0] ?? twin;
const exampleSection = sections.find((section) => section.includes('```')) ?? firstSection;

/** Each home prompt is a real preset, scoped the way its wording promises. */
const PROMPT_SCOPES: Record<1 | 2 | 3, { preset: Preset; section: string; instruction?: string }> = {
  1: { preset: 'explain', section: firstSection },
  2: { preset: 'bugs', section: exampleSection },
  3: {
    preset: 'quiz',
    section: '',
    instruction:
      'Quiz me on this page one question at a time. Wait for each answer and tell me what I got wrong, and keep going until I have answered five questions correctly.',
  },
};

const prompts = ([1, 2, 3] as const).map((n) => {
  const scope = PROMPT_SCOPES[n];
  return {
    n,
    prompt: buildPrompt({
      preset: scope.preset,
      locale,
      title: showcase.data.title,
      url: showcaseUrl,
      section: scope.section ? heading(scope.section) : '',
      sectionText: scope.section || twin,
      language: 'Python',
      prerequisite: n === 1 ? 'loops' : undefined,
      presetInstruction: scope.instruction,
    }),
  };
});

const FEATURES = [
  { n: 1, href: localizePath('/playground/', locale) },
  { n: 2, href: showcaseHref },
  { n: 3, href: topicUrl(SHOWCASE.track, SHOWCASE.slug, otherLocale), hreflang: otherLocale },
  { n: 4, href: localizePath('/practice/', locale) },
  { n: 5, href: localizePath('/ai/prompt-builder/', locale) },
  { n: 6, href: showcaseHref },
] as const;
const MODES = [
  { mode: 'learn', href: localizePath('/paths/', locale) },
  { mode: 'lookup', href: localizePath('/cheatsheets/', locale) },
  { mode: 'practice', href: localizePath('/practice/', locale) },
] as const;

/* The slashes and arrows are template chrome, not translated copy. */
const eyebrow = `// ${t(locale, 'home.eyebrow')}`;
const allTracks = `${t(locale, 'home.allTracks', { count: TRACKS.length })} →`;
---

<Base locale={locale} head={head} currentPath={currentPath} pagefind="ignore">
  <!-- HERO: the review kata is the first screen (docs/design/home-hero-kata.md) -->
  <div class="wrap hero">
    <div class="hero-text">
      <span class="lbl eyebrow">{eyebrow}</span>
      <h1>{t(locale, 'home.h1')}</h1>
      <p class="sub">{t(locale, 'home.sub')}</p>
      <div class="actions">
        <Button href={kataHref}>{t(locale, 'home.startReviewing')}</Button>
        <Button variant="ghost" href={localizePath('/tracks/', locale)}>
          {t(locale, 'home.browseTracks')}
        </Button>
      </div>
    </div>

    <div class="hero-kata">
      <!-- Server-rendered for the build day; hydrated only to rotate and to mark it done. -->
      <DailyKata client:idle locale={locale} variant="hero" {...daily} />
    </div>

    <div class="hero-versions">
      <span class="lbl">{t(locale, 'home.versions')}</span>
      <div class="chips">
        {VERSIONS.map((version) => <Tag>{version}</Tag>)}
        <a class="tag lbl llms" href="/llms.txt">{t(locale, 'footer.llms')}</a>
      </div>
    </div>
  </div>

  <!-- SEARCH ROW (Task 15 attaches the live palette to `data-palette-open`) -->
  <div class="wrap search-row">
    <button type="button" class="panel searchbar" data-palette-open>
      <Icon name="search" size={18} />
      <span class="searchbar-text">{searchAll}</span>
      <Kbd>{t(locale, 'nav.searchHint')}</Kbd>
    </button>
  </div>

  <!-- PERSONAL STRIP (local data only; renders nothing for a first-time visitor) -->
  <PersonalStrip
    client:idle
    locale={locale}
    titles={titles}
    reviewUrl={localizePath('/practice/flashcards/', locale)}
    labels={{
      continue: t(locale, 'home.continue'),
      recall: t(locale, 'home.recall'),
      review: t(locale, 'home.review'),
      due: t(locale, 'home.due', { count: '{count}' }),
      progress: t(locale, 'home.progress', { title: '{title}' }),
    }}
  />

  <!-- TRACKS: the six with the deepest coverage (docs/design/flagship-tracks.md) -->
  <div class="wrap tracks">
    <div class="section-head">
      <h2>{t(locale, 'home.startTrack')}</h2>
      <a class="more" href={localizePath('/tracks/', locale)}>{allTracks}</a>
    </div>
    <div class="track-grid">
      {FLAGSHIP_TRACKS.map((track) => <TrackCard track={track} locale={locale} />)}
    </div>
  </div>

  <!-- FEATURE GRID -->
  <div class="wrap">
    <div class="features">
      {
        FEATURES.map((feature) => (
          <a
            class="cell"
            href={feature.href}
            hreflang={'hreflang' in feature ? (feature.hreflang === 'zh' ? 'zh-Hans' : 'en') : undefined}
          >
            <span class="num">{String(feature.n).padStart(2, '0')}</span>
            <span class="t">
              {t(locale, `home.feature.${feature.n}.title`)}
              <span class="go" aria-hidden="true">
                →
              </span>
            </span>
            <span class="d">{t(locale, `home.feature.${feature.n}.desc`)}</span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- MODES -->
  <div class="wrap">
    <div class="modes">
      {
        MODES.map(({ mode, href }) => (
          <a class="mode" href={href}>
            <span class="num">{t(locale, `home.mode.${mode}.label`)}</span>
            <h3>
              {t(locale, `home.mode.${mode}.title`)}
              <span class="go" aria-hidden="true">
                →
              </span>
            </h3>
            <p>{t(locale, `home.mode.${mode}.desc`)}</p>
          </a>
        ))
      }
    </div>
  </div>

  <!-- ASK AI -->
  <div class="wrap">
    <div class="panel band">
      <div class="ai-content">
        <span class="lbl label-acc2">{t(locale, 'home.ai.label')}</span>
        <h3>{t(locale, 'home.ai.title')}</h3>
        <p class="ai-example">
          {
            [
              t(locale, 'home.ai.example'),
              locale === 'en' ? ' ' : '',
              <a href={showcaseHref}>{showcase.data.title}</a>,
            ]
          }
        </p>
        <div class="prompts">
          {
            prompts.map(({ n, prompt }) => (
              <div class="row prompt">
                <span class="prompt-text">{t(locale, `home.prompt.${n}`)}</span>
                <PromptActions locale={locale} prompt={prompt} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  /* ---- hero ---- */

  /* Two columns: the promise on the left, today's kata on the right. The language-version chips are a
     grid item of their own so a phone can put them after the card, where the first scroll
     shows code rather than a version list. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 40px;
    padding-top: 76px;
    padding-bottom: 28px;
    align-items: start;
  }

  .hero-text {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 24px;
  }

  .hero-kata {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-width: 0;
  }

  .hero-versions {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .eyebrow {
    color: var(--acc);
  }

  h1 {
    font-size: 62px;
    line-height: 1.04;
  }

  .sub {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink2);
    max-width: 540px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  a.llms:hover {
    color: var(--acc);
  }

  .chips {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* ---- search row ---- */

  .search-row {
    padding-bottom: 64px;
  }

  .searchbar {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    height: 52px;
    padding: 0 16px;
    text-align: left;
    /* The search glyph strokes with `currentColor`. */
    color: var(--ink3);
    transition:
      border-color var(--t-state) var(--ease),
      color var(--t-state) var(--ease);
  }

  .searchbar:hover {
    border-color: var(--ink3);
    color: var(--ink2);
  }

  .searchbar-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 15px;
    color: var(--ink2);
  }

  /* ---- feature grid ---- */

  /* The 1px gaps are the grid's own background showing between the cells. */
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-bottom: 72px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-8);
    overflow: hidden;
  }

  /* ---- tracks ---- */

  .tracks {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 72px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  h2 {
    font-size: 30px;
  }

  .more {
    font-size: 14px;
    flex: none;
  }

  .track-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  /* ---- modes ---- */

  /* The rule sits inside the container so it stops at the content column
     rather than running into the gutters. */
  .modes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 72px;
    border-top: 1px solid var(--line);
  }

  .mode {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mode h3 {
    font-size: 22px;
  }

  .mode p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink2);
  }

  /* ---- ask AI ---- */

  .band {
    margin-bottom: 64px;
    overflow: hidden;
  }

  .ai-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
  }

  .ai-content h3 {
    font-size: 24px;
  }

  .label-acc2 {
    color: var(--acc2);
  }

  .prompts {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prompt {
    justify-content: space-between;
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    background: var(--bg);
  }

  .prompt-text {
    min-width: 0;
  }

  .prompt :global(.prompt-actions) {
    flex: none;
  }

  .ai-example {
    margin: -6px 0 0;
    font-size: 14px;
    color: var(--ink2);
  }

  .ai-example a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- links: whole feature tiles and mode columns ---- */

  a.cell,
  a.mode {
    color: var(--ink);
  }

  a.cell {
    transition: background var(--t-state) var(--ease);
  }

  a.cell:hover {
    background: var(--bg);
  }

  .go {
    display: inline-block;
    margin-left: 6px;
    color: var(--acc);
    transition: transform var(--t-state) var(--ease);
  }

  a.cell:hover .go,
  a.mode:hover .go {
    transform: translateX(3px);
  }

  a.mode:hover h3 {
    color: var(--acc);
  }

  /* ---- responsive ---- */

  @media (max-width: 1023px) {
    /* One column, in the order docs/design/home-hero-kata.md asks for: promise, card, chips. */
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding-top: 48px;
    }

    .hero-text,
    .hero-kata,
    .hero-versions {
      grid-column: auto;
      grid-row: auto;
    }

    .hero-text {
      padding-top: 0;
    }

    h1 {
      font-size: 48px;
    }

    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .track-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .modes {
      gap: 28px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 32px;
      padding-bottom: 28px;
      gap: 24px;
    }

    h1 {
      font-size: 38px;
      line-height: 1.08;
    }

    .sub {
      font-size: 15.5px;
    }

    .hero-text {
      gap: 16px;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .search-row {
      padding-bottom: 28px;
    }

    .searchbar {
      height: 48px;
      padding: 0 12px;
      gap: 10px;
    }

    .searchbar-text {
      font-size: 14px;
    }

    .features {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 28px;
    }

    .tracks {
      gap: 12px;
      padding-bottom: 28px;
    }

    h2 {
      font-size: 22px;
    }

    .track-grid {
      gap: 8px;
    }

    .modes {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 28px;
      padding-bottom: 28px;
      gap: 24px;
    }

    .band {
      margin-bottom: 28px;
    }

    .ai-content {
      padding: 18px;
    }

    .ai-content h3 {
      font-size: 20px;
    }

    .prompt {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
