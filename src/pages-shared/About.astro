---
/** `/about/` and `/zh/about/`: what the reference promises and how that promise is checked. */
import Breadcrumb from '@/components/Breadcrumb.astro';
import { SITE } from '@/data/site';
import { t } from '@/i18n';
import Base from '@/layouts/Base.astro';
import { breadcrumbLd, buildHead } from '@/lib/seo';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const homePath = localizePath('/', locale);
const currentPath = localizePath('/about/', locale);
const contributePath = localizePath('/contribute/', locale);

const head = buildHead({
  locale,
  path: currentPath,
  title: t(locale, 'about.title'),
  description: t(locale, 'about.description'),
  kind: 'page',
  jsonLd: [
    breadcrumbLd([
      { name: SITE.name, url: `${SITE.url}${homePath}` },
      { name: t(locale, 'about.title'), url: `${SITE.url}${currentPath}` },
    ]),
  ],
});
---

<Base locale={locale} head={head} currentPath={currentPath}>
  <div class="wrap about-page">
    <header class="about-head">
      <Breadcrumb
        label={t(locale, 'about.title')}
        items={[
          { label: SITE.name, href: homePath },
          { label: t(locale, 'footer.about'), current: true },
        ]}
      />
      <h1>{t(locale, 'about.title')}</h1>
    </header>

    <article class="prose about-copy">
      <section>
        <h2>{t(locale, 'about.what.title')}</h2>
        <p>{t(locale, 'about.what.body')}</p>
      </section>

      <section>
        <h2>{t(locale, 'about.why.title')}</h2>
        <p>{t(locale, 'about.why.body')}</p>
      </section>

      <section>
        <h2>{t(locale, 'about.verified.title')}</h2>
        <p>{t(locale, 'about.verified.body')}</p>
        <p>{t(locale, 'about.verified.date')}</p>
      </section>

      <section>
        <h2>{t(locale, 'about.local.title')}</h2>
        <p>{t(locale, 'about.local.body')}</p>
      </section>

      <section>
        <h2>{t(locale, 'about.built.title')}</h2>
        <p>{t(locale, 'about.built.body')}</p>
        <p><a href={SITE.repo} rel="noopener external">{t(locale, 'about.built.source')}</a></p>
      </section>

      <section>
        <h2>{t(locale, 'about.contact.title')}</h2>
        <p>
          {t(locale, 'about.contact.before')}{locale === 'en' ? ' ' : ''}<a href={contributePath}
            >{t(locale, 'about.contact.link')}</a
          >{t(locale, 'about.contact.after')}
        </p>
      </section>
    </article>
  </div>
</Base>

<style>
  .about-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: calc(760px + 2 * var(--gutter));
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .about-head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h1 {
    font-size: 44px;
    line-height: 1.1;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .about-copy section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .about-copy h2 {
    margin-top: 0;
  }

  @media (max-width: 767px) {
    .about-page {
      gap: 28px;
      padding-top: 32px;
      padding-bottom: 40px;
    }

    .about-head {
      gap: 16px;
    }

    h1 {
      font-size: 32px;
    }

    .about-copy {
      gap: 28px;
    }
  }
</style>
