---
/** One server-rendered catalogue card. PracticeFilters only annotates and hides this DOM. */
import Tag from '@/components/Tag.astro';
import { t } from '@/i18n';
import { practiceUrl, type PracticeItem } from '@/lib/practice';
import type { Locale } from '@/lib/urls';

interface Props {
  item: PracticeItem;
  locale: Locale;
  trackGlyph: string;
  topicTitle: string;
  topicDescription: string;
  order: number;
  more?: boolean;
}

const { item, locale, trackGlyph, topicTitle, topicDescription, order, more = false } = Astro.props;
const id = `${item.bank}#${item.item}`;
const prompt = item.prompt[locale];
---

<a
  class="card practice-card"
  href={practiceUrl(item, locale)}
  data-practice-card
  data-id={id}
  data-track={item.track}
  data-type={item.type}
  data-level={item.difficulty}
  data-order={order}
  data-more={more ? '' : undefined}
>
  <span class="practice-card-top">
    <Tag variant="acc">{trackGlyph}</Tag>
    <Tag>{t(locale, `practice.type.${item.type}`)}</Tag>
    <span class="lbl practice-state" data-practice-state>{t(locale, 'practice.new')}</span>
  </span>
  <span class="ttl">{prompt}</span>
  <span class="sub">{topicDescription}</span>
  <span class="practice-card-meta">
    <Tag>{t(locale, `difficulty.${item.difficulty}`)}</Tag>
    <span class="lbl">
      {
        t(locale, 'practice.cardMeta', {
          minutes: t(locale, 'practice.minutes', { min: item.minutes }),
          title: topicTitle,
        })
      }
    </span>
  </span>
</a>

<style>
  .practice-card {
    min-height: 152px;
    color: var(--ink);
    transition:
      border-color var(--t-state) var(--ease),
      opacity var(--t-state) var(--ease);
  }

  .practice-card:hover {
    color: var(--ink);
    border-color: var(--ink3);
  }

  .practice-card.done {
    border-color: var(--ok);
    opacity: 0.76;
  }

  .practice-card.missed {
    border-color: var(--warn);
    opacity: 0.82;
  }

  .practice-card-top,
  .practice-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .practice-card :global(.tag) {
    white-space: nowrap;
  }

  .practice-state {
    margin-left: auto;
  }

  .practice-state.tag.ok {
    background: var(--ok-soft);
    color: var(--ok);
  }

  .practice-state.tag.warn {
    background: var(--warn-soft);
    color: var(--warn);
  }

  .ttl {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }

  .sub {
    min-width: 0;
    overflow: hidden;
    color: var(--ink2);
    font-size: 13.5px;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .practice-card-meta {
    margin-top: auto;
  }

  .practice-card-meta .lbl {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
