---
/**
 * Complete static markup for one practice item. A Preact controller is supplied in the default
 * slot and progressively enhances these controls; prompt, code, choices, and a hidden answer all
 * remain present when JavaScript is unavailable.
 */
import { renderCode } from '@/lib/code-html';
import type { Locale } from '@/lib/urls';
import type { QuizItem } from '@/schemas/quiz';

interface Props {
  bank: string;
  item: QuizItem;
  locale: Locale;
  labels: Record<string, string>;
}

const { bank, item, locale, labels } = Astro.props;
const id = `${bank}#${item.id}`;
const hasCode = item.type === 'predict' || item.type === 'spotbug' || item.type === 'review';
const codeHtml = hasCode ? await renderCode(item.code, item.lang, labels.copy ?? '') : undefined;
const hasOptions = item.type === 'mcq' || item.type === 'predict';
const correct = hasOptions ? item.options.find((option) => option.correct) : undefined;
const hasIssues = item.type === 'spotbug' || item.type === 'review';
---

<section class="kata-shell" data-quiz={id} data-state="idle">
  {
    item.type === 'review' && (
      <nav class="review-steps" aria-label={labels.reviewSteps} data-review-steps>
        {[labels.read, labels.mark, labels.write, labels.compareStep].map((label, index) => (
          <span class:list={['step', { on: index === 0 }]} data-step={index + 1}>
            <span class="n">{index + 1}</span>
            {label}
          </span>
        ))}
      </nav>
    )
  }

  <h2 class="q-prompt">{item.prompt[locale]}</h2>
  {item.type === 'review' && item.task && <p class="kata-task">{item.task[locale]}</p>}
  {codeHtml && <div class="kata-code" data-code set:html={codeHtml} />}

  {
    hasOptions && (
      <ol class="quiz-options" data-options>
        {item.options.map((option, index) => (
          <li>
            <button
              type="button"
              class="opt"
              data-option={index}
              aria-pressed="false"
              aria-label={`${index + 1}. ${option.text[locale]}`}
            >
              <span class="r" aria-hidden="true" />
              <span>{option.text[locale]}</span>
            </button>
          </li>
        ))}
      </ol>
    )
  }

  {
    item.type === 'fill' && (
      <form class="quiz-fill" data-fill-form>
        <input class="field" type="text" data-fill aria-label={labels.yourAnswer} autocomplete="off" />
        <button class="btn btn-p" type="submit">
          {labels.check}
        </button>
      </form>
    )
  }

  {
    (item.type === 'mcq' || item.type === 'predict') && (
      <button class="btn btn-p kata-submit" type="button" data-submit>
        {labels.check}
      </button>
    )
  }
  {
    item.type === 'spotbug' && (
      <button class="btn btn-p" type="button" data-reveal>
        {labels.reveal}
      </button>
    )
  }

  {
    item.type === 'review' && (
      <>
        <div class="review-comments" data-review-comments hidden />
        <button class="btn btn-p" type="button" data-review-next>
          {labels.markLines}
        </button>
        <div class="review-compare" data-review-compare hidden />
      </>
    )
  }

  <div class="kata-result" data-result aria-live="polite" hidden></div>

  <template data-answer>
    <div class="kata-answer">
      <span class="lbl">{labels.answer}</span>
      {correct && <p>{correct.text[locale]}</p>}
      {item.type === 'fill' && <p>{item.answer}</p>}
      {
        hasIssues && (
          <ul>
            {item.issues.map((issue) => (
              <li>
                <span class="tag">{labels[`kind.${issue.kind}`]}</span>
                {issue.note[locale]}
              </li>
            ))}
          </ul>
        )
      }
      <p data-explanation>{item.explanation[locale]}</p>
    </div>
  </template>

  {item.type === 'review' && <p class="review-disclaimer">{labels.disclaimer}</p>}
  <slot />
</section>
