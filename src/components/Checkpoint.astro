---
/**
 * The checkpoint at the end of a topic. Its summary and complete item data are static HTML;
 * Checkpoint.tsx progressively turns them into the one-at-a-time quiz when the card is visible.
 */
import { getEntry, type CollectionEntry } from 'astro:content';

import CheckpointIsland from '@/islands/Checkpoint';
import { formatCount, t } from '@/i18n';
import { localeFromPath, trackUrl } from '@/lib/urls';
import type { QuizItem } from '@/schemas/quiz';

interface Props {
  /** Quiz id, e.g. `python/closures`. */
  id: string;
  /** Topic progress id. Usually the same as the quiz id, but kept explicit for path checkpoints. */
  topicId?: string;
  /** First public related topic, resolved by Topic.astro. */
  nextTitle?: string;
  nextHref?: string;
  /** Used when the topic has no public related topic. */
  trackHref?: string;
}

const { id, topicId = id, nextTitle, nextHref } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const bank = (await getEntry('quizzes', id)) as CollectionEntry<'quizzes'> | undefined;

type CheckpointItem = Exclude<QuizItem, Extract<QuizItem, { type: 'review' }>>;
const bankItems = bank?.data.items as QuizItem[] | undefined;
const items: CheckpointItem[] = (
  bankItems?.filter((item: QuizItem): item is CheckpointItem => item.type !== 'review') ?? []
).slice(0, 8);
const predict = items.filter((item: CheckpointItem) => item.type === 'predict').length;
const spotbug = items.filter((item: CheckpointItem) => item.type === 'spotbug').length;
const itemsJson = JSON.stringify(items).replace(/</g, '\\u003c');
const fallbackTrack = id.split('/')[0] ?? '';
const fallbackHref = Astro.props.trackHref ?? trackUrl(fallbackTrack, locale);

const labels = {
  start: t(locale, 'checkpoint.start'),
  result: t(locale, 'checkpoint.result', { score: '{score}', total: '{total}' }),
  passed: t(locale, 'checkpoint.passed'),
  failed: t(locale, 'checkpoint.failed'),
  addMisses: t(locale, 'checkpoint.addMisses'),
  continue: t(locale, 'checkpoint.continue', { title: '{title}' }),
  backToTrack: t(locale, 'checkpoint.backToTrack'),
  answer: t(locale, 'practice.answer'),
  yourAnswer: t(locale, 'practice.yourAnswer'),
  check: t(locale, 'practice.check'),
  reveal: t(locale, 'practice.reveal'),
  markLine: t(locale, 'practice.markLine', { line: '{line}' }),
  'kind.security': t(locale, 'practice.kind.security'),
  'kind.correctness': t(locale, 'practice.kind.correctness'),
  'kind.edge-case': t(locale, 'practice.kind.edge-case'),
  'kind.readability': t(locale, 'practice.kind.readability'),
  'kind.performance': t(locale, 'practice.kind.performance'),
};
---

<div id="checkpoint" class="panel checkpoint" data-checkpoint={id}>
  <div data-checkpoint-summary>
    <span class="lbl">{t(locale, 'checkpoint.label')}</span>
    {
      bank && items.length > 0 ? (
        <>
          <p data-checkpoint-count>
            {t(locale, 'checkpoint.count', {
              count: formatCount(locale, items.length, 'unit.question', 'unit.questions'),
            })}{' '}
            · {t(locale, 'checkpoint.predict', { count: predict })} ·{' '}
            {t(locale, 'checkpoint.spotbug', { count: spotbug })}
          </p>
          <button class="btn btn-p" type="button" data-checkpoint-start>
            {t(locale, 'checkpoint.start')}
          </button>
        </>
      ) : (
        <p data-i18n="checkpoint.soon">{t(locale, 'checkpoint.soon')}</p>
      )
    }
  </div>

  {
    bank && items.length > 0 && (
      <>
        <script is:inline type="application/json" data-checkpoint-items set:html={itemsJson} />
        <CheckpointIsland
          client:visible
          bankId={bank.id}
          topicId={topicId}
          locale={locale}
          labels={labels}
          nextTitle={nextTitle}
          nextHref={nextHref}
          trackHref={fallbackHref}
        />
      </>
    )
  }
</div>

<style is:global>
  .checkpoint [data-checkpoint-summary] {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .checkpoint .checkpoint-mount {
    min-height: 1px;
  }

  .checkpoint .bar {
    width: 100%;
  }

  .checkpoint .checkpoint-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .checkpoint .checkpoint-head .lbl {
    white-space: nowrap;
  }

  .checkpoint .checkpoint-item {
    gap: 16px;
  }

  .checkpoint .checkpoint-item .q-prompt,
  .checkpoint .checkpoint-result h3 {
    margin: 0;
    font-size: 20px;
  }

  .checkpoint .checkpoint-result,
  .checkpoint .checkpoint-misses {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .checkpoint .checkpoint-misses {
    padding-left: 20px;
    margin: 0;
  }

  .checkpoint .checkpoint-misses strong,
  .checkpoint .checkpoint-misses p {
    display: block;
    margin: 0;
  }

  .checkpoint .checkpoint-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
