---
/**
 * Placeholder for the inline checkpoint quiz. P1 states that the quiz exists and
 * where it will live; P2 replaces this with the real question card driven by the
 * `quizzes` collection entry named by `id`.
 *
 * The `checkpoint` id is the table of contents' last entry and the anchor a topic page keeps at
 * every depth; a topic carries at most one checkpoint, so the id stays unique.
 */
interface Props {
  /** Quiz id, e.g. `python/closures`. */
  id: string;
}

const { id } = Astro.props;
---

<div id="checkpoint" class="panel checkpoint" data-checkpoint={id}>
  <span class="lbl">checkpoint</span>
  <p data-i18n="checkpoint.soon">Checkpoint available in Practice</p>
</div>
