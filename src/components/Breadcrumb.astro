---
/**
 * The breadcrumb from the track and topic mockups: mono pills separated by a slash, the last one
 * accented and inert. Rendered as a `<nav>` so assistive technology can skip or announce it; the
 * JSON-LD trail is built separately by `breadcrumbLd`.
 */
import Tag from '@/components/Tag.astro';

export interface Crumb {
  label: string;
  href?: string;
  /** Optional semantic colour, such as the AI-era accent on review katas. */
  variant?: 'default' | 'acc' | 'acc2' | 'ok' | 'warn';
  /** The current page's own crumb: accented and never a link. */
  current?: boolean;
}

interface Props {
  items: Crumb[];
  /** Accessible name of the trail, e.g. "Breadcrumb". */
  label: string;
}

const { items, label } = Astro.props;
---

<nav class="crumbs" aria-label={label}>
  {
    items.map((item, index) => (
      <>
        {index > 0 && (
          <span class="lbl sep" aria-hidden="true">
            /
          </span>
        )}
        {item.href && !item.current ? (
          <a href={item.href}>
            <Tag variant={item.variant}>{item.label}</Tag>
          </a>
        ) : (
          <Tag variant={item.variant ?? (item.current ? 'acc' : 'default')}>{item.label}</Tag>
        )}
      </>
    ))
  }
</nav>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* The pill carries the colour; the anchor only makes it clickable. */
  .crumbs a {
    display: inline-flex;
    color: inherit;
  }

  .crumbs a:hover :global(.tag) {
    color: var(--ink);
  }
</style>
