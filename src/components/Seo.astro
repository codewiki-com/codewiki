---
/**
 * Turns the `HeadModel` built by `src/lib/seo.ts` into tags, verbatim. All of the
 * decisions (title shape, canonical, alternates, JSON-LD) happen in that module so
 * they can be unit-tested; this component adds no logic of its own.
 */
import type { HeadModel } from '@/lib/seo';

interface Props {
  head: HeadModel;
}

const { head } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{head.title}</title>
<meta name="description" content={head.description} />
<link rel="canonical" href={head.canonical} />
{head.alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
{Object.entries(head.og).map(([property, content]) => <meta property={property} content={content} />)}
{Object.entries(head.twitter).map(([name, content]) => <meta name={name} content={content} />)}
{head.robots && <meta name="robots" content={head.robots} />}
{head.jsonLd.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />)}
