---
/** Monospace pill. `variant` maps onto the `.tag` modifiers declared in global.css. */
interface Props {
  variant?: 'default' | 'acc' | 'acc2' | 'ok' | 'warn';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;
---

<span class:list={['tag', variant !== 'default' && variant, className]}><slot /></span>
