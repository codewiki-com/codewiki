---
/**
 * The `.track` card from docs/design/mockups/Main.dc.html: mono glyph, track name and a one-line
 * description, linking to the track hub. `ai-era` is the AI-era pillar and carries the `--acc2`
 * border that marks every AI-era affordance across the site (spec §6.1).
 */
import Tag from '@/components/Tag.astro';
import type { Track } from '@/data/tracks';
import { t } from '@/i18n';
import { trackUrl, type Locale } from '@/lib/urls';

interface Props {
  track: Track;
  locale: Locale;
  /**
   * Marks a track that is published but still thin, so a listing of 22 peers does not imply
   * parity between a 30-topic track and a one-topic one.
   */
  preview?: boolean;
  /**
   * "12 topics · 60 exercises", counted at build — docs/design/flagship-tracks.md. The listing
   * states the difference in depth rather than implying it; the home page's six cards, which are
   * all deep, leave it off.
   */
  counts?: string;
}

const { track, locale, preview = false, counts } = Astro.props;
const isAiEra = track.slug === 'ai-era';
---

<a class:list={['track', isAiEra && 'ai-era']} href={trackUrl(track.slug, locale)}>
  <Tag variant="acc">{track.glyph}</Tag>
  <span class="text">
    <span class="name">
      {track.name[locale]}
      {preview && <Tag>{t(locale, 'track.preview')}</Tag>}
    </span>
    <span class="sub">{track.description[locale]}</span>
    {counts && <span class="lbl counts">{counts}</span>}
  </span>
</a>

<style>
  .track {
    color: var(--ink);
    transition:
      border-color var(--t-state) var(--ease),
      box-shadow var(--t-state) var(--ease);
  }

  .track:hover {
    color: var(--ink);
    border-color: var(--ink3);
  }

  .ai-era {
    border-color: var(--acc2);
  }

  .ai-era:hover {
    border-color: var(--acc2);
    box-shadow: 0 0 0 1px var(--acc2);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  /* Glyphs are two to five characters wide (`py` … `swift`), so the chip is sized rather than
     padded: one fixed width keeps every name in a row of cards on the same left edge. 46px fits
     the longest glyph at the tag's own font size. */
  .track :global(.tag) {
    flex: none;
    width: 46px;
    padding-inline: 0;
    text-align: center;
  }

  .counts {
    margin-top: 2px;
  }

  /* The phone mockup lists tracks two to a row, name only. */
  @media (max-width: 767px) {
    .sub {
      display: none;
    }
  }
</style>
