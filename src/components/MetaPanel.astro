---
/** Reading information for a topic. Editorial checks stay in the content tooling. */
import Tag from '@/components/Tag.astro';
import { formatCount, t } from '@/i18n';
import type { Difficulty } from '@/schemas/topic';
import type { Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  difficulty: Difficulty;
  minutes: number;
  version: string;
}

const { locale, difficulty, minutes, version } = Astro.props;
const DIFFICULTY_VARIANT: Record<Difficulty, 'ok' | 'acc' | 'warn'> = {
  beginner: 'ok',
  intermediate: 'acc',
  advanced: 'warn',
};
---

<div class="panel meta">
  <div class="kv">
    <span class="k2">{t(locale, 'topic.level')}</span>
    <span><Tag variant={DIFFICULTY_VARIANT[difficulty]}>{t(locale, `difficulty.${difficulty}`)}</Tag></span>
    <span class="k2">{t(locale, 'topic.time')}</span>
    <span
      >{
        t(locale, 'topic.readTime', { count: formatCount(locale, minutes, 'unit.minute', 'unit.minutes') })
      }</span
    >
  </div>
  <div class="kv version">
    <span class="k2">{t(locale, 'topic.version')}</span>
    <span>{version}</span>
  </div>
</div>

<style>
  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 32px;
    padding: 14px 16px;
  }

  .kv span {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .version {
    align-content: start;
  }

  @media (max-width: 767px) {
    .meta {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px 16px;
      padding: 12px 14px;
    }
  }
</style>
