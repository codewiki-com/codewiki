---
/** One copyable syntax fragment, its terse note, and a no-island Ask-AI event trigger. */
import { t } from '@/i18n';
import { localeFromPath } from '@/lib/urls';

interface Props {
  code: string;
}

const { code } = Astro.props;
const renderedNote = await Astro.slots.render('default');
const note = renderedNote
  .replace(/<[^>]*>/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const askText = `${code} — ${note}`;
const askLabel = t(localeFromPath(Astro.url.pathname), 'cheatsheets.askRow');
---

<div class="cr">
  <code class="snip">{code}</code>
  <span class="nt"><slot /></span>
  <button type="button" class="row-ask" data-ask={askText} aria-label={askLabel} title={askLabel}>?</button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.row-ask:not([data-ready])')) {
    button.dataset.ready = 'true';
    button.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('cw:ask', { detail: { text: button.dataset.ask ?? '' } }));
    });
  }
</script>
