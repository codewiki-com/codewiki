---
/**
 * The explicit form of a callout, for MDX that needs one inside a component or a list where the
 * `> [!PITFALL]` blockquote syntax cannot reach. `remark-callouts.ts` emits the same markup.
 */
interface Props {
  /** Callout kind; picks the colour and the label. */
  type?: 'pitfall' | 'note' | 'tip' | 'warning' | 'ai';
}

const { type = 'note' } = Astro.props;

/** English labels, swapped per locale by the `data-i18n` pass in `Base.astro`. */
const LABELS: Record<NonNullable<Props['type']>, string> = {
  pitfall: 'Pitfall',
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
  ai: 'AI tip',
};
---

<aside class={`callout callout-${type}`} role="note" data-callout={type}>
  <p class="callout-label" data-i18n={`callout.${type}`}>{LABELS[type]}</p>
  <slot />
</aside>
