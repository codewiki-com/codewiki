---
import Icon from '@/components/Icon.astro';
import { alternates, type Locale } from '@/lib/urls';

interface Props {
  id: string;
  locale: Locale;
  currentPath: string;
}

const { id, locale, currentPath } = Astro.props;
const alt = alternates(currentPath);
const label = locale === 'en' ? 'Language' : '语言';
// Each language is named in itself, the same way in both locales.
const languages = [
  { value: 'en', label: 'Eng', name: 'English', href: alt.en, lang: 'en' },
  { value: 'zh', label: '中文', name: '中文', href: alt.zh, lang: 'zh-Hans' },
];
const current = languages.find((language) => language.value === locale)!;
---

<div class="language-switch" data-language-switch>
  <button
    type="button"
    class="language-trigger"
    aria-label={`${label}: ${current.name}`}
    aria-expanded="false"
    aria-controls={id}
  >
    <span lang={current.lang}>{current.label}</span>
    <Icon name="chevron-down" size={14} />
  </button>
  <div class="language-panel" id={id}>
    <nav class="language-options" aria-label={label}>
      {
        languages.map((language) => (
          <a
            href={language.href}
            hreflang={language.lang}
            lang={language.lang}
            aria-label={language.name}
            aria-current={locale === language.value ? 'page' : undefined}
          >
            <span>{language.label}</span>
            {locale === language.value && <Icon name="check" size={14} />}
          </a>
        ))
      }
    </nav>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-language-switch]').forEach((switcher) => {
    const trigger = switcher.querySelector<HTMLButtonElement>('button')!;
    const setOpen = (open: boolean) => {
      switcher.toggleAttribute('data-open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };
    switcher.setAttribute('data-enhanced', '');
    switcher.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') setOpen(true);
    });
    switcher.addEventListener('pointerleave', () => {
      if (!switcher.contains(document.activeElement)) setOpen(false);
    });
    switcher.addEventListener('focusin', () => setOpen(true));
    switcher.addEventListener('focusout', (event) => {
      if (!switcher.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    trigger.addEventListener('click', () => setOpen(true));
    switcher.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        trigger.focus();
        setOpen(false);
        event.stopPropagation();
      } else if (event.key === 'ArrowDown' && event.target === trigger) {
        event.preventDefault();
        setOpen(true);
        switcher.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
  });
</script>

<style>
  .language-switch {
    position: relative;
    color: var(--ink2);
    font-size: 13px;
  }
  .language-trigger {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 0 8px;
    background: transparent;
    border: 0;
    border-radius: var(--r-6);
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .language-trigger:hover {
    color: var(--ink);
    background: var(--bg);
  }
  .language-panel {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 50;
    width: 144px;
    padding-top: 6px;
    visibility: hidden;
    pointer-events: none;
  }
  .language-switch[data-open] .language-panel,
  .language-switch:not([data-enhanced]):hover .language-panel,
  .language-switch:not([data-enhanced]):focus-within .language-panel {
    visibility: visible;
    pointer-events: auto;
  }
  .language-options {
    display: grid;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    background: var(--sur);
    box-shadow: var(--glow);
  }
  .language-options a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
    padding: 0 10px;
    border-radius: 4px;
    color: var(--ink2);
  }
  .language-options a:hover,
  .language-options a:focus-visible,
  .language-options a[aria-current] {
    color: var(--ink);
    background: var(--bg);
  }
  @media (max-width: 1199px) {
    .language-trigger {
      min-height: 44px;
    }
    .language-panel {
      left: 0;
      right: auto;
    }
  }
</style>
