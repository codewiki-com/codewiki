---
/**
 * EN / 中文 segment. The inactive half links to the same page in the other
 * language, so switching never drops the reader back on the home page.
 */
import Seg from '@/components/Seg.astro';
import { alternates, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  /** Site-absolute path of the current page, locale prefix included. */
  currentPath: string;
  class?: string;
}

const { locale, currentPath, class: className } = Astro.props;
const alt = alternates(currentPath);

const items = [
  { label: 'EN', value: 'en', on: locale === 'en', href: alt.en },
  { label: '中文', value: 'zh', on: locale === 'zh', href: alt.zh },
];
---

<Seg items={items} label="English / 中文" class={className} />
