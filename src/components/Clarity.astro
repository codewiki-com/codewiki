---
/** Browser-local "Was this clear?" feedback shared by topic and interview answer rows. */
import { t } from '@/i18n';
import type { Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
---

<span class="lbl clarity" data-clarity-row data-clarity-id={id} data-thanks={t(locale, 'topic.thanks')}>
  {t(locale, 'topic.clear')}
  <button type="button" class="link" data-clarity="yes">{t(locale, 'topic.yes')}</button>
  <span aria-hidden="true">·</span>
  <button type="button" class="link" data-clarity="not-quite">{t(locale, 'topic.notQuite')}</button>
</span>

<script>
  import {
    EMPTY_PROGRESS,
    KEYS,
    flushStore,
    readStore,
    writeStore,
    type Clarity,
    type Progress,
  } from '@/lib/prefs';

  for (const row of document.querySelectorAll<HTMLElement>('[data-clarity-row]:not([data-ready])')) {
    const id = row.dataset.clarityId;
    if (!id) continue;
    row.dataset.ready = 'true';

    for (const button of row.querySelectorAll<HTMLButtonElement>('[data-clarity]')) {
      button.addEventListener('click', () => {
        const value = button.dataset.clarity as Clarity;
        // A reading tracker may still hold a debounced write for this same store.
        flushStore(KEYS.progress);
        const progress = readStore<Progress>(KEYS.progress, EMPTY_PROGRESS);
        writeStore<Progress>(KEYS.progress, {
          ...progress,
          feedback: { ...progress.feedback, [id]: value },
        });
        row.textContent = row.dataset.thanks ?? '';
      });
    }
  }
</script>

<style>
  .clarity {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .link {
    border: 0;
    background: none;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    color: var(--acc);
  }

  .link:hover {
    color: var(--acc-h);
  }

  @media (max-width: 767px) {
    .clarity {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
