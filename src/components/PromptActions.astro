---
/**
 * The three ways to hand a finished prompt to an assistant: open it in Claude, open it in
 * ChatGPT, or copy it. The two links carry the prompt in the query string (cut to what a URL can
 * hold); the copy button always copies the whole prompt.
 */
import { t } from '@/i18n';
import { deepLinks } from '@/lib/prompts';
import type { Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  prompt: string;
  class?: string;
}

const { locale, prompt, class: className } = Astro.props;
const links = deepLinks(prompt);
const copy = t(locale, 'ai.copy');
---

<span class:list={['prompt-actions', className]}>
  <a
    class="act act-sm"
    href={links.claude}
    target="_blank"
    rel="noopener"
    aria-label={t(locale, 'ai.openClaude')}>Claude</a
  >
  <a
    class="act act-sm"
    href={links.chatgpt}
    target="_blank"
    rel="noopener"
    aria-label={t(locale, 'ai.openChatGPT')}>ChatGPT</a
  >
  <button
    type="button"
    class="act act-sm"
    data-prompt-copy={prompt}
    data-rest-label={copy}
    data-copied-label={t(locale, 'ai.copied')}
    data-failed-label={t(locale, 'ai.copyFailed')}
  >
    {copy}
  </button>
</span>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-prompt-copy]')) {
    button.addEventListener('click', () => {
      const show = (label: string | undefined) => {
        button.textContent = label ?? '';
        setTimeout(() => (button.textContent = button.dataset.restLabel ?? ''), 1500);
      };
      navigator.clipboard
        .writeText(button.dataset.promptCopy ?? '')
        .then(() => show(button.dataset.copiedLabel))
        .catch(() => show(button.dataset.failedLabel));
    });
  }
</script>

<style>
  .prompt-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
