---
/**
 * The three ways to hand a prompt to an assistant: open it in Claude, open it in ChatGPT, or copy
 * it. The copy button always copies the whole prompt. The two links carry the whole prompt when a
 * URL can hold it; when it cannot, they carry the instruction with the start of the context and the
 * address of the full text (`linksFor`), a note says so in advance, and following either link also
 * copies the whole prompt.
 */
import { t } from '@/i18n';
import { longPromptLabels } from '@/lib/ai-labels';
import { linksFor, type PromptContext } from '@/lib/prompts';
import type { Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  context: PromptContext;
  class?: string;
}

const { locale, context, class: className } = Astro.props;
const { prompt, claude, chatgpt, complete } = linksFor(context);
const copy = t(locale, 'ai.copy');
const long = longPromptLabels(locale);
---

<span class:list={['prompt-cta', className]} data-prompt-cta>
  <span class="prompt-actions">
    <a
      class="act act-sm"
      href={claude}
      target="_blank"
      rel="noopener"
      aria-label={t(locale, 'ai.openClaude')}
      data-prompt-long={complete ? undefined : ''}>Claude</a
    >
    <a
      class="act act-sm"
      href={chatgpt}
      target="_blank"
      rel="noopener"
      aria-label={t(locale, 'ai.openChatGPT')}
      data-prompt-long={complete ? undefined : ''}>ChatGPT</a
    >
    <button
      type="button"
      class="act act-sm"
      data-prompt-copy
      data-rest-label={copy}
      data-copied-label={t(locale, 'ai.copied')}
      data-failed-label={t(locale, 'ai.copyFailed')}
    >
      {copy}
    </button>
  </span>
  {
    !complete && (
      <span
        class="prompt-long"
        aria-live="polite"
        data-long-copied={long.copied}
        data-long-failed={long.failed}
      >
        {long.hint}
      </span>
    )
  }
  <template data-prompt-text>{prompt}</template>
</span>

<script>
  const promptOf = (from: Element) =>
    from.closest('[data-prompt-cta]')?.querySelector<HTMLTemplateElement>('template[data-prompt-text]')
      ?.content.textContent ?? '';

  const write = (text: string) =>
    navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject(new Error('no clipboard'));

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-prompt-copy]')) {
    button.addEventListener('click', () => {
      const show = (label: string | undefined) => {
        button.textContent = label ?? '';
        setTimeout(() => (button.textContent = button.dataset.restLabel ?? ''), 1500);
      };
      write(promptOf(button))
        .then(() => show(button.dataset.copiedLabel))
        .catch(() => show(button.dataset.failedLabel));
    });
  }

  // A link that carries only part of its prompt still opens; the whole prompt goes to the
  // clipboard on the way, and the note under the buttons says whether it got there.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-prompt-long]')) {
    link.addEventListener('click', () => {
      const note = link.closest('[data-prompt-cta]')?.querySelector<HTMLElement>('.prompt-long');
      write(promptOf(link))
        .then(() => note && (note.textContent = note.dataset.longCopied ?? ''))
        .catch(() => note && (note.textContent = note.dataset.longFailed ?? ''));
    });
  }
</script>

<style>
  .prompt-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .prompt-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .prompt-long {
    margin: 0;
    max-width: 320px;
    text-align: right;
  }
</style>
