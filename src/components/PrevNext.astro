---
/**
 * The two panels that close a topic: what to read first and what to read next — the
 * `before this` / `next up` pair of docs/design/mockups/Topic.dc.html.
 *
 * Both lists come from the frontmatter, where a reference is a `${track}/${slug}` id. A topic that
 * is not written (or not published) in this locale yet is still named, as plain text rather than a
 * link, so the reader can see the shape of the track without meeting a dead link.
 */
import Tag from '@/components/Tag.astro';
import { getTopic, isPublic } from '@/lib/content';
import { t } from '@/i18n';
import { plannedTitle } from '@/lib/planned';
import { topicUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  /** `${track}/${slug}` references from the topic's frontmatter. */
  prerequisites: string[];
  related: string[];
}

const { locale, prerequisites, related } = Astro.props;

interface Link {
  title: string;
  href?: string;
}

/** Resolves references to titles, keeping frontmatter order. */
async function resolve(refs: string[]): Promise<Link[]> {
  return Promise.all(
    refs.map(async (ref) => {
      const [track, slug] = ref.split('/');
      const topic = track && slug ? await getTopic(track, slug, locale) : undefined;
      if (!topic || !isPublic(topic)) {
        // No article to link to: the planned title when the tier list records one, the
        // de-slugged text otherwise — never an invented one, and always tagged as unwritten.
        return { title: plannedTitle(ref, locale) };
      }
      return { title: topic.data.title, href: topicUrl(track!, slug!, locale) };
    }),
  );
}

const before = await resolve(prerequisites);
const next = await resolve(related);
---

{
  (before.length > 0 || next.length > 0) && (
    <div class="prevnext">
      {before.length > 0 && (
        <div class="panel col">
          <span class="lbl">{t(locale, 'topic.before')}</span>
          {before.map((link) =>
            link.href ? (
              <a href={link.href}>{link.title}</a>
            ) : (
              <span class="soon">
                {link.title} <Tag>{t(locale, 'track.soon')}</Tag>
              </span>
            ),
          )}
        </div>
      )}
      {next.length > 0 && (
        <div class="panel col">
          <span class="lbl acc">{t(locale, 'topic.next')}</span>
          {next.map((link) =>
            link.href ? (
              <a href={link.href}>
                {link.title} <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="soon">
                {link.title} <Tag>{t(locale, 'track.soon')}</Tag>
              </span>
            ),
          )}
        </div>
      )}
    </div>
  )
}

<style>
  .prevnext {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
  }

  .col a {
    font-size: 15px;
    color: var(--ink);
  }

  .col a:hover {
    color: var(--acc);
  }

  .acc {
    color: var(--acc);
  }

  /* A prerequisite that is not written yet: named and badged, never a link. The name is the
     planned title or the de-slugged slug, so it is already cased — capitalising it here would
     turn "Scope namespaces" into "Scope Namespaces". */
  .soon {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--ink3);
  }

  @media (max-width: 767px) {
    .prevnext {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
