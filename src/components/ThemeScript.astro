---
/**
 * Applies the stored theme before first paint. Must be rendered in <head>,
 * ahead of the stylesheet, and must stay inline (is:inline) so it is not
 * deferred into a module — a deferred script would flash the wrong palette.
 * Keep the storage key and resolution rules in sync with src/lib/theme.ts.
 */
---

<script is:inline>
  (function () {
    try {
      var prefs = JSON.parse(localStorage.getItem('cw:v1:prefs') || '{}');
      var p = prefs && !Array.isArray(prefs) ? prefs.theme : undefined;
      var sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var t = p === 'light' || p === 'dark' ? p : sys ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
      document.documentElement.setAttribute('data-theme-pref', p === 'light' || p === 'dark' ? p : 'system');
    } catch {}
  })();
</script>
