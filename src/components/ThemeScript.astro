---
/**
 * Applies the stored theme before first paint. Must be rendered in <head>,
 * ahead of the stylesheet, and must stay inline (is:inline) so it is not
 * deferred into a module — a deferred script would flash the wrong palette.
 * Keep the storage key and resolution rules in sync with src/lib/theme.ts.
 */
---

<script is:inline>
  (function () {
    var prefs = {};
    try {
      var stored = JSON.parse(localStorage.getItem('cw:v1:prefs') || '{}');
      if (stored && typeof stored === 'object' && !Array.isArray(stored)) prefs = stored;
    } catch {}
    var p = prefs.theme;
    var sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var t = p === 'light' || p === 'dark' ? p : sys ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', t);
    document.documentElement.setAttribute('data-theme-pref', t);
    // Resolve the initial system palette once, including the retired "system" preference.
    if (p !== t) {
      try {
        prefs.theme = t;
        localStorage.setItem('cw:v1:prefs', JSON.stringify(prefs));
      } catch {}
    }
  })();
</script>
