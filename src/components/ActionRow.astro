---
/**
 * The row of actions under a topic — the `.act` strip of docs/design/mockups/Topic.dc.html.
 *
 * The Ask-AI action opens the prompt panel (`AskAI`, hydrated on idle); flashcards belong to P2 and
 * are rendered inert rather than omitted, so the page has the shape it will keep. "Was this clear?"
 * writes a single flag into this browser's progress store; nothing is sent anywhere.
 */
import AskAI from '@/islands/AskAI';
import { t } from '@/i18n';
import { SITE } from '@/data/site';
import type { Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  /** `${track}/${slug}`, the key the feedback flag is stored under. */
  topicId: string;
  /** Site-absolute path of this page, e.g. `/zh/python/closures/`. */
  path: string;
  /** Path of the source file inside `src/content/topics`, e.g. `python/closures.en.mdx`. */
  filePath: string;
  /** Topic title, quoted in every Ask-AI prompt. */
  title: string;
  /** Canonical URL of this page, quoted in every Ask-AI prompt. */
  url: string;
  /** The language the examples are written in, e.g. `Python`. */
  language: string;
  /** What this topic assumes the reader knows; the "explain simpler" preset builds on it. */
  prerequisite?: string;
}

const { locale, topicId, path, filePath, title, url, language, prerequisite } = Astro.props;

/** The Markdown twin of this page (Task 16): `/python/closures/` → `/python/closures.md`. */
const markdownUrl = `${path.replace(/\/$/, '')}.md`;
const editUrl = `${SITE.repo}/edit/main/src/content/topics/${filePath}`;
const soon = t(locale, 'track.comingSoon');
---

<div class="act-row" data-topic-id={topicId} data-thanks={t(locale, 'topic.thanks')}>
  <AskAI
    client:idle
    labels={{
      open: t(locale, 'topic.askAi'),
      title: t(locale, 'ai.title'),
      presets: {
        explain: t(locale, 'ai.explain'),
        quiz: t(locale, 'ai.quiz'),
        bugs: t(locale, 'ai.bugs'),
        compare: t(locale, 'ai.compare'),
        apply: t(locale, 'ai.apply'),
        feynman: t(locale, 'ai.feynman'),
      },
      claude: t(locale, 'ai.openClaude'),
      chatgpt: t(locale, 'ai.openChatGPT'),
      copy: t(locale, 'ai.copy'),
      copied: t(locale, 'ai.copied'),
      copyFailed: t(locale, 'ai.copyFailed'),
      close: t(locale, 'ai.close'),
      scopePage: t(locale, 'ai.scopePage'),
      scopeSection: t(locale, 'ai.scopeSection'),
    }}
    context={{ locale, title, url, language, prerequisite }}
  />
  <a class="act" href={markdownUrl}>{t(locale, 'topic.copyMd')}</a>
  <button type="button" class="act" data-add-flashcards disabled title={soon}>
    {t(locale, 'topic.addFlash')}
  </button>
  <a class="act" href={editUrl} rel="noopener">{t(locale, 'topic.edit')}</a>
  <span class="lbl clarity" data-clarity-row>
    {t(locale, 'topic.clear')}
    <button type="button" class="link" data-clarity="yes">{t(locale, 'topic.yes')}</button>
    <span aria-hidden="true">·</span>
    <button type="button" class="link" data-clarity="not-quite">{t(locale, 'topic.notQuite')}</button>
  </span>
</div>

<script>
  /* "Was this clear?" — one flag per topic, in this browser only. Without JavaScript the two
     buttons do nothing, which is why they are buttons and not links to a form. */
  import {
    EMPTY_PROGRESS,
    KEYS,
    flushStore,
    readStore,
    writeStore,
    type Clarity,
    type Progress,
  } from '@/lib/prefs';

  const row = document.querySelector<HTMLElement>('[data-clarity-row]');
  const host = row?.closest<HTMLElement>('[data-topic-id]');
  const id = host?.dataset.topicId;

  if (row && id) {
    for (const button of row.querySelectorAll<HTMLButtonElement>('[data-clarity]')) {
      button.addEventListener('click', () => {
        const value = button.dataset.clarity as Clarity;
        // The reading tracker may be holding a debounced write; commit it before reading.
        flushStore(KEYS.progress);
        const progress = readStore<Progress>(KEYS.progress, EMPTY_PROGRESS);
        writeStore<Progress>(KEYS.progress, {
          ...progress,
          feedback: { ...progress.feedback, [id]: value },
        });
        // The answer is the whole interaction: say it landed and stop offering the choice.
        row.textContent = host?.dataset.thanks ?? '';
      });
    }
  }
</script>

<style>
  .act-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  a.act:hover {
    color: var(--ink);
    border-color: var(--ink3);
  }

  .act[disabled] {
    color: var(--ink3);
    border-color: var(--line);
    cursor: default;
  }

  .clarity {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* A button that reads as a link: it changes local state, so it cannot be an anchor. */
  .link {
    border: 0;
    background: none;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    color: var(--acc);
  }

  .link:hover {
    color: var(--acc-h);
  }

  @media (max-width: 767px) {
    .clarity {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
