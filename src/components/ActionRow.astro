---
/**
 * The row of actions under a topic — the `.act` strip of docs/design/mockups/Topic.dc.html.
 *
 * The Ask-AI action opens the prompt panel (`AskAI`, hydrated on idle); the flashcard action adds
 * this page's terms to the browser-local deck. "Was this clear?" writes a single flag into this
 * browser's progress store; nothing is sent anywhere.
 */
import AskAI from '@/islands/AskAI';
import Clarity from '@/components/Clarity.astro';
import { t } from '@/i18n';
import { SITE } from '@/data/site';
import { TRACKS } from '@/data/tracks';
import type { Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  /** `${track}/${slug}`, the key the feedback flag is stored under. */
  topicId: string;
  /** Site-absolute path of this page, e.g. `/zh/python/closures/`. */
  path: string;
  /** Path of the source file inside `src/content/topics`, e.g. `python/closures.en.mdx`. */
  filePath: string;
  /** Topic title, quoted in every Ask-AI prompt. */
  title: string;
  /** Canonical URL of this page, quoted in every Ask-AI prompt. */
  url: string;
  /** The language the examples are written in, e.g. `Python`. */
  language: string;
  /** What this topic assumes the reader knows; the "explain simpler" preset builds on it. */
  prerequisite?: string;
  /** Glossary ids named by this topic's frontmatter. */
  terms: string[];
}

const { locale, topicId, path, filePath, title, url, language, prerequisite, terms } = Astro.props;

/** The Markdown twin of this page (Task 16): `/python/closures/` → `/python/closures.md`. */
const markdownUrl = `${path.replace(/\/$/, '')}.md`;
const editUrl = `${SITE.repo}/edit/main/src/content/topics/${filePath}`;
const addedTemplate = t(locale, 'topic.addedToFlashcards', { count: '{count}' });
const languages = TRACKS.filter((track) => track.kind === 'language').map((track) => ({
  value: track.name.en,
  label: track.name[locale],
}));
---

<div class="act-row">
  <AskAI
    client:idle
    labels={{
      open: t(locale, 'topic.askAi'),
      title: t(locale, 'ai.title'),
      presets: {
        explain: t(locale, 'ai.explain'),
        quiz: t(locale, 'ai.quiz'),
        bugs: t(locale, 'ai.bugs'),
        compare: t(locale, 'ai.compare'),
        apply: t(locale, 'ai.apply'),
        feynman: t(locale, 'ai.feynman'),
        'explain-code': t(locale, 'ask.explainCode'),
        port: t(locale, 'ask.port'),
        tests: t(locale, 'ask.tests'),
        'check-pitfall': t(locale, 'ask.checkPitfall'),
      },
      claude: t(locale, 'ai.openClaude'),
      chatgpt: t(locale, 'ai.openChatGPT'),
      copy: t(locale, 'ai.copy'),
      copied: t(locale, 'ai.copied'),
      copyFailed: t(locale, 'ai.copyFailed'),
      close: t(locale, 'ai.close'),
      scopePage: t(locale, 'ai.scopePage'),
      scopeSection: t(locale, 'ai.scopeSection'),
    }}
    context={{ locale, title, url, language, prerequisite, languages }}
  />
  <a class="act" href={markdownUrl}>{t(locale, 'topic.copyMd')}</a>
  <button
    type="button"
    class="act"
    data-add-flashcards
    data-terms={terms.join(',')}
    data-locale={locale}
    disabled={terms.length === 0}
  >
    {t(locale, 'topic.addFlash')}
  </button>
  <span class="lbl flashcard-confirm" data-flashcards-confirm data-template={addedTemplate} hidden></span>
  <a class="act" href={editUrl} rel="noopener">{t(locale, 'topic.edit')}</a>
  <Clarity locale={locale} id={topicId} />
</div>

<style>
  .act-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  a.act:hover {
    color: var(--ink);
    border-color: var(--ink3);
  }

  .act[disabled] {
    color: var(--ink3);
    border-color: var(--line);
    cursor: default;
  }

  .flashcard-confirm {
    color: var(--ok);
  }
</style>

<script>
  import { formatCount } from '@/i18n';
  import { EMPTY_FLASHCARDS, KEYS, flushStore, readStore, writeStore, type Flashcards } from '@/lib/prefs';
  import { enqueueCards, termCardId } from '@/lib/score';

  const safeDeck = (): Flashcards => {
    const stored = readStore<Flashcards>(KEYS.flashcards, EMPTY_FLASHCARDS);
    return Array.isArray(stored?.cards) ? stored : EMPTY_FLASHCARDS;
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-add-flashcards]')) {
    const terms = (button.dataset.terms ?? '')
      .split(',')
      .map((term) => term.trim())
      .filter(Boolean);
    const updateDisabled = () => {
      const ids = new Set(safeDeck().cards.map((card) => card.id));
      button.disabled = terms.length === 0 || terms.every((term) => ids.has(termCardId(term)));
    };

    button.addEventListener('click', () => {
      const deck = safeDeck();
      const next = enqueueCards(
        deck,
        terms.map((term) => {
          const ref = termCardId(term);
          return { id: ref, kind: 'term' as const, ref, source: 'manual' as const };
        }),
        new Date(),
      );
      writeStore(KEYS.flashcards, next);
      flushStore(KEYS.flashcards);

      const confirmation = button.parentElement?.querySelector<HTMLElement>('[data-flashcards-confirm]');
      if (confirmation) {
        const added = next.cards.length - deck.cards.length;
        const locale = button.dataset.locale === 'zh' ? 'zh' : 'en';
        confirmation.textContent = (confirmation.dataset.template ?? '').replace(
          '{count}',
          formatCount(locale, added, 'unit.card', 'unit.cards'),
        );
        confirmation.hidden = false;
      }
      updateDisabled();
    });

    document.addEventListener('cw:flashcards', updateDisabled);
    updateDisabled();
    button.dataset.ready = 'true';
  }
</script>
