---
/**
 * The path diagram is entirely build-time SVG. PathState only annotates these stable nodes with
 * browser-local states, so the map remains useful as static HTML and never shifts on hydration.
 */
import { layoutPath } from '@/lib/pathmap';

export interface PathMapTopic {
  title: string;
  href?: string;
}

interface Props {
  milestones: { id: string; title: string; topics: string[] }[];
  edges: { from: string; to: string }[];
  topics: Record<string, PathMapTopic>;
  ariaLabel: string;
  checkpointLabel: string;
  soonLabel: string;
}

const { milestones, edges, topics, ariaLabel, checkpointLabel, soonLabel } = Astro.props;
const layout = layoutPath(
  { milestones, edges },
  (id) => Boolean(topics[id]?.href),
  (id) => topics[id]?.title ?? id,
);

const checkpointText = (index: number) => checkpointLabel.replace('{number}', String(index + 1));
---

<svg
  class="path-svg"
  width={layout.width}
  height={layout.height}
  viewBox={`0 0 ${layout.width} ${layout.height}`}
  role="img"
  aria-label={ariaLabel}
>
  {
    layout.columns.map((column, index) => (
      <g aria-hidden="true">
        <rect class="mile" x={column.x} y="26" width={column.w} height={layout.height - 52} rx="10" />
        <text class="mtitle" x={column.x + 10} y="16">
          M{index + 1} · {column.title}
        </text>
      </g>
    ))
  }

  {
    layout.edges.map((edge) => (
      <path
        class:list={['edge', edge.kind]}
        d={edge.d}
        data-edge-from={edge.from}
        data-edge-to={edge.to}
        data-edge-kind={edge.kind}
        aria-hidden="true"
      />
    ))
  }

  {
    layout.nodes.map((node) => {
      const topic = topics[node.id];
      const visibleLabel = node.exists ? node.label : `${node.label} · ${soonLabel}`;
      const shape = (
        <>
          <rect
            class:list={['node', !node.exists && 'soon']}
            x={node.x}
            y={node.y}
            width={node.w}
            height={node.h}
            rx="6"
          />
          <path
            class="node-check"
            d={`m${node.x + 11} ${node.y + 17} 3.5 3.5 7-7`}
            fill="none"
            stroke="var(--ok)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          />
          <text
            class="ntext"
            data-node-label
            x={node.x + 10}
            y={node.y + 22}
            data-base-x={node.x + 10}
            data-base-label={visibleLabel}
          >
            {visibleLabel}
          </text>
        </>
      );

      return node.exists && topic?.href ? (
        <a
          class="map-node"
          href={topic.href}
          data-topic={node.id}
          data-milestone={milestones[node.col]!.id}
          data-authored="true"
          aria-label={node.label}
        >
          {shape}
        </a>
      ) : (
        <g
          class="map-node"
          data-topic={node.id}
          data-milestone={milestones[node.col]!.id}
          data-authored="false"
          aria-hidden="true"
        >
          {shape}
        </g>
      );
    })
  }

  {
    layout.diamonds.map((diamond, index) => (
      <g class="map-checkpoint" data-milestone={diamond.milestone} data-checkpoint aria-hidden="true">
        <path
          class="diamond"
          d={`M${diamond.x} ${diamond.y - 16} ${diamond.x + 16} ${diamond.y} ${diamond.x} ${diamond.y + 16} ${diamond.x - 16} ${diamond.y}Z`}
        />
        <text class="ntext checkpoint-text" x={diamond.x + 26} y={diamond.y + 4}>
          {checkpointText(index)}
        </text>
      </g>
    ))
  }
</svg>
