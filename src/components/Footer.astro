---
/**
 * Site footer with project links and separate code/content licenses.
 * Below 768px the two halves stack.
 */
import { t } from '@/i18n';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/data/site';
import { localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  /** Site-absolute path of the current page, locale prefix included. */
  currentPath: string;
}

const { locale } = Astro.props;

const links = [
  {
    label: t(locale, 'footer.contribute'),
    href: localizePath('/contribute/', locale),
    external: false,
  },
  { label: t(locale, 'footer.about'), href: localizePath('/about/', locale), external: false },
  { label: t(locale, 'footer.llms'), href: '/llms.txt', external: false },
  { label: t(locale, 'footer.githubRepo'), href: SITE.repo, external: true },
];
---

<footer class="foot-outer">
  <div class="bar foot">
    <div class="foot-info">
      <span class="tagline">{t(locale, 'footer.tagline')}</span>
      <p class="licenses">
        {t(locale, 'footer.codeLicense')}
        <a href={`${SITE.repo}/blob/main/LICENSE`}>MIT</a>
        <span aria-hidden="true"> · </span>
        {t(locale, 'footer.contentLicense')}
        <a href={`${SITE.repo}/blob/main/LICENSE-CONTENT.md`}>CC BY-SA 4.0</a>
      </p>
    </div>
    <div class="foot-links">
      <a class="github-link" href="https://github.com/codewiki-com"><Icon name="github" size={16} />GitHub</a>
      {
        links.map((link) =>
          link.external ? (
            <a href={link.href} rel="noopener external">
              {link.label}
            </a>
          ) : (
            <a href={link.href}>{link.label}</a>
          ),
        )
      }
    </div>
  </div>
</footer>

<style>
  .foot-outer {
    border-top: 1px solid var(--line);
    background: var(--sur);
    margin-top: auto;
  }

  /* Matches the nav container so both edges line up with the page content. */
  .bar {
    max-width: calc(var(--w) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 26px;
    padding-bottom: 26px;
    font-size: 13px;
    color: var(--ink3);
  }

  .foot-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .foot-info {
    display: grid;
    gap: 6px;
  }
  .licenses {
    margin: 0;
  }
  .licenses a {
    color: var(--ink2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .foot-links a {
    color: var(--ink3);
    transition: color var(--t-state) var(--ease);
  }

  .foot-links a:hover {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
