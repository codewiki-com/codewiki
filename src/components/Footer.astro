---
/**
 * Site footer, per docs/design/mockups/Main.dc.html: one tagline line on the left
 * and five muted links on the right. Below 768px the two halves stack.
 */
import { t } from '@/i18n';
import { alternates, localizePath, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  /** Site-absolute path of the current page, locale prefix included. */
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const other: Locale = locale === 'en' ? 'zh' : 'en';

const links = [
  {
    label: t(locale, 'footer.contribute'),
    href: localizePath('/contribute/', locale),
    external: false,
  },
  { label: t(locale, 'footer.about'), href: localizePath('/about/', locale), external: false },
  { label: t(locale, 'footer.llms'), href: '/llms.txt', external: false },
  { label: t(locale, 'footer.rss'), href: localizePath('/rss.xml', locale), external: false },
  { label: t(locale, 'footer.otherLocale'), href: alternates(currentPath)[other], external: false },
];
---

<footer class="foot-outer">
  <div class="bar foot">
    <span class="tagline">{t(locale, 'footer.tagline')}</span>
    <div class="foot-links">
      {
        links.map((link) =>
          link.external ? (
            <a href={link.href} rel="noopener external">
              {link.label}
            </a>
          ) : (
            <a href={link.href}>{link.label}</a>
          ),
        )
      }
    </div>
  </div>
</footer>

<style>
  .foot-outer {
    border-top: 1px solid var(--line);
    background: var(--sur);
    margin-top: auto;
  }

  /* Matches the nav container so both edges line up with the page content. */
  .bar {
    max-width: calc(var(--w) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 26px;
    padding-bottom: 26px;
    font-size: 13px;
    color: var(--ink3);
  }

  .foot-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .foot-links a {
    color: var(--ink3);
    transition: color var(--t-state) var(--ease);
  }

  .foot-links a:hover {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
