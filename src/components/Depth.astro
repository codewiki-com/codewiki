---
/**
 * One depth-gated section of a topic. `data-depth` is what the depth CSS in `global.css` keys on:
 * Quick mode shows only `quick` blocks and the TL;DR, Standard adds the unmarked prose, Deep adds
 * everything.
 *
 * A `deep` section keeps a teaser visible at the lower depths — the mockup's dashed row naming the
 * section and offering the switch — so the reader knows what is being withheld. The teaser's text
 * is the section's own first heading, read out of the rendered slot rather than duplicated in a
 * prop, so it can never drift from the heading.
 */
import { t } from '@/i18n';
import { localeFromPath } from '@/lib/urls';

interface Props {
  /** `quick` shows in every mode; `deep` shows only at Deep depth. */
  level: 'quick' | 'deep';
}

const { level } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);

const body = await Astro.slots.render('default');
// The first h2/h3 of the section; the tags come from our own pipeline, so a regex is enough.
const heading = body.match(/<h[23][^>]*>([\s\S]*?)<\/h[23]>/)?.[1];
const teaser = heading?.replace(/<[^>]+>/g, '').trim();
---

<section data-depth={level}>
  {
    level === 'deep' && (
      <div class="depth-teaser">
        <span class="tag">{t(locale, 'depth.deep')}</span>
        {teaser && <span class="depth-teaser-text">{teaser}</span>}
        <button type="button" class="depth-switch" data-depth-switch="deep">
          <span data-i18n="depth.switchDeep">Switch to Deep</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    )
  }
  <div class="depth-body" set:html={body} />
</section>
