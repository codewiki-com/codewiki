---
/**
 * The mockups' `.btn`. Renders an anchor when `href` is given and a real button
 * otherwise, so a link is never faked with a click handler.
 */
interface Props {
  variant?: 'primary' | 'ghost';
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { variant = 'primary', href, class: className, ...rest } = Astro.props;
const classes = ['btn', variant === 'primary' ? 'btn-p' : 'btn-g', className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    justify-content: center;
    border: 0;
    cursor: pointer;
  }

  .btn-g {
    border: 1px solid var(--line);
  }

  .btn-p:hover {
    background: var(--acc-h);
    color: var(--acc-ink);
  }

  .btn-g:hover {
    color: var(--ink);
    border-color: var(--ink3);
  }
</style>
