---
/** One progressively enhanced interview disclosure; native details keeps every answer usable. */
import AskAI from '@/islands/AskAI';
import Clarity from '@/components/Clarity.astro';
import Tag from '@/components/Tag.astro';
import { t } from '@/i18n';
import { longPromptLabels } from '@/lib/ai-labels';
import { renderMarkdown } from '@/lib/md';
import type { Locale } from '@/lib/urls';
import type { InterviewItem } from '@/schemas/interview';

export interface InterviewTopicLink {
  href: string;
  title: string;
}

interface Props {
  locale: Locale;
  track: string;
  trackName: string;
  pageUrl: string;
  item: InterviewItem;
  number: number;
  topics: InterviewTopicLink[];
}

const { locale, track, trackName, pageUrl, item, number, topics } = Astro.props;
const question = item.question[locale];
const answer = item.answer[locale];
const answerHtml = await renderMarkdown(answer, locale);
const questionId = `question-${item.id}`;
const progressId = `interview/${track}/${item.id}`;
const level = t(locale, `interview.level.${item.level}`);
const frequency = item.frequency ? t(locale, `interview.frequency.${item.frequency}`) : undefined;

const aiLabels = {
  open: t(locale, 'interview.grade'),
  title: t(locale, 'ai.title'),
  presets: {
    explain: t(locale, 'ai.explain'),
    quiz: t(locale, 'ai.quiz'),
    bugs: t(locale, 'ai.bugs'),
    compare: t(locale, 'ai.compare'),
    apply: t(locale, 'ai.apply'),
    feynman: t(locale, 'ai.feynman'),
    'explain-code': t(locale, 'ask.explainCode'),
    port: t(locale, 'ask.port'),
    tests: t(locale, 'ask.tests'),
    'check-pitfall': t(locale, 'ask.checkPitfall'),
  },
  claude: t(locale, 'ai.openClaude'),
  chatgpt: t(locale, 'ai.openChatGPT'),
  copy: t(locale, 'ai.copy'),
  copied: t(locale, 'ai.copied'),
  copyFailed: t(locale, 'ai.copyFailed'),
  close: t(locale, 'ai.close'),
  scopePage: t(locale, 'ai.scopePage'),
  scopeSection: t(locale, 'ai.scopeSection'),
  long: longPromptLabels(locale),
};
---

<details class="q" id={questionId} data-id={item.id} data-level={item.level}>
  <summary class="qh">
    <Tag class="q-number">{String(number).padStart(2, '0')}</Tag>
    <span class="q-question">{question}</span>
    <span class="lbl q-meta">
      <span>{level}</span>
      {
        frequency && (
          <>
            <span aria-hidden="true">·</span>
            <span>{frequency}</span>
          </>
        )
      }
      <span data-seen hidden>
        <span aria-hidden="true">·</span>
        {t(locale, 'interview.seen')}
      </span>
    </span>
    <span class="lbl q-toggle">
      <span class="q-reveal">{t(locale, 'interview.reveal')} ▾</span>
      <span class="q-hide">{t(locale, 'interview.hide')} ▴</span>
    </span>
  </summary>
  <div class="qa">
    <div class="qa-answer prose" set:html={answerHtml} />
    <div class="qa-context">
      <div class="qa-topics">
        <span class="lbl">{t(locale, 'interview.readMore')}</span>
        {
          topics.map((topic) => (
            <a href={topic.href}>
              <Tag variant="acc">{topic.title}</Tag>
            </a>
          ))
        }
      </div>
      <Clarity locale={locale} id={progressId} />
    </div>
    <div class="qa-actions">
      <button type="button" class="act" data-add-card={item.id}>
        {t(locale, 'interview.addFlash')}
      </button>
      <button type="button" class="act" data-copy-qa data-question={question} data-answer={answer}>
        {t(locale, 'interview.copyMd')}
      </button>
      <AskAI
        client:idle
        labels={aiLabels}
        context={{
          locale,
          title: question,
          url: `${pageUrl}#${questionId}`,
          language: trackName,
          sectionText: question,
        }}
        preset="feynman"
      />
    </div>
  </div>
</details>
