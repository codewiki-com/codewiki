---
/**
 * One card in a track hub's section grid — the `.topic` block of
 * docs/design/mockups/TrackHub.dc.html. Server-rendered cards always carry `state="none"`,
 * because reading progress lives in the visitor's browser: the `TrackProgress` island patches
 * the DOM afterwards, keyed by `data-topic-id`. Keep that contract in step with the island.
 */
import Icon from '@/components/Icon.astro';
import Tag from '@/components/Tag.astro';
import { t } from '@/i18n';
import type { Topic } from '@/lib/content';
import type { Difficulty } from '@/schemas/topic';
import { topicMeta } from '@/lib/content';
import { estimateMinutes } from '@/lib/reading-time';
import { topicUrl, type Locale } from '@/lib/urls';

interface Props {
  topic: Topic;
  locale: Locale;
  /** `done` and `current` exist for the island and for tests; pages render `none`. */
  state?: 'done' | 'current' | 'none';
}

const { topic, locale, state = 'none' } = Astro.props;
const { track, slug } = topicMeta(topic);
const id = `${track}/${slug}`;

const DIFFICULTY_VARIANT: Record<Difficulty, 'ok' | 'acc' | 'warn'> = {
  beginner: 'ok',
  intermediate: 'acc',
  advanced: 'warn',
};

const difficulty: Difficulty = topic.data.difficulty;
const minutes = estimateMinutes(topic.body ?? '', locale);
const read = state === 'done' ? 'done' : state === 'current' ? 'reading' : 'unread';
---

<a
  class:list={['topic', state === 'done' && 'done', state === 'current' && 'cur']}
  href={topicUrl(track, slug, locale)}
  data-topic-id={id}
  data-difficulty={difficulty}
  data-read={read}
>
  <span class="t">
    {state === 'done' && <Icon name="check" size={14} />}
    {topic.data.title}
  </span>
  <span class="d">{topic.data.description}</span>
  <span class="m">
    <Tag variant={DIFFICULTY_VARIANT[difficulty]}>{t(locale, `difficulty.${difficulty}`)}</Tag>
    <span class="lbl">{t(locale, 'track.minutes', { min: minutes })}</span>
  </span>
</a>

<style>
  /* The mockup's one-line descriptions; real ones run to two lines and are clamped there. */
  .d {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
</style>
