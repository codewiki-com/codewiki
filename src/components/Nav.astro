---
/**
 * Site header. Desktop follows docs/design/mockups/Main.dc.html (56px bar, logo
 * plus seven links, 240px search field, EN/中文 segment, theme toggle); below
 * 768px it collapses to the MobileHome.dc.html bar (52px, logo plus two 44px
 * buttons) with the links inside a <details> panel, so the menu needs no JS.
 *
 * The search control is a button carrying `data-palette-open`; Task 15 attaches
 * the command palette to that hook and to ⌘K.
 */
import Icon from '@/components/Icon.astro';
import Kbd from '@/components/Kbd.astro';
import LangSwitch from '@/components/LangSwitch.astro';
import ThemeToggle from '@/islands/ThemeToggle';
import { t } from '@/i18n';
import { localizePath, stripLocale, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  /** Site-absolute path of the current page, locale prefix included. */
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

/** The seven primary destinations, in mockup order. `AI era` is the accented one. */
const LINKS = [
  { key: 'nav.tracks', path: '/tracks/' },
  { key: 'nav.paths', path: '/paths/' },
  { key: 'nav.practice', path: '/practice/' },
  { key: 'nav.cheatsheets', path: '/cheatsheets/' },
  { key: 'nav.compare', path: '/compare/' },
  { key: 'nav.playground', path: '/playground/' },
  { key: 'nav.aiEra', path: '/ai-era/', accent: true },
] as const;

const here = stripLocale(currentPath);

const links = LINKS.map((link) => ({
  label: t(locale, link.key),
  href: localizePath(link.path, locale),
  accent: 'accent' in link,
  current: here.startsWith(link.path),
}));

const themeLabels = {
  system: t(locale, 'theme.system'),
  light: t(locale, 'theme.light'),
  dark: t(locale, 'theme.dark'),
};

const searchLabel = t(locale, 'nav.search');
const homeHref = localizePath('/', locale);
---

<header class="nav-outer">
  <div class="bar nav">
    <div class="nav-left">
      <a class="brand" href={homeHref}>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="logo"
        >
          <rect x="3" y="3" width="18" height="18" rx="3"></rect>
          <path d="m9 9-3 3 3 3M15 9l3 3-3 3M13 7l-2 10"></path>
        </svg>
        <span class="wordmark">codewiki</span>
      </a>

      <nav class="links" aria-label={t(locale, 'nav.primary')}>
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={[link.accent && 'ai', link.current && 'on']}
              aria-current={link.current ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="nav-right">
      <button type="button" class="search" data-palette-open aria-label={searchLabel}>
        <Icon name="search" size={15} />
        <span class="search-label">{searchLabel}</span>
        <Kbd>{t(locale, 'nav.searchHint')}</Kbd>
      </button>

      <button type="button" class="icon-btn search-compact" data-palette-open aria-label={searchLabel}>
        <Icon name="search" size={20} />
      </button>

      <div class="nav-tools">
        <LangSwitch locale={locale} currentPath={currentPath} />
        <ThemeToggle client:idle labels={themeLabels} />
      </div>

      <details class="nav-menu">
        <summary class="icon-btn" aria-label={t(locale, 'nav.menu')}>
          <Icon name="menu" size={20} />
        </summary>
        <div class="menu-panel">
          <nav class="menu-links" aria-label={t(locale, 'nav.primary')}>
            {
              links.map((link) => (
                <a
                  href={link.href}
                  class:list={[link.accent && 'ai', link.current && 'on']}
                  aria-current={link.current ? 'page' : undefined}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
          <div class="menu-tools">
            <LangSwitch locale={locale} currentPath={currentPath} />
            <ThemeToggle client:idle labels={themeLabels} />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-outer {
    position: relative;
    border-bottom: 1px solid var(--line);
    background: var(--sur);
  }

  /* `--w` is set by the layout: 1200px for standard pages, 1320px for topics.
     The 48px of padding sits outside it so the content column keeps its width. */
  .bar {
    max-width: calc(var(--w) + 48px);
    margin: 0 auto;
    padding: 0 24px;
  }

  .nav {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 32px;
    min-width: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--ink);
  }

  .wordmark {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .links a,
  .menu-links a {
    color: var(--ink2);
    font-size: 14px;
    font-weight: 500;
    transition: color var(--t-state) var(--ease);
  }

  .links a.ai,
  .menu-links a.ai {
    color: var(--acc2);
  }

  .links a.on,
  .menu-links a.on {
    color: var(--ink);
  }

  .links a:hover,
  .menu-links a:hover {
    color: var(--acc);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 34px;
    width: 240px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    background: var(--bg);
    color: var(--ink3);
    font-size: 13.5px;
    text-align: left;
    transition:
      border-color var(--t-state) var(--ease),
      color var(--t-state) var(--ease);
  }

  .search:hover {
    border-color: var(--ink3);
    color: var(--ink2);
  }

  .search-label {
    flex: 1;
  }

  .icon-btn {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--r-6);
    background: transparent;
    color: var(--ink2);
  }

  .icon-btn:hover {
    color: var(--ink);
  }

  /* The toggle is a Preact island, so its class is not scoped to this file. */
  .nav-tools :global(.theme-toggle) {
    width: 34px;
    height: 34px;
    padding: 0;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--ink2);
  }

  .nav-tools :global(.theme-toggle svg) {
    width: 18px;
    height: 18px;
  }

  .nav-tools :global(.theme-toggle:hover) {
    color: var(--ink);
  }

  /* ---- mobile menu ---- */

  .nav-menu {
    display: none;
  }

  .nav-menu > summary {
    list-style: none;
    cursor: pointer;
  }

  .nav-menu > summary::-webkit-details-marker {
    display: none;
  }

  .menu-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 40;
    display: flex;
    flex-direction: column;
    background: var(--sur);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--glow);
    padding: 4px 16px 16px;
  }

  .menu-links {
    display: flex;
    flex-direction: column;
  }

  .menu-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    border-bottom: 1px solid var(--line);
  }

  .menu-tools {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
  }

  .menu-tools :global(.theme-toggle) {
    width: 44px;
    height: 44px;
    padding: 0;
    justify-content: center;
    color: var(--ink2);
  }

  .menu-tools :global(.theme-toggle svg) {
    width: 20px;
    height: 20px;
  }

  .search-compact {
    display: none;
  }

  @media (max-width: 767px) {
    .bar {
      padding: 0 16px;
    }

    .nav {
      height: 52px;
    }

    .nav-right {
      gap: 6px;
    }

    .links,
    .search,
    .nav-tools {
      display: none;
    }

    .search-compact,
    .nav-menu {
      display: block;
    }

    .search-compact {
      display: inline-flex;
    }

    .logo {
      width: 20px;
      height: 20px;
    }

    .wordmark {
      font-size: 17px;
    }

    .brand {
      gap: 8px;
    }
  }
</style>
