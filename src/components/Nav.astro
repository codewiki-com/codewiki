---
/**
 * Site header with search, a language dropdown, theme toggle and GitHub link.
 * Below 1200px, primary links and preferences move into the native mobile menu.
 */
import Icon from '@/components/Icon.astro';
import Kbd from '@/components/Kbd.astro';
import LangSwitch from '@/components/LangSwitch.astro';
import ThemeToggle from '@/islands/ThemeToggle';
import { t } from '@/i18n';
import { P2B_NAV, P2_NAV, P3_NAV } from '@/data/site';
import { localizePath, stripLocale, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  /** Site-absolute path of the current page, locale prefix included. */
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

/**
 * The primary destinations. Practice comes first — docs/design/home-hero-kata.md: the training
 * side is the site's signature, and the bar should say so before the catalogue does. Each staged
 * destination reads its own release flag, so exposing the P2a pages cannot accidentally publish
 * a later route.
 */
const LINKS = [
  { key: 'nav.practice', path: '/practice/', enabled: P2_NAV },
  { key: 'nav.paths', path: '/paths/', enabled: P2_NAV },
  { key: 'nav.tracks', path: '/tracks/', enabled: true },
  { key: 'nav.cheatsheets', path: '/cheatsheets/', enabled: P2_NAV },
  { key: 'nav.compare', path: '/compare/', enabled: P3_NAV },
  { key: 'nav.playground', path: '/playground/', enabled: P2B_NAV },
  { key: 'nav.glossary', path: '/glossary/', enabled: true },
  { key: 'nav.aiEra', path: '/ai-era/', enabled: true, accent: true },
] as const;

const here = stripLocale(currentPath);

const links = LINKS.filter((link) => link.enabled).map((link) => ({
  label: t(locale, link.key),
  href: localizePath(link.path, locale),
  accent: 'accent' in link,
  current: here.startsWith(link.path),
}));

const themeLabels = {
  light: t(locale, 'theme.light'),
  dark: t(locale, 'theme.dark'),
};

const searchLabel = t(locale, 'nav.search');
const homeHref = localizePath('/', locale);
---

<header class="nav-outer">
  <div class="bar nav">
    <div class="nav-left">
      <a class="brand" href={homeHref}>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="logo"
        >
          <rect x="3" y="3" width="18" height="18" rx="3"></rect>
          <path d="m9 9-3 3 3 3M15 9l3 3-3 3M13 7l-2 10"></path>
        </svg>
        <span class="wordmark">CodeWiki</span>
      </a>

      <nav class="links" aria-label={t(locale, 'nav.primary')}>
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={[link.accent && 'ai', link.current && 'on']}
              aria-current={link.current ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="nav-right">
      {
        /* No aria-label: the button says "Search ⌘K" on screen, and an aria-label that repeated
          only half of that would leave voice control unable to address it by what it reads. */
      }
      <button type="button" class="search" data-palette-open>
        <Icon name="search" size={15} />
        <span class="search-label">{searchLabel}</span>
        <Kbd>{t(locale, 'nav.searchHint')}</Kbd>
      </button>

      <button type="button" class="icon-btn search-compact" data-palette-open aria-label={searchLabel}>
        <Icon name="search" size={20} />
      </button>

      <div class="nav-tools">
        <LangSwitch id="nav-language" locale={locale} currentPath={currentPath} />
        <ThemeToggle client:idle labels={themeLabels} />
      </div>

      <a
        class="icon-btn github-link"
        href="https://github.com/codewiki-com"
        aria-label="GitHub"
        title="GitHub"
      >
        <Icon name="github" size={20} />
      </a>

      <details class="nav-menu">
        <summary class="icon-btn" aria-label={t(locale, 'nav.menu')}>
          <Icon name="menu" size={20} />
        </summary>
        <div class="menu-panel">
          <nav class="menu-links" aria-label={t(locale, 'nav.primary')}>
            {
              links.map((link) => (
                <a
                  href={link.href}
                  class:list={[link.accent && 'ai', link.current && 'on']}
                  aria-current={link.current ? 'page' : undefined}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
          <div class="menu-tools">
            <LangSwitch id="menu-language" locale={locale} currentPath={currentPath} />
            <ThemeToggle client:idle labels={themeLabels} />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.nav-menu').forEach((menu) => {
    const trigger = menu.querySelector<HTMLElement>('summary')!;
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      event.preventDefault();
      menu.open = false;
      trigger.focus();
    });
    menu.addEventListener('focusout', (event) => {
      if (event.relatedTarget && !menu.contains(event.relatedTarget as Node)) menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  });
</script>

<style>
  .nav-outer {
    position: relative;
    z-index: 40;
    border-bottom: 1px solid var(--line);
    background: var(--sur);
  }

  /* `--w` and `--gutter` are set by the layout: 1200px for standard pages,
     1320px for topics. The gutter sits outside the column so the content keeps
     its width on wide screens and still clears the edge on narrow ones. */
  .bar {
    max-width: calc(var(--w) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .nav {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 32px;
    min-width: 0;
  }

  /* Every header control gets a 40px-tall hit area; negative margins keep the visible
     layout where it was, so only the clickable box grows. */
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    padding: 0 6px;
    margin-left: -6px;
    color: var(--ink);
  }

  .wordmark {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0 -10px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 10px;
    border-radius: var(--r-6);
  }

  .links a:hover {
    background: var(--bg);
  }

  .links a,
  .menu-links a {
    color: var(--ink2);
    font-size: 14px;
    font-weight: 500;
    transition: color var(--t-state) var(--ease);
  }

  .links a.ai,
  .menu-links a.ai {
    color: var(--acc2);
  }

  .links a.on,
  .menu-links a.on {
    color: var(--ink);
  }

  .links a:hover,
  .menu-links a:hover {
    color: var(--acc);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 6px;
    /* At 1024px the two groups meet with no slack, so the controls must not be
       squeezed: the links clip instead if a fallback font renders wider. */
    flex: none;
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 36px;
    width: 240px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-6);
    background: var(--bg);
    color: var(--ink3);
    font-size: 13.5px;
    text-align: left;
    transition:
      border-color var(--t-state) var(--ease),
      color var(--t-state) var(--ease);
  }

  .search:hover {
    border-color: var(--ink3);
    color: var(--ink2);
  }

  .search-label {
    flex: 1;
  }

  .icon-btn {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--r-6);
    background: transparent;
    color: var(--ink2);
  }

  .icon-btn:hover {
    color: var(--ink);
  }

  .github-link {
    width: 40px;
    height: 40px;
  }

  .github-link:hover,
  .nav-tools :global(.theme-toggle:hover) {
    background: var(--bg);
  }

  /* The toggle is a Preact island, so its class is not scoped to this file. */
  .nav-tools :global(.theme-toggle) {
    width: 40px;
    height: 40px;
    padding: 0;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--ink2);
  }

  .nav-tools :global(.theme-toggle svg) {
    width: 18px;
    height: 18px;
  }

  .nav-tools :global(.theme-toggle:hover) {
    color: var(--ink);
  }

  /* ---- mobile menu ---- */

  .nav-menu {
    display: none;
  }

  .nav-menu > summary {
    list-style: none;
    cursor: pointer;
  }

  .nav-menu > summary::-webkit-details-marker {
    display: none;
  }

  .menu-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 40;
    display: flex;
    flex-direction: column;
    background: var(--sur);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--glow);
    padding: 4px 16px 16px;
  }

  .menu-links {
    display: flex;
    flex-direction: column;
  }

  .menu-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    border-bottom: 1px solid var(--line);
  }

  .menu-tools {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
  }

  .menu-tools :global(.theme-toggle) {
    width: 44px;
    height: 44px;
    padding: 0;
    justify-content: center;
    color: var(--ink2);
  }

  .menu-tools :global(.theme-toggle svg) {
    width: 20px;
    height: 20px;
  }

  .search-compact {
    display: none;
  }

  @media (max-width: 1199px) {
    .nav {
      height: 52px;
    }

    .nav-right {
      gap: 6px;
    }

    .links,
    .search,
    .nav-tools {
      display: none;
    }

    .nav-menu {
      display: block;
    }

    .search-compact {
      display: inline-flex;
    }

    .github-link {
      width: 44px;
      height: 44px;
    }

    .logo {
      width: 20px;
      height: 20px;
    }

    .wordmark {
      font-size: 17px;
    }

    .brand {
      gap: 8px;
    }
  }
</style>
