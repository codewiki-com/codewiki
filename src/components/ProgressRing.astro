---
/**
 * The 56px progress ring on the track hub's right rail. Server-rendered at zero, because progress
 * is read from local storage: `TrackProgress` sets `stroke-dashoffset` on the `data-ring` circle.
 */
interface Props {
  /** Topics read out of `total`. Pages pass 0 and let the island fill it in. */
  value?: number;
  total: number;
  size?: number;
  /** Accessible name; the ring is exposed as a progressbar. */
  label: string;
}

const { value = 0, total, size = 56, label } = Astro.props;

/* Geometry is in viewBox units: the 56-unit box scales into whatever `size` asks for. */
const CENTER = 28;
const RADIUS = 23;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const pct = total > 0 ? Math.max(0, Math.min(1, value / total)) : 0;
const offset = CIRCUMFERENCE * (1 - pct);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 56 56"
  role="progressbar"
  aria-label={label}
  aria-valuenow={value}
  aria-valuemin={0}
  aria-valuemax={total}
>
  <circle cx={CENTER} cy={CENTER} r={RADIUS} fill="none" stroke="var(--acc-soft)" stroke-width="6"></circle>
  <circle
    cx={CENTER}
    cy={CENTER}
    r={RADIUS}
    fill="none"
    stroke="var(--acc)"
    stroke-width="6"
    stroke-dasharray={CIRCUMFERENCE.toFixed(1)}
    stroke-dashoffset={offset.toFixed(1)}
    stroke-linecap="round"
    transform={`rotate(-90 ${CENTER} ${CENTER})`}
    data-ring
    data-circumference={CIRCUMFERENCE.toFixed(1)}></circle>
</svg>

<style>
  svg {
    flex: none;
  }
</style>
