---
/**
 * The segmented control from the mockups: one item is `on`, the rest are either
 * inert labels or links. Interactive segments that change client state are wired
 * up by the island that owns them; this component only renders the shape.
 */
export interface SegItem {
  label: string;
  /** Machine-readable value, exposed as `data-value` for islands to read. */
  value: string;
  on?: boolean;
  href?: string;
  /** BCP-47 tag of the item's own text, when it differs from the page. */
  lang?: string;
  /** BCP-47 tag of the language `href` leads to. Links only. */
  hreflang?: string;
}

interface Props {
  items: SegItem[];
  /** Accessible name; rendered as `aria-label` on the group. */
  label?: string;
  class?: string;
  /** Anything else lands on the group element, e.g. the `data-` hooks a script reads. */
  [key: string]: unknown;
}

const { items, label, class: className, ...rest } = Astro.props;
---

<span class:list={['seg', className]} role="group" aria-label={label} {...rest}>
  {
    items.map((item) =>
      item.href && !item.on ? (
        <a href={item.href} data-value={item.value} lang={item.lang} hreflang={item.hreflang}>
          {item.label}
        </a>
      ) : (
        <span
          class:list={[item.on && 'on']}
          data-value={item.value}
          lang={item.lang}
          aria-current={item.on ? 'true' : undefined}
        >
          {item.label}
        </span>
      ),
    )
  }
</span>

<style>
  /* `.seg span` is styled globally; anchors need the same box. */
  .seg a {
    font-size: 12.5px;
    padding: 4px 10px;
    border-radius: var(--r-4);
    color: var(--ink3);
    transition: color var(--t-state) var(--ease);
  }

  .seg a:hover {
    color: var(--ink);
  }
</style>
