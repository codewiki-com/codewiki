---
/**
 * A glossary term in running prose. The dotted underline is the affordance; the
 * hover/focus card that reads `data-term` arrives with the glossary island (P2),
 * so the span is focusable from the start.
 */
interface Props {
  /** Glossary entry id, e.g. `free-variable`. */
  id: string;
}

const { id } = Astro.props;
---

<span class="term" data-term={id} tabindex="0"><slot /></span>
