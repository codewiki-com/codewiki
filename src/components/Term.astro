---
/**
 * A glossary term in running prose. The dotted underline is the affordance; the term itself is a
 * real localized link, while the glossary island adds a descriptive hover/focus tooltip.
 */
import { localizePath, localeFromPath } from '@/lib/urls';

interface Props {
  /** Glossary entry id, e.g. `free-variable`. */
  id: string;
}

const { id } = Astro.props;
const href = localizePath(`/glossary/${id}/`, localeFromPath(Astro.url.pathname));
---

<a class="term" data-term={id} href={href}><slot /></a>
