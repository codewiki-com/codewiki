---
/**
 * A glossary term in running prose. Published entries are localized links and receive the
 * glossary island's hover/focus tooltip; proposed entries remain labelled text until published.
 */
import { getEntry } from 'astro:content';

import { localizePath, localeFromPath } from '@/lib/urls';

interface Props {
  /** Glossary entry id, e.g. `free-variable`. */
  id: string;
}

const { id } = Astro.props;
const entry = await getEntry('glossary', id);
const href = entry ? localizePath(`/glossary/${id}/`, localeFromPath(Astro.url.pathname)) : undefined;
---

{
  href ? (
    <a class="term" data-term={id} href={href}>
      <slot />
    </a>
  ) : (
    <span class="term" data-term={id}>
      <slot />
    </span>
  )
}
