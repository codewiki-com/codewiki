---
/** Concrete edge-case handoffs for the runnable example immediately above this component. */
import { t } from '@/i18n';
import { encodeState } from '@/lib/lz';
import { normalizeLang } from '@/lib/runners';
import { localeFromPath, localizePath } from '@/lib/urls';

interface Props {
  /** Two to four short mutations or inputs the reader can try in the playground. */
  items: string[];
  /** Added by `rehype-section-actions`; authors never repeat the example source. */
  'data-code'?: string;
  /** Added with the source so the playground selects the challenged example's runtime. */
  'data-lang'?: string;
}

const { items, 'data-code': code = '', 'data-lang': rawLang = '' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const lang = normalizeLang(rawLang);

const challenges = items.map((item) => {
  const comment = `# try: ${item}`;
  return {
    item,
    href: lang
      ? `${localizePath('/playground/', locale)}?${new URLSearchParams({
          code: encodeState({ lang, code: code + '\n' + comment }),
        })}`
      : '',
  };
});
---

{
  code && lang && challenges.length > 0 && (
    <aside class="nudge">
      <p class="nudge-title" data-i18n="nudge.title">
        {t(locale, 'nudge.title')}
      </p>
      <ul>
        {challenges.map(({ item, href }) => (
          <li>
            <span>{item}</span>
            <a href={href}>
              <span data-i18n="nudge.try">{t(locale, 'nudge.try')}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
