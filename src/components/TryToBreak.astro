---
/** Concrete edge-case handoffs for the runnable example immediately above this component. */
import LZString from 'lz-string';

interface Props {
  /** Two to four short mutations or inputs the reader can try in the playground. */
  items: string[];
  /** Added by `rehype-section-actions`; authors never repeat the example source. */
  'data-code'?: string;
}

const { items, 'data-code': code = '' } = Astro.props;

const challenges = items.map((item) => {
  const challenged = `${code.trimEnd()}\n\n# try: ${item}\n`;
  return {
    item,
    href: `/playground/?lang=&code=${LZString.compressToEncodedURIComponent(challenged)}`,
  };
});
---

{
  code && challenges.length > 0 && (
    <aside class="nudge">
      <p class="nudge-title" data-i18n="nudge.title">
        Try to break it
      </p>
      <ul>
        {challenges.map(({ item, href }) => (
          <li>
            <span>{item}</span>
            <a href={href}>
              <span data-i18n="nudge.try">Try it</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
