---
/**
 * The left rail of a topic page: the track's sections in registry order with the topics written
 * in this locale, the current one highlighted — the `.tree` block of
 * docs/design/mockups/Topic.dc.html.
 *
 * Read state is a fact about the visitor's browser, so every link is rendered unread and the
 * `ReadTracker` island marks the finished ones by `data-topic-id`, the same contract
 * `TopicCard.astro` has with `TrackProgress`.
 */
import type { Track } from '@/data/tracks';
import { listTopics, topicMeta } from '@/lib/content';
import { topicUrl, trackUrl, type Locale } from '@/lib/urls';

interface Props {
  locale: Locale;
  track: Track;
  /** `${track}/${slug}` of the topic being read. */
  currentId: string;
}

const { locale, track, currentId } = Astro.props;

const sections = await Promise.all(
  track.sections.map(async (section) => ({
    name: section.name[locale],
    topics: (await listTopics(locale, { track: track.slug, section: section.slug })).map((topic) => {
      const { track: trackSlug, slug } = topicMeta(topic);
      return {
        id: `${trackSlug}/${slug}`,
        title: topic.data.title,
        href: topicUrl(trackSlug, slug, locale),
      };
    }),
  })),
);

/** Sections with nothing written in this locale would render as an empty heading. */
const written = sections.filter((section) => section.topics.length > 0);
const total = written.reduce((count, section) => count + section.topics.length, 0);
---

<nav class="tree" aria-label={track.name[locale]}>
  <div class="tree-head">
    <span class="tag acc">{track.glyph}</span>
    <a class="tree-track" href={trackUrl(track.slug, locale)}>{track.name[locale]}</a>
    <span class="lbl" data-tree-count>0/{total}</span>
  </div>
  {
    written.map((section) => (
      <>
        <div class="grp">{section.name}</div>
        {section.topics.map((topic) => (
          <a
            href={topic.href}
            class:list={[topic.id === currentId && 'on']}
            data-topic-id={topic.id}
            aria-current={topic.id === currentId ? 'page' : undefined}
          >
            <span class="sp" />
            {topic.title}
          </a>
        ))}
      </>
    ))
  }
</nav>

<style>
  .tree {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tree-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 8px 12px;
    border-bottom: 1px solid var(--line);
  }

  .tree-track {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }

  .tree-track:hover {
    color: var(--acc);
  }

  .tree-head .lbl {
    margin-left: auto;
  }

  /* The check the ReadTracker island swaps in for the spacer on a finished topic. */
  .tree a :global(svg) {
    flex: none;
    color: var(--ok);
  }
</style>
