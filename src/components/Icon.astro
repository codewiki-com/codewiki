---
/**
 * The site's icon set, inlined as SVG so no request and no icon font is needed.
 * Geometry is copied from docs/design/mockups/*.dc.html; every glyph is drawn on
 * a 24x24 grid with a 2px stroke so they stay optically consistent at any size.
 * `tests/unit/icons.test.ts` asserts one `case` per name.
 */

export type IconName =
  | 'search'
  | 'moon'
  | 'sun'
  | 'monitor'
  | 'check'
  | 'play'
  | 'copy'
  | 'chevron-down'
  | 'arrow-right'
  | 'warning'
  | 'info'
  | 'menu'
  | 'close'
  | 'external';

interface Props {
  name: IconName;
  /** Rendered box in px; the 24-unit viewBox scales into it. */
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

/** Inner geometry for one icon. Returned as markup so the wrapper stays shared. */
function shape(icon: IconName): string {
  switch (icon) {
    case 'search':
      return '<circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />';
    case 'moon':
      return '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />';
    case 'sun':
      return '<circle cx="12" cy="12" r="4.4" /><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7" />';
    case 'monitor':
      return '<rect x="3" y="4" width="18" height="13" rx="2" /><path d="M9 21h6" />';
    case 'check':
      return '<path d="m5 13 4 4L19 7" />';
    case 'play':
      return '<path d="M7 4v16l13-8z" />';
    case 'copy':
      return '<rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />';
    case 'chevron-down':
      return '<path d="m6 9 6 6 6-6" />';
    case 'arrow-right':
      return '<path d="M4 12h15M13 6l6 6-6 6" />';
    case 'warning':
      return '<path d="M10.3 3.9 2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4M12 17h.01" />';
    case 'info':
      return '<circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" />';
    case 'menu':
      return '<path d="M4 7h16M4 12h16M4 17h16" />';
    case 'close':
      return '<path d="M6 6l12 12M18 6 6 18" />';
    case 'external':
      return '<path d="M14 4h6v6M20 4l-9 9" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />';
  }
}
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={shape(name)}
/>
