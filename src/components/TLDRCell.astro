---
/** One cell of the TL;DR grid: a mono label above a sentence. */
interface Props {
  /** Short label shown above the text, e.g. `what`, `trap`, `fix`. */
  label: string;
}

const { label } = Astro.props;
---

<div class="tldr-cell">
  <span class="lbl">{label}</span>
  <div class="tldr-text"><slot /></div>
</div>
