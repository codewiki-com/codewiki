---
/** English interview banks, one static route per collection entry. */
import { getCollection, type CollectionEntry } from 'astro:content';
import Interview from '@/pages-shared/Interview.astro';

export async function getStaticPaths() {
  const banks: CollectionEntry<'interview'>[] = await getCollection('interview');
  return banks.map((bank) => ({ params: { track: bank.data.track }, props: { bank } }));
}

interface Props {
  bank: CollectionEntry<'interview'>;
}

const { bank } = Astro.props;
---

<Interview locale="en" bank={bank} />
