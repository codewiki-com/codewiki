---
/** English standalone practice pages, one per catalogue item. */
import Kata from '@/pages-shared/Kata.astro';
import { listPracticeItems, type PracticeItem } from '@/lib/practice';

export async function getStaticPaths() {
  const items = await listPracticeItems();
  return items.map((catalogueItem) => ({
    params: {
      type: catalogueItem.type,
      track: catalogueItem.track,
      slug: catalogueItem.slug,
      item: catalogueItem.item,
    },
    props: { catalogueItem },
  }));
}

const { catalogueItem } = Astro.props as { catalogueItem: PracticeItem };
---

<Kata locale="en" catalogueItem={catalogueItem} />
