---
/** Chinese track hubs, one page per entry in the track registry. */
import TrackHub from '@/pages-shared/TrackHub.astro';
import { TRACKS, type Track } from '@/data/tracks';

export function getStaticPaths() {
  return TRACKS.map((track) => ({ params: { track: track.slug }, props: { track } }));
}

const { track } = Astro.props as { track: Track };
---

<TrackHub locale="zh" track={track} />
