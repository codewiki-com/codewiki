---
/** Chinese per-track practice catalogue, one static route per track that has exercises. */
import PracticeTrack from '@/pages-shared/PracticeTrack.astro';
import { practiceTrackPaths } from '@/lib/practice-routes';
import type { Track } from '@/data/tracks';

export const getStaticPaths = practiceTrackPaths;

interface Props {
  track: Track;
}

const { track } = Astro.props;
---

<PracticeTrack locale="zh" track={track} />
