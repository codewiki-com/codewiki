---
/** Chinese path pages, one static route per path entry. */
import { getCollection, type CollectionEntry } from 'astro:content';
import Path from '@/pages-shared/Path.astro';

export async function getStaticPaths() {
  const paths: CollectionEntry<'paths'>[] = await getCollection('paths');
  return paths.map((path) => ({ params: { slug: path.id }, props: { path } }));
}

const { path } = Astro.props as { path: CollectionEntry<'paths'> };
---

<Path locale="zh" path={path} />
