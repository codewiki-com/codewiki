---
/** English install pages for generated rules packs. */
import Rules from '@/pages-shared/Rules.astro';
import { getTrack, type Track } from '@/data/tracks';
import { generatedRulePacks } from '@/lib/generated-packs';

interface Props {
  track: Track;
  ruleCount: number;
}

export async function getStaticPaths() {
  const packs = await generatedRulePacks();
  return [...packs].flatMap(([slug, rules]) => {
    const track = getTrack(slug);
    return track ? [{ params: { track: slug }, props: { track, ruleCount: rules.length } }] : [];
  });
}

const { track, ruleCount } = Astro.props as Props;
---

<Rules locale="en" track={track} ruleCount={ruleCount} />
