---
/**
 * Not-found page. It is served for any unmatched URL in either language, so the
 * copy is English with a Chinese line underneath and a way back into both trees.
 * The page is rendered once, at /404.html, and is kept out of the index.
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import { buildHead } from '@/lib/seo';
import { t } from '@/i18n';

const head = buildHead({
  locale: 'en',
  path: '/404/',
  title: t('en', 'notFound.title'),
  description: t('en', 'notFound.body'),
  kind: 'page',
  noindex: true,
});
---

<Base locale="en" head={head} currentPath="/404/">
  <div class="page">
    <span class="lbl">404</span>
    <h1>{t('en', 'notFound.title')}</h1>
    <p>{t('en', 'notFound.body')}</p>
    <p class="zh" lang="zh-Hans">{t('zh', 'notFound.body')}</p>
    <div class="actions">
      <Button href="/">{t('en', 'notFound.home')}</Button>
      <Button href="/zh/" variant="ghost" lang="zh-Hans">{t('zh', 'notFound.home')}</Button>
    </div>
  </div>
</Base>

<style>
  .page {
    max-width: calc(var(--w) + 48px);
    margin: 0 auto;
    padding: 96px 24px 96px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  h1 {
    font-size: 38px;
    line-height: 1.1;
  }

  p {
    margin: 0;
    max-width: 540px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink2);
  }

  p.zh {
    font-size: 15px;
    line-height: 1.9;
    color: var(--ink3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  @media (max-width: 767px) {
    .page {
      padding: 56px 16px 64px;
    }

    h1 {
      font-size: 30px;
    }
  }
</style>
