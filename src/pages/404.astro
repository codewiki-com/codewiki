---
/**
 * Not-found page. It is served for any unmatched URL in either language, so the
 * copy is English with a Chinese line underneath and a way back into both trees.
 * The page is rendered once, at /404.html, and is kept out of the index.
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/data/site';
import { buildHead } from '@/lib/seo';
import { t } from '@/i18n';

const head = buildHead({
  locale: 'en',
  path: '/404/',
  title: t('en', 'notFound.title'),
  description: t('en', 'notFound.body'),
  kind: 'page',
  noindex: true,
});

/**
 * The page is built once, at `/404.html`, and served for every unmatched URL — so `/404/` is not
 * a URL that exists, and neither is a translated twin of it. The canonical names the file that is
 * really there and the hreflang tags go; `noindex, nofollow` is what keeps the page out of the
 * index either way. Without this the head advertises two links that 404.
 */
head.canonical = `${SITE.url}/404.html`;
head.og['og:url'] = head.canonical;
head.alternates = [];
---

<!-- `currentPath` is the home page, not `/404/`: it is what the nav's language switch and the
  footer's "other language" link resolve against, and both have to land somewhere real. -->
<Base locale="en" head={head} currentPath="/">
  <div class="page">
    <span class="lbl">404</span>
    <h1>{t('en', 'notFound.title')}</h1>
    <p>{t('en', 'notFound.body')}</p>
    <p class="zh" lang="zh-Hans">{t('zh', 'notFound.body')}</p>
    <div class="actions">
      <Button href="/">{t('en', 'notFound.home')}</Button>
      <Button href="/zh/" variant="ghost" lang="zh-Hans">{t('zh', 'notFound.home')}</Button>
    </div>
  </div>
</Base>

<style>
  .page {
    max-width: calc(var(--w) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 96px var(--gutter) 96px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  h1 {
    font-size: 38px;
    line-height: 1.1;
  }

  p {
    margin: 0;
    max-width: 540px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink2);
  }

  p.zh {
    font-size: 15px;
    line-height: 1.9;
    color: var(--ink3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  @media (max-width: 767px) {
    .page {
      padding: 56px var(--gutter) 64px;
    }

    h1 {
      font-size: 30px;
    }
  }
</style>
