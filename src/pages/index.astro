---
/**
 * Temporary home page. It exists so the shell, the head model and the theme
 * bootstrap are exercised end to end; Task 9 replaces the body with the real
 * hero, feature grid and track list from docs/design/mockups/Main.dc.html.
 */
import Base from '@/layouts/Base.astro';
import { buildHead } from '@/lib/seo';
import { t } from '@/i18n';
import type { Locale } from '@/lib/urls';

const locale: Locale = 'en';

const head = buildHead({
  locale,
  path: '/',
  title: t(locale, 'home.h1'),
  description: t(locale, 'home.sub'),
  kind: 'home',
});
---

<Base locale={locale} head={head} currentPath={Astro.url.pathname}>
  <div class="page">
    <h1>{t(locale, 'home.h1')}</h1>
    <p>{t(locale, 'home.sub')}</p>
  </div>
</Base>

<style>
  .page {
    max-width: calc(var(--w) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 76px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  h1 {
    font-size: 62px;
    line-height: 1.04;
  }

  p {
    margin: 0;
    max-width: 540px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink2);
  }

  @media (max-width: 767px) {
    .page {
      padding: 32px var(--gutter) 40px;
      gap: 16px;
    }

    h1 {
      font-size: 38px;
      line-height: 1.08;
    }

    p {
      font-size: 15.5px;
    }
  }
</style>
