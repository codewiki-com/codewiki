---
import ThemeScript from '@/components/ThemeScript.astro';
import ThemeToggle from '@/islands/ThemeToggle';
import '@/styles/global.css';

// Placeholder page — Task 8 replaces this with the real layout and moves
// ThemeScript/ThemeToggle into it. It exists so `pnpm dev` and `pnpm build`
// exercise the token layer end to end.
const labels = { system: 'Theme: system', light: 'Theme: light', dark: 'Theme: dark' };
const sample =
  '<span class="k">def</span> <span class="f">ping</span>(): <span class="k">return</span> <span class="s">"pong"</span>';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>codewiki</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" style={`max-width: var(--w-home); margin: 0 auto; padding: 48px 24px;`}>
      <header style="display: flex; align-items: center; justify-content: space-between; gap: 16px;">
        <h1 style="font-size: 30px;">codewiki</h1>
        <ThemeToggle client:idle labels={labels} />
      </header>
      <p class="lbl" style="margin-top: 8px;">DESIGN TOKENS · THEME SWITCHING</p>
      <div class="panel" style="margin-top: 24px; padding: 20px;">
        <div class="prose">
          <h2>Studio Precision / Night Lab</h2>
          <p>
            The toggle cycles system → light → dark. The palette is applied before first paint by an inline
            script, so a reload never flashes the wrong theme.
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 16px;">
          <span class="tag">tag</span>
          <span class="tag acc">accent</span>
          <span class="tag ok">ok</span>
          <span class="kbd">⌘K</span>
          <span class="seg"><span class="on">EN</span><span>中文</span></span>
        </div>
      </div>
      <div class="codebox" style="margin-top: 16px;">
        <div class="codehead">
          <span class="lbl">python</span>
          <span class="run">Run</span>
        </div>
        <div class="code" style="padding: 14px 18px;" set:html={sample} />
        <div class="out">pong</div>
      </div>
    </main>
  </body>
</html>
