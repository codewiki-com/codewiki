---
/** English topic pages, one per published English topic. */
import Topic from '@/pages-shared/Topic.astro';
import { listTopics, topicMeta, type Topic as TopicEntry } from '@/lib/content';

export async function getStaticPaths() {
  const topics = await listTopics('en');
  return topics.map((topic) => {
    const { track, slug } = topicMeta(topic);
    return { params: { track, slug }, props: { topic } };
  });
}

const { topic } = Astro.props as { topic: TopicEntry };
---

<Topic locale="en" topic={topic} />
