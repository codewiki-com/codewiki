---
/** English glossary term pages, one per entry in the collection. */
import { getCollection, type CollectionEntry } from 'astro:content';
import GlossaryTerm from '@/pages-shared/GlossaryTerm.astro';

export async function getStaticPaths() {
  const terms: CollectionEntry<'glossary'>[] = await getCollection('glossary');
  return terms.map((term) => ({ params: { term: term.id }, props: { term } }));
}

const { term } = Astro.props as { term: CollectionEntry<'glossary'> };
---

<GlossaryTerm locale="en" term={term} />
